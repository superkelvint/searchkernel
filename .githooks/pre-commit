#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
PYTHON=$(bash "$ROOT/tools/resolve-python.sh")
export PYTHON

precommit_in_container=${SEARCHKERNEL_PRECOMMIT_IN_CONTAINER:-0}

if [[ "$precommit_in_container" == "1" ]]; then
    CARGO=$(bash "$ROOT/tools/resolve-rust.sh" cargo)
    export CARGO

    native_required=${SEARCHKERNEL_PRECOMMIT_NATIVE_REQUIRED:-false}
    python_required=${SEARCHKERNEL_PRECOMMIT_PYTHON_REQUIRED:-false}
    typescript_required=${SEARCHKERNEL_PRECOMMIT_TYPESCRIPT_REQUIRED:-false}
    php_required=${SEARCHKERNEL_PRECOMMIT_PHP_REQUIRED:-false}
    ruby_required=${SEARCHKERNEL_PRECOMMIT_RUBY_REQUIRED:-false}
    protocol_required=${SEARCHKERNEL_PRECOMMIT_PROTOCOL_REQUIRED:-false}
    api_conformance_required=${SEARCHKERNEL_PRECOMMIT_API_CONFORMANCE_REQUIRED:-false}
    contracts_required=${SEARCHKERNEL_PRECOMMIT_CONTRACTS_REQUIRED:-false}
    abi_required=${SEARCHKERNEL_PRECOMMIT_ABI_REQUIRED:-false}
    persistence_required=${SEARCHKERNEL_PRECOMMIT_PERSISTENCE_REQUIRED:-false}
    issue_queue_required=${SEARCHKERNEL_PRECOMMIT_ISSUE_QUEUE_REQUIRED:-false}
    python_native_e2e_required="$native_required"
else
    if ! git diff --cached --quiet -- docs/capabilities.json; then
        # Do not generate from a worktree version that differs from the staged
        # source; otherwise the committed ledger and its generated views could
        # describe different capability sets.
        if ! git diff --quiet -- docs/capabilities.json; then
            echo "pre-commit: stage all docs/capabilities.json changes before committing" >&2
            exit 1
        fi

        "$PYTHON" tools/check-capabilities.py --write
        git add docs/CAPABILITIES.md LIMITATIONS.md
    fi

    # Local commits do not derive verification scope from repository policy.
    # Run every product lane so removing policy-based selection cannot hide an
    # affected behavior.
    native_required=true
    python_required=true
    typescript_required=true
    php_required=true
    ruby_required=true
    protocol_required=true
    api_conformance_required=true
    contracts_required=true
    abi_required=true
    persistence_required=true
    issue_queue_required=true

    # Lane selection is based on the staged tree while the container receives
    # the working tree. Require them to agree for every tracked path.
    if ! git diff --quiet; then
        echo "pre-commit: tracked unstaged changes exist" >&2
        echo "pre-commit: stage or revert them so verification matches the commit" >&2
        exit 1
    fi

    # Untracked source can affect the container build even when it is not part
    # of the commit. Permit only disposable editor/runtime files.
    while IFS= read -r path; do
        case "$path" in
            *.tmp|*.log|*.swp|.DS_Store|*/.DS_Store) ;;
            *)
                echo "pre-commit: untracked files exist: $path" >&2
                echo "pre-commit: add, remove, or ignore them before committing" >&2
                exit 1
                ;;
        esac
    done < <(git ls-files --others --exclude-standard)

    python_native_e2e_required="$native_required"

    abi_authority_required=false
    if [[ -n "$(git diff --cached --name-only --no-renames -- \
        core/native/vespa/searchkernel_vespa.h \
        core/native/vespa/manifest.json \
        core/crates/searchkernel-vespa-bindings/src/abi.rs \
        core/crates/searchkernel-vespa-bindings/src/bindings.rs \
        reference/vespa/NATIVE_ABI_CONTRACT.h \
        reference/vespa/PINNED_VESPA.json \
        reference/vespa/m0/expected/01-native-open-close.json \
        reference/vespa/m0/scenarios/01-native-open-close.json \
        reference/vespa/phase9/expected/01-additive-handles.json)" ]]; then
        abi_authority_required=true
    fi

    if [[ "$abi_authority_required" == true ]]; then
        echo "pre-commit: checking staged native ABI authority agreement"
        "$PYTHON" tools/check-native-abi-authorities.py --git-index
    fi

    # Repository hook regression fixtures intentionally execute the verifier
    # body in-process with fake tools. Real developer commits always hand the
    # complete verification body to one disposable searchkernel-ci container.
    if [[ "${SEARCHKERNEL_PRECOMMIT_SELFTEST:-0}" != "1" &&
          -f "$ROOT/Cargo.toml" ]]; then
        [[ -f "$ROOT/tools/run-in-ci-image.sh" ]] || {
            echo "pre-commit: canonical CI-image launcher is missing: tools/run-in-ci-image.sh" >&2
            exit 1
        }
        echo "pre-commit: running build/test verification in searchkernel-ci"
        SEARCHKERNEL_PRECOMMIT_NATIVE_REQUIRED="$native_required" \
        SEARCHKERNEL_PRECOMMIT_PYTHON_REQUIRED="$python_required" \
        SEARCHKERNEL_PRECOMMIT_TYPESCRIPT_REQUIRED="$typescript_required" \
        SEARCHKERNEL_PRECOMMIT_PHP_REQUIRED="$php_required" \
        SEARCHKERNEL_PRECOMMIT_RUBY_REQUIRED="$ruby_required" \
        SEARCHKERNEL_PRECOMMIT_PROTOCOL_REQUIRED="$protocol_required" \
        SEARCHKERNEL_PRECOMMIT_API_CONFORMANCE_REQUIRED="$api_conformance_required" \
        SEARCHKERNEL_PRECOMMIT_CONTRACTS_REQUIRED="$contracts_required" \
        SEARCHKERNEL_PRECOMMIT_ABI_REQUIRED="$abi_required" \
        SEARCHKERNEL_PRECOMMIT_PERSISTENCE_REQUIRED="$persistence_required" \
        SEARCHKERNEL_PRECOMMIT_ISSUE_QUEUE_REQUIRED="$issue_queue_required" \
            "$ROOT/dev" precommit-verify
        exit $?
    fi

    CARGO=$(bash "$ROOT/tools/resolve-rust.sh" cargo)
    export CARGO
fi

echo "pre-commit: checking shell syntax"
bash "$ROOT/tools/check-shell-syntax.sh"

echo "pre-commit: enforcing canonical toolchain authorities"
"$PYTHON" tools/test_toolchain_authorities.py

echo "pre-commit: checking rustfmt"
"$CARGO" fmt --all --check

echo "pre-commit: running clippy"
./dev lint --profile rust-clippy-non-native

echo "pre-commit: running workspace unit tests"
"$CARGO" test --workspace --all-targets --no-default-features

if [[ "$protocol_required" == true ]]; then
    echo "pre-commit: protocol/generated-artifact changes detected; checking generated contracts"
    ./dev check-protocol
fi

if [[ "$api_conformance_required" == true ]]; then
    echo "pre-commit: API conformance changes detected; running conformance verifier"
    ./dev verify api-conformance
fi

if [[ "$contracts_required" == true ]]; then
    echo "pre-commit: capability/client-contract changes detected; running contract verifiers"
    ./dev verify contracts
fi

if [[ "$abi_required" == true ]]; then
    echo "pre-commit: ABI-sensitive changes detected; running ABI verifier"
    ./dev verify abi
fi

if [[ "$persistence_required" == true ]]; then
    echo "pre-commit: persistence-sensitive changes detected; running persistence verifier"
    ./dev verify persistence
fi

if [[ "$issue_queue_required" == true ]]; then
    echo "pre-commit: issue-queue tooling changed; running issue-queue verifier tests"
    ./dev verify issue-queue
fi

if [[ "$python_required" == true ]]; then
    echo "pre-commit: Python-sensitive changes detected; running Python client tests"
    ./dev test python
fi

if [[ "$typescript_required" == true ]]; then
    echo "pre-commit: TypeScript-sensitive changes detected; running TypeScript client tests"
    ./dev test typescript
fi

if [[ "$php_required" == true ]]; then
    echo "pre-commit: PHP-sensitive changes detected; running PHP client tests"
    ./dev test php
fi

if [[ "$ruby_required" == true ]]; then
    echo "pre-commit: Ruby-sensitive changes detected; running Ruby client tests"
    ./dev test ruby
fi

if [[ "$native_required" == true ]]; then
    echo "pre-commit: native-sensitive changes detected; running local real-Vespa verification"
    ./reference/vespa/verify-through.sh i
fi

if [[ "$python_native_e2e_required" == true ]]; then
    echo "pre-commit: native-sensitive changes detected; running Python native gRPC E2E"
    bash tools/run-python-native-e2e.sh
fi
