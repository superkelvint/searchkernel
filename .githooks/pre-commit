#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! git diff --cached --quiet -- docs/capabilities.json; then
    # Do not generate from a worktree version that differs from the staged source;
    # otherwise the committed ledger and its generated views could describe
    # different capability sets.
    if ! git diff --quiet -- docs/capabilities.json; then
        echo "pre-commit: stage all docs/capabilities.json changes before committing" >&2
        exit 1
    fi

    python3 tools/check-capabilities.py --write
    git add docs/CAPABILITIES.md LIMITATIONS.md
fi

native_selection=$(mktemp "${TMPDIR:-/tmp}/searchkernel-precommit-native.XXXXXX")
trap 'rm -f -- "$native_selection"' EXIT
git diff --cached --name-only --no-renames -z \
    | python3 .github/ci/exact_head.py classify --github-output "$native_selection" >/dev/null

lane_required() {
    local lane=$1
    grep -qx "$lane=true" "$native_selection"
}

native_required=false
python_required=false
typescript_required=false
protocol_required=false
api_conformance_required=false
verification_required=false

lane_required native && native_required=true
lane_required python && python_required=true
lane_required typescript && typescript_required=true
lane_required protocol && protocol_required=true
lane_required api_conformance && api_conformance_required=true
lane_required verification && verification_required=true

# Every verifier below runs against the working tree, while lane selection is
# based on the staged tree. Refuse tracked unstaged changes for every commit so
# an unstaged fix cannot make a broken staged snapshot look green.
if ! git diff --quiet; then
    echo "pre-commit: tracked unstaged changes exist" >&2
    echo "pre-commit: stage or revert them so verification matches the commit" >&2
    exit 1
fi

# The real Python gRPC E2E is part of native-sensitive verification. Keep it
# on the same classifier boundary as the real-Vespa gate so non-native-only
# Rust/Python changes do not unexpectedly require a Vespa SDK.
python_native_e2e_required="$native_required"

echo "pre-commit: checking rustfmt"
cargo fmt --all --check

echo "pre-commit: running clippy"
cargo clippy --workspace --all-targets --no-default-features -- -D warnings

echo "pre-commit: running workspace unit tests"
cargo test --workspace --all-targets --no-default-features

if [[ "$verification_required" == true && "${SEARCHKERNEL_PRECOMMIT_SELFTEST:-0}" != "1" ]]; then
    echo "pre-commit: verification tooling changed; running selector/hook regressions"
    SEARCHKERNEL_PRECOMMIT_SELFTEST=1 python3 .github/ci/test_exact_head.py
fi

if [[ "$protocol_required" == true ]]; then
    echo "pre-commit: protocol/generated-artifact changes detected; checking generated contracts"
    ./dev check-protocol
fi

if [[ "$api_conformance_required" == true ]]; then
    echo "pre-commit: API conformance changes detected; running conformance verifier"
    ./dev verify api-conformance
fi

if [[ "$python_required" == true ]]; then
    echo "pre-commit: Python-sensitive changes detected; running Python client tests"
    ./dev test python
fi

if [[ "$typescript_required" == true ]]; then
    echo "pre-commit: TypeScript-sensitive changes detected; running TypeScript client tests"
    ./dev test typescript
fi

if [[ "$native_required" == true ]]; then
    echo "pre-commit: native-sensitive changes detected; running local real-Vespa verification"
    ./reference/vespa/verify-through.sh i
fi

if [[ "$python_native_e2e_required" == true ]]; then
    echo "pre-commit: native-sensitive changes detected; running Python native gRPC E2E"
    bash tools/run-python-native-e2e.sh
fi
