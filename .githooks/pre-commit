#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! git diff --cached --quiet -- docs/capabilities.json; then
    # Do not generate from a worktree version that differs from the staged source;
    # otherwise the committed ledger and its generated views could describe
    # different capability sets.
    if ! git diff --quiet -- docs/capabilities.json; then
        echo "pre-commit: stage all docs/capabilities.json changes before committing" >&2
        exit 1
    fi

    python3 tools/check-capabilities.py --write
    git add docs/CAPABILITIES.md LIMITATIONS.md
fi

echo "pre-commit: checking rustfmt"
cargo fmt --all --check

echo "pre-commit: running clippy"
cargo clippy --workspace --all-targets --no-default-features -- -D warnings

echo "pre-commit: running workspace unit tests"
cargo test --workspace --all-targets --no-default-features

native_selection=$(mktemp "${TMPDIR:-/tmp}/searchkernel-precommit-native.XXXXXX")
trap 'rm -f -- "$native_selection"' EXIT
git diff --cached --name-only -z \
    | python3 .github/ci/exact_head.py classify --github-output "$native_selection" >/dev/null

if grep -qx 'native=true' "$native_selection"; then
    if ! git diff --quiet; then
        echo "pre-commit: native-sensitive changes are staged, but tracked unstaged changes also exist" >&2
        echo "pre-commit: stage or revert those tracked changes so native verification matches the commit" >&2
        exit 1
    fi

    echo "pre-commit: native-sensitive changes detected; running local real-Vespa verification"
    ./reference/vespa/verify-through.sh i
fi
