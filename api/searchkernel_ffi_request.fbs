include "searchkernel.fbs";

namespace SearchKernel.FFI.V1;

union RequestPayload {
  SearchKernel.V1.InsertRequest,
  SearchKernel.V1.UpsertRequest,
  SearchKernel.V1.PatchRequest,
  SearchKernel.V1.DeleteRequest,
  SearchKernel.V1.GetRequest,
  SearchKernel.V1.SearchRequest,
  SearchKernel.V1.AnalyzeRequest,
  SearchKernel.V1.DescribeRequest,
  SearchKernel.V1.InspectQueryRequest
}

table RequestEnvelope {
  protocol_version:uint = 1;
  payload:RequestPayload;
}

root_type RequestEnvelope;
file_identifier "SKRQ";
