include "searchkernel.fbs";

namespace SearchKernel.FFI.V1;

union RequestPayload {
  SearchKernel.V2.InsertRequest,
  SearchKernel.V2.UpsertRequest,
  SearchKernel.V2.PatchRequest,
  SearchKernel.V2.DeleteRequest,
  SearchKernel.V2.GetRequest,
  SearchKernel.V2.SearchRequest,
  SearchKernel.V2.AnalyzeRequest,
  SearchKernel.V2.DescribeRequest,
  SearchKernel.V2.InspectQueryRequest
}

table RequestEnvelope {
  protocol_version:uint = 1;
  payload:RequestPayload;
}

root_type RequestEnvelope;
file_identifier "SKRQ";
