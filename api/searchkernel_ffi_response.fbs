include "searchkernel.fbs";

namespace SearchKernel.FFI.V1;

union ResponsePayload {
  SearchKernel.V1.InsertResult,
  SearchKernel.V1.UpsertResult,
  SearchKernel.V1.PatchResult,
  SearchKernel.V1.DeleteResult,
  SearchKernel.V1.GetResult,
  SearchKernel.V1.SearchResult,
  SearchKernel.V1.AnalyzeResult,
  SearchKernel.V1.Error
}

table ResponseEnvelope {
  protocol_version:uint = 1;
  payload:ResponsePayload;
}

root_type ResponseEnvelope;
file_identifier "SKRS";
