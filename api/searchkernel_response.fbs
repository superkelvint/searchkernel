include "searchkernel.fbs";

namespace SearchKernel.Protocol.V2;

union ResponsePayload {
  // Append-only: existing V2 union discriminator numbers are wire ABI.
  SearchKernel.V2.InsertResult,
  SearchKernel.V2.UpsertResult,
  SearchKernel.V2.PatchResult,
  SearchKernel.V2.DeleteResult,
  SearchKernel.V2.GetResult,
  SearchKernel.V2.SearchResult,
  SearchKernel.V2.AnalyzeResult,
  SearchKernel.V2.Error,
  SearchKernel.V2.DescribeResult,
  SearchKernel.V2.InspectQueryResult,
  SearchKernel.V2.UpdateResult,
  SearchKernel.V2.CreateIndexResult,
  SearchKernel.V2.OpenIndexResult,
  SearchKernel.V2.DeleteIndexResult
}

table ResponseEnvelope {
  // Zero is deliberately invalid; V2 senders must write version 2 explicitly.
  protocol_version:uint = 0;
  payload:ResponsePayload;
}

root_type ResponseEnvelope;
file_identifier "SKRS";
