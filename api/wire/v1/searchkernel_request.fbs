include "searchkernel.fbs";

namespace SearchKernel.Protocol;

// #848 establishes this request union as the forward-compatibility baseline.
// Future variants append here; existing discriminator values must not be
// reordered or reused.
union RequestPayload {
  SearchKernel.Wire.InsertRequest,
  SearchKernel.Wire.UpsertRequest,
  SearchKernel.Wire.PatchRequest,
  SearchKernel.Wire.DeleteRequest,
  SearchKernel.Wire.GetRequest,
  SearchKernel.Wire.SearchRequest,
  SearchKernel.Wire.AnalyzeRequest,
  SearchKernel.Wire.DescribeRequest,
  SearchKernel.Wire.InspectQueryRequest,
  SearchKernel.Wire.UpdateRequest,
  SearchKernel.Wire.CreateIndexRequest,
  SearchKernel.Wire.OpenIndexRequest,
  SearchKernel.Wire.DeleteIndexRequest
}

table RequestEnvelope {
  // Zero is deliberately invalid. This field is part of the #848 baseline and
  // must retain its slot in future compatible evolution.
  protocol_version:uint = 0;
  payload:RequestPayload;

  // Logical daemon routing identity. Multi-index daemon ingress requires this
  // field for every index operation. Embedded/per-index callers may omit it
  // because their target is already bound by the local handle.
  //
  // #848 establishes this field at the current slot as the forward-compatibility
  // baseline; future fields append rather than shifting existing slots.
  target:SearchKernel.Wire.IndexTarget;

  // A handle created or opened for this target carries the returned
  // generation on every later target-scoped operation. The daemon rejects a
  // request if the target now names a different incarnation. Omission keeps
  // the raw protocol's explicit name-based operation semantics.
  expected_generation:string;
}

root_type RequestEnvelope;
file_identifier "SKRQ";
