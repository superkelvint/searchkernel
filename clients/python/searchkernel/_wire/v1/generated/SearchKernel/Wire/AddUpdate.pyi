from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AddUpdate(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AddUpdate: ...
  @classmethod
  def GetRootAsAddUpdate(cls, buf: bytes, offset: int) -> AddUpdate: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class AddUpdateT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AddUpdateT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AddUpdateT: ...
  @classmethod
  def InitFromObj(cls, addUpdate: AddUpdate) -> AddUpdateT: ...
  def _UnPack(self, addUpdate: AddUpdate) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AddUpdateStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AddUpdateAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def AddUpdateEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
