from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AnalyzeFieldTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AnalyzeFieldTarget: ...
  @classmethod
  def GetRootAsAnalyzeFieldTarget(cls, buf: bytes, offset: int) -> AnalyzeFieldTarget: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
class AnalyzeFieldTargetT(object):
  field: str | None
  def __init__(
    self,
    field: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AnalyzeFieldTargetT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AnalyzeFieldTargetT: ...
  @classmethod
  def InitFromObj(cls, analyzeFieldTarget: AnalyzeFieldTarget) -> AnalyzeFieldTargetT: ...
  def _UnPack(self, analyzeFieldTarget: AnalyzeFieldTarget) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AnalyzeFieldTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AnalyzeFieldTargetAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def AnalyzeFieldTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
