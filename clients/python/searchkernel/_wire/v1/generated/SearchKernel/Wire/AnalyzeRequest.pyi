from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.AnalyzeFieldTarget import AnalyzeFieldTargetT
from SearchKernel.Wire.AnalyzeTarget import AnalyzeTarget
from SearchKernel.Wire.Analyzer import AnalyzerT
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AnalyzeRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AnalyzeRequest: ...
  @classmethod
  def GetRootAsAnalyzeRequest(cls, buf: bytes, offset: int) -> AnalyzeRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def TargetType(self) -> typing.Literal[AnalyzeTarget.NONE, AnalyzeTarget.Analyzer, AnalyzeTarget.AnalyzeFieldTarget]: ...
  def Target(self) -> table.Table | None: ...
  def Text(self) -> str | None: ...
  def Language(self) -> str | None: ...
class AnalyzeRequestT(object):
  targetType: typing.Literal[AnalyzeTarget.NONE, AnalyzeTarget.Analyzer, AnalyzeTarget.AnalyzeFieldTarget]
  target: typing.Union[None, AnalyzerT, AnalyzeFieldTargetT]
  text: str | None
  language: str | None
  def __init__(
    self,
    targetType: typing.Literal[AnalyzeTarget.NONE, AnalyzeTarget.Analyzer, AnalyzeTarget.AnalyzeFieldTarget] = ...,
    target: typing.Union[None, AnalyzerT, AnalyzeFieldTargetT] = ...,
    text: str | None = ...,
    language: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AnalyzeRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AnalyzeRequestT: ...
  @classmethod
  def InitFromObj(cls, analyzeRequest: AnalyzeRequest) -> AnalyzeRequestT: ...
  def _UnPack(self, analyzeRequest: AnalyzeRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AnalyzeRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AnalyzeRequestAddTargetType(builder: flatbuffers.Builder, targetType: typing.Literal[AnalyzeTarget.NONE, AnalyzeTarget.Analyzer, AnalyzeTarget.AnalyzeFieldTarget]) -> None: ...
def AnalyzeRequestAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def AnalyzeRequestAddText(builder: flatbuffers.Builder, text: uoffset) -> None: ...
def AnalyzeRequestAddLanguage(builder: flatbuffers.Builder, language: uoffset) -> None: ...
def AnalyzeRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
