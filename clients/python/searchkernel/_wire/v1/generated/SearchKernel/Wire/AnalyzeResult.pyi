from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.AnalyzedToken import AnalyzedToken, AnalyzedTokenT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AnalyzeResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AnalyzeResult: ...
  @classmethod
  def GetRootAsAnalyzeResult(cls, buf: bytes, offset: int) -> AnalyzeResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Tokens(self, i: int) -> AnalyzedToken | None: ...
  def TokensLength(self) -> int: ...
  def TokensIsNone(self) -> bool: ...
class AnalyzeResultT(object):
  tokens: typing.List[AnalyzedTokenT]
  def __init__(
    self,
    tokens: typing.List['AnalyzedTokenT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AnalyzeResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AnalyzeResultT: ...
  @classmethod
  def InitFromObj(cls, analyzeResult: AnalyzeResult) -> AnalyzeResultT: ...
  def _UnPack(self, analyzeResult: AnalyzeResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AnalyzeResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AnalyzeResultAddTokens(builder: flatbuffers.Builder, tokens: uoffset) -> None: ...
def AnalyzeResultStartTokensVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartTokensVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def AnalyzeResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
