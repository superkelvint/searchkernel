from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AnalyzedToken(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AnalyzedToken: ...
  @classmethod
  def GetRootAsAnalyzedToken(cls, buf: bytes, offset: int) -> AnalyzedToken: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Surface(self) -> str | None: ...
  def Term(self) -> str | None: ...
  def Position(self) -> int: ...
  def StartByte(self) -> int: ...
  def EndByte(self) -> int: ...
class AnalyzedTokenT(object):
  surface: str | None
  term: str | None
  position: int
  startByte: int
  endByte: int
  def __init__(
    self,
    surface: str | None = ...,
    term: str | None = ...,
    position: int = ...,
    startByte: int = ...,
    endByte: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AnalyzedTokenT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AnalyzedTokenT: ...
  @classmethod
  def InitFromObj(cls, analyzedToken: AnalyzedToken) -> AnalyzedTokenT: ...
  def _UnPack(self, analyzedToken: AnalyzedToken) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AnalyzedTokenStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AnalyzedTokenAddSurface(builder: flatbuffers.Builder, surface: uoffset) -> None: ...
def AnalyzedTokenAddTerm(builder: flatbuffers.Builder, term: uoffset) -> None: ...
def AnalyzedTokenAddPosition(builder: flatbuffers.Builder, position: int) -> None: ...
def AnalyzedTokenAddStartByte(builder: flatbuffers.Builder, startByte: int) -> None: ...
def AnalyzedTokenAddEndByte(builder: flatbuffers.Builder, endByte: int) -> None: ...
def AnalyzedTokenEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
