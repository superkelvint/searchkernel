from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Analyzer(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Analyzer: ...
  @classmethod
  def GetRootAsAnalyzer(cls, buf: bytes, offset: int) -> Analyzer: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def Version(self) -> int: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
class AnalyzerT(object):
  name: str | None
  version: int
  options: typing.List[ValueEntryT]
  def __init__(
    self,
    name: str | None = ...,
    version: int = ...,
    options: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AnalyzerT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AnalyzerT: ...
  @classmethod
  def InitFromObj(cls, analyzer: Analyzer) -> AnalyzerT: ...
  def _UnPack(self, analyzer: Analyzer) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AnalyzerStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AnalyzerAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def AnalyzerAddVersion(builder: flatbuffers.Builder, version: int) -> None: ...
def AnalyzerAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def AnalyzerStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def AnalyzerEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
