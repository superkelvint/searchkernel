from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ArithmeticUpdateOperator import ArithmeticUpdateOperator
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ArithmeticUpdate(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ArithmeticUpdate: ...
  @classmethod
  def GetRootAsArithmeticUpdate(cls, buf: bytes, offset: int) -> ArithmeticUpdate: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Operator(self) -> typing.Literal[ArithmeticUpdateOperator.Unspecified, ArithmeticUpdateOperator.Increment, ArithmeticUpdateOperator.Decrement, ArithmeticUpdateOperator.Multiply, ArithmeticUpdateOperator.Divide]: ...
  def Operand(self) -> Value | None: ...
class ArithmeticUpdateT(object):
  operator: typing.Literal[ArithmeticUpdateOperator.Unspecified, ArithmeticUpdateOperator.Increment, ArithmeticUpdateOperator.Decrement, ArithmeticUpdateOperator.Multiply, ArithmeticUpdateOperator.Divide]
  operand: ValueT | None
  def __init__(
    self,
    operator: typing.Literal[ArithmeticUpdateOperator.Unspecified, ArithmeticUpdateOperator.Increment, ArithmeticUpdateOperator.Decrement, ArithmeticUpdateOperator.Multiply, ArithmeticUpdateOperator.Divide] = ...,
    operand: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ArithmeticUpdateT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ArithmeticUpdateT: ...
  @classmethod
  def InitFromObj(cls, arithmeticUpdate: ArithmeticUpdate) -> ArithmeticUpdateT: ...
  def _UnPack(self, arithmeticUpdate: ArithmeticUpdate) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ArithmeticUpdateStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ArithmeticUpdateAddOperator(builder: flatbuffers.Builder, operator: typing.Literal[ArithmeticUpdateOperator.Unspecified, ArithmeticUpdateOperator.Increment, ArithmeticUpdateOperator.Decrement, ArithmeticUpdateOperator.Multiply, ArithmeticUpdateOperator.Divide]) -> None: ...
def ArithmeticUpdateAddOperand(builder: flatbuffers.Builder, operand: uoffset) -> None: ...
def ArithmeticUpdateEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
