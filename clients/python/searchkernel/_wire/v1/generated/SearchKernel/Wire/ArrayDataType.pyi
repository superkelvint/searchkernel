from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.DataType import DataType, DataTypeT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ArrayDataType(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ArrayDataType: ...
  @classmethod
  def GetRootAsArrayDataType(cls, buf: bytes, offset: int) -> ArrayDataType: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ElementType(self) -> DataType | None: ...
class ArrayDataTypeT(object):
  elementType: DataTypeT | None
  def __init__(
    self,
    elementType: 'DataTypeT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ArrayDataTypeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ArrayDataTypeT: ...
  @classmethod
  def InitFromObj(cls, arrayDataType: ArrayDataType) -> ArrayDataTypeT: ...
  def _UnPack(self, arrayDataType: ArrayDataType) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ArrayDataTypeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ArrayDataTypeAddElementType(builder: flatbuffers.Builder, elementType: uoffset) -> None: ...
def ArrayDataTypeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
