from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AssignUpdate(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AssignUpdate: ...
  @classmethod
  def GetRootAsAssignUpdate(cls, buf: bytes, offset: int) -> AssignUpdate: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class AssignUpdateT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AssignUpdateT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AssignUpdateT: ...
  @classmethod
  def InitFromObj(cls, assignUpdate: AssignUpdate) -> AssignUpdateT: ...
  def _UnPack(self, assignUpdate: AssignUpdate) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AssignUpdateStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AssignUpdateAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def AssignUpdateEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
