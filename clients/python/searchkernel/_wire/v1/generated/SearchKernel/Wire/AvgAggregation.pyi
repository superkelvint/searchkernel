from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AvgAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AvgAggregation: ...
  @classmethod
  def GetRootAsAvgAggregation(cls, buf: bytes, offset: int) -> AvgAggregation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
class AvgAggregationT(object):
  expression: GroupingExpressionT | None
  def __init__(
    self,
    expression: 'GroupingExpressionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AvgAggregationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AvgAggregationT: ...
  @classmethod
  def InitFromObj(cls, avgAggregation: AvgAggregation) -> AvgAggregationT: ...
  def _UnPack(self, avgAggregation: AvgAggregation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AvgAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AvgAggregationAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def AvgAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
