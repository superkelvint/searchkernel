from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class BoolValue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> BoolValue: ...
  @classmethod
  def GetRootAsBoolValue(cls, buf: bytes, offset: int) -> BoolValue: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> bool: ...
class BoolValueT(object):
  value: bool
  def __init__(
    self,
    value: bool = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> BoolValueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> BoolValueT: ...
  @classmethod
  def InitFromObj(cls, boolValue: BoolValue) -> BoolValueT: ...
  def _UnPack(self, boolValue: BoolValue) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def BoolValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def BoolValueAddValue(builder: flatbuffers.Builder, value: bool) -> None: ...
def BoolValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
