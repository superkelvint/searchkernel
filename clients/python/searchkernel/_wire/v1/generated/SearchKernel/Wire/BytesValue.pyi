from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class BytesValue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> BytesValue: ...
  @classmethod
  def GetRootAsBytesValue(cls, buf: bytes, offset: int) -> BytesValue: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self, i: int) -> typing.List[int]: ...
  def ValueAsNumpy(self) -> np.ndarray: ...
  def ValueLength(self) -> int: ...
  def ValueIsNone(self) -> bool: ...
class BytesValueT(object):
  value: typing.List[int]
  def __init__(
    self,
    value: typing.List[int] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> BytesValueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> BytesValueT: ...
  @classmethod
  def InitFromObj(cls, bytesValue: BytesValue) -> BytesValueT: ...
  def _UnPack(self, bytesValue: BytesValue) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def BytesValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def BytesValueAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def BytesValueStartValueVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartValueVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def BytesValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
