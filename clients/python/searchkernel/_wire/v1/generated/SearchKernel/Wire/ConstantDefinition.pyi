from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ConstantSourceKind import ConstantSourceKind
from SearchKernel.Wire.DataType import DataType, DataTypeT
from SearchKernel.Wire.FileConstantSource import FileConstantSourceT
from SearchKernel.Wire.LiteralConstantSource import LiteralConstantSourceT
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ConstantDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ConstantDefinition: ...
  @classmethod
  def GetRootAsConstantDefinition(cls, buf: bytes, offset: int) -> ConstantDefinition: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def DataType(self) -> DataType | None: ...
  def SourceType(self) -> typing.Literal[ConstantSourceKind.NONE, ConstantSourceKind.LiteralConstantSource, ConstantSourceKind.FileConstantSource]: ...
  def Source(self) -> table.Table | None: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
class ConstantDefinitionT(object):
  name: str | None
  dataType: DataTypeT | None
  sourceType: typing.Literal[ConstantSourceKind.NONE, ConstantSourceKind.LiteralConstantSource, ConstantSourceKind.FileConstantSource]
  source: typing.Union[None, LiteralConstantSourceT, FileConstantSourceT]
  properties: typing.List[ValueEntryT]
  def __init__(
    self,
    name: str | None = ...,
    dataType: 'DataTypeT' | None = ...,
    sourceType: typing.Literal[ConstantSourceKind.NONE, ConstantSourceKind.LiteralConstantSource, ConstantSourceKind.FileConstantSource] = ...,
    source: typing.Union[None, LiteralConstantSourceT, FileConstantSourceT] = ...,
    properties: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ConstantDefinitionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ConstantDefinitionT: ...
  @classmethod
  def InitFromObj(cls, constantDefinition: ConstantDefinition) -> ConstantDefinitionT: ...
  def _UnPack(self, constantDefinition: ConstantDefinition) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ConstantDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ConstantDefinitionAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def ConstantDefinitionAddDataType(builder: flatbuffers.Builder, dataType: uoffset) -> None: ...
def ConstantDefinitionAddSourceType(builder: flatbuffers.Builder, sourceType: typing.Literal[ConstantSourceKind.NONE, ConstantSourceKind.LiteralConstantSource, ConstantSourceKind.FileConstantSource]) -> None: ...
def ConstantDefinitionAddSource(builder: flatbuffers.Builder, source: uoffset) -> None: ...
def ConstantDefinitionAddProperties(builder: flatbuffers.Builder, properties: uoffset) -> None: ...
def ConstantDefinitionStartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ConstantDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
