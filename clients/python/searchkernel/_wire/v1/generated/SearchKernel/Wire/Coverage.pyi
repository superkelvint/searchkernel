from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.CoverageDegraded import CoverageDegraded, CoverageDegradedT
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT
from SearchKernel.Wire.OptionalDouble import OptionalDouble, OptionalDoubleT
from SearchKernel.Wire.OptionalUInt32 import OptionalUInt32, OptionalUInt32T
from SearchKernel.Wire.OptionalUInt64 import OptionalUInt64, OptionalUInt64T
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Coverage(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Coverage: ...
  @classmethod
  def GetRootAsCoverage(cls, buf: bytes, offset: int) -> Coverage: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def CoveragePercent(self) -> OptionalDouble | None: ...
  def Documents(self) -> OptionalUInt64 | None: ...
  def Full(self) -> OptionalBool | None: ...
  def Nodes(self) -> OptionalUInt32 | None: ...
  def Results(self) -> OptionalUInt64 | None: ...
  def ResultsFull(self) -> OptionalUInt64 | None: ...
  def Degraded(self) -> CoverageDegraded | None: ...
  def Metadata(self, i: int) -> ValueEntry | None: ...
  def MetadataLength(self) -> int: ...
  def MetadataIsNone(self) -> bool: ...
class CoverageT(object):
  coveragePercent: OptionalDoubleT | None
  documents: OptionalUInt64T | None
  full: OptionalBoolT | None
  nodes: OptionalUInt32T | None
  results: OptionalUInt64T | None
  resultsFull: OptionalUInt64T | None
  degraded: CoverageDegradedT | None
  metadata: typing.List[ValueEntryT]
  def __init__(
    self,
    coveragePercent: 'OptionalDoubleT' | None = ...,
    documents: 'OptionalUInt64T' | None = ...,
    full: 'OptionalBoolT' | None = ...,
    nodes: 'OptionalUInt32T' | None = ...,
    results: 'OptionalUInt64T' | None = ...,
    resultsFull: 'OptionalUInt64T' | None = ...,
    degraded: 'CoverageDegradedT' | None = ...,
    metadata: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> CoverageT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> CoverageT: ...
  @classmethod
  def InitFromObj(cls, coverage: Coverage) -> CoverageT: ...
  def _UnPack(self, coverage: Coverage) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def CoverageStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def CoverageAddCoveragePercent(builder: flatbuffers.Builder, coveragePercent: uoffset) -> None: ...
def CoverageAddDocuments(builder: flatbuffers.Builder, documents: uoffset) -> None: ...
def CoverageAddFull(builder: flatbuffers.Builder, full: uoffset) -> None: ...
def CoverageAddNodes(builder: flatbuffers.Builder, nodes: uoffset) -> None: ...
def CoverageAddResults(builder: flatbuffers.Builder, results: uoffset) -> None: ...
def CoverageAddResultsFull(builder: flatbuffers.Builder, resultsFull: uoffset) -> None: ...
def CoverageAddDegraded(builder: flatbuffers.Builder, degraded: uoffset) -> None: ...
def CoverageAddMetadata(builder: flatbuffers.Builder, metadata: uoffset) -> None: ...
def CoverageStartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def CoverageEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
