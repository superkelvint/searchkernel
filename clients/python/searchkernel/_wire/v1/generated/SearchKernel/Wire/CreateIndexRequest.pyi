from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.IndexDefinition import IndexDefinition, IndexDefinitionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class CreateIndexRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> CreateIndexRequest: ...
  @classmethod
  def GetRootAsCreateIndexRequest(cls, buf: bytes, offset: int) -> CreateIndexRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Definition(self) -> IndexDefinition | None: ...
class CreateIndexRequestT(object):
  definition: IndexDefinitionT | None
  def __init__(
    self,
    definition: 'IndexDefinitionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> CreateIndexRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> CreateIndexRequestT: ...
  @classmethod
  def InitFromObj(cls, createIndexRequest: CreateIndexRequest) -> CreateIndexRequestT: ...
  def _UnPack(self, createIndexRequest: CreateIndexRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def CreateIndexRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def CreateIndexRequestAddDefinition(builder: flatbuffers.Builder, definition: uoffset) -> None: ...
def CreateIndexRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
