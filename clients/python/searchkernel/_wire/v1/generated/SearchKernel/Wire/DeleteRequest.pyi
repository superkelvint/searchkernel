from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DeleteRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DeleteRequest: ...
  @classmethod
  def GetRootAsDeleteRequest(cls, buf: bytes, offset: int) -> DeleteRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def Condition(self) -> str | None: ...
class DeleteRequestT(object):
  id: str | None
  condition: str | None
  def __init__(
    self,
    id: str | None = ...,
    condition: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DeleteRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DeleteRequestT: ...
  @classmethod
  def InitFromObj(cls, deleteRequest: DeleteRequest) -> DeleteRequestT: ...
  def _UnPack(self, deleteRequest: DeleteRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DeleteRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DeleteRequestAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def DeleteRequestAddCondition(builder: flatbuffers.Builder, condition: uoffset) -> None: ...
def DeleteRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
