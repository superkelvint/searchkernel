from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.IndexDefinition import IndexDefinition, IndexDefinitionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DescribeResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DescribeResult: ...
  @classmethod
  def GetRootAsDescribeResult(cls, buf: bytes, offset: int) -> DescribeResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Index(self) -> IndexDefinition | None: ...
class DescribeResultT(object):
  index: IndexDefinitionT | None
  def __init__(
    self,
    index: 'IndexDefinitionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DescribeResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DescribeResultT: ...
  @classmethod
  def InitFromObj(cls, describeResult: DescribeResult) -> DescribeResultT: ...
  def _UnPack(self, describeResult: DescribeResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DescribeResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DescribeResultAddIndex(builder: flatbuffers.Builder, index: uoffset) -> None: ...
def DescribeResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
