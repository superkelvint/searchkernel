from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.DiagnosticExecutionKind import DiagnosticExecutionKind
from SearchKernel.Wire.IndexTarget import IndexTarget, IndexTargetT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DiagnosticExecution(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DiagnosticExecution: ...
  @classmethod
  def GetRootAsDiagnosticExecution(cls, buf: bytes, offset: int) -> DiagnosticExecution: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def RequestHash(self) -> str | None: ...
  def Target(self) -> IndexTarget | None: ...
  def Kind(self) -> typing.Literal[DiagnosticExecutionKind.Original, DiagnosticExecutionKind.DiagnosticRerun, DiagnosticExecutionKind.Experiment, DiagnosticExecutionKind.Counterfactual]: ...
  def Complete(self) -> bool: ...
class DiagnosticExecutionT(object):
  id: str | None
  requestHash: str | None
  target: IndexTargetT | None
  kind: typing.Literal[DiagnosticExecutionKind.Original, DiagnosticExecutionKind.DiagnosticRerun, DiagnosticExecutionKind.Experiment, DiagnosticExecutionKind.Counterfactual]
  complete: bool
  def __init__(
    self,
    id: str | None = ...,
    requestHash: str | None = ...,
    target: 'IndexTargetT' | None = ...,
    kind: typing.Literal[DiagnosticExecutionKind.Original, DiagnosticExecutionKind.DiagnosticRerun, DiagnosticExecutionKind.Experiment, DiagnosticExecutionKind.Counterfactual] = ...,
    complete: bool = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DiagnosticExecutionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DiagnosticExecutionT: ...
  @classmethod
  def InitFromObj(cls, diagnosticExecution: DiagnosticExecution) -> DiagnosticExecutionT: ...
  def _UnPack(self, diagnosticExecution: DiagnosticExecution) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DiagnosticExecutionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DiagnosticExecutionAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def DiagnosticExecutionAddRequestHash(builder: flatbuffers.Builder, requestHash: uoffset) -> None: ...
def DiagnosticExecutionAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def DiagnosticExecutionAddKind(builder: flatbuffers.Builder, kind: typing.Literal[DiagnosticExecutionKind.Original, DiagnosticExecutionKind.DiagnosticRerun, DiagnosticExecutionKind.Experiment, DiagnosticExecutionKind.Counterfactual]) -> None: ...
def DiagnosticExecutionAddComplete(builder: flatbuffers.Builder, complete: bool) -> None: ...
def DiagnosticExecutionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
