from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DiagnosticFinding(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DiagnosticFinding: ...
  @classmethod
  def GetRootAsDiagnosticFinding(cls, buf: bytes, offset: int) -> DiagnosticFinding: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Code(self) -> str | None: ...
  def Message(self) -> str | None: ...
  def EvidenceIds(self, i: int) -> str: ...
  def EvidenceIdsLength(self) -> int: ...
  def EvidenceIdsIsNone(self) -> bool: ...
class DiagnosticFindingT(object):
  code: str | None
  message: str | None
  evidenceIds: typing.List[str]
  def __init__(
    self,
    code: str | None = ...,
    message: str | None = ...,
    evidenceIds: typing.List[str] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DiagnosticFindingT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DiagnosticFindingT: ...
  @classmethod
  def InitFromObj(cls, diagnosticFinding: DiagnosticFinding) -> DiagnosticFindingT: ...
  def _UnPack(self, diagnosticFinding: DiagnosticFinding) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DiagnosticFindingStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DiagnosticFindingAddCode(builder: flatbuffers.Builder, code: uoffset) -> None: ...
def DiagnosticFindingAddMessage(builder: flatbuffers.Builder, message: uoffset) -> None: ...
def DiagnosticFindingAddEvidenceIds(builder: flatbuffers.Builder, evidenceIds: uoffset) -> None: ...
def DiagnosticFindingStartEvidenceIdsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartEvidenceIdsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def DiagnosticFindingEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
