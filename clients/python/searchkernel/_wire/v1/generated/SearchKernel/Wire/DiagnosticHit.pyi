from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.DiagnosticSignal import DiagnosticSignal, DiagnosticSignalT
from SearchKernel.Wire.Relevance import Relevance, RelevanceT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DiagnosticHit(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DiagnosticHit: ...
  @classmethod
  def GetRootAsDiagnosticHit(cls, buf: bytes, offset: int) -> DiagnosticHit: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def ExecutionId(self) -> str | None: ...
  def ReturnedPosition(self) -> int: ...
  def Relevance(self) -> Relevance | None: ...
  def Signals(self, i: int) -> DiagnosticSignal | None: ...
  def SignalsLength(self) -> int: ...
  def SignalsIsNone(self) -> bool: ...
  def EvidenceIds(self, i: int) -> str: ...
  def EvidenceIdsLength(self) -> int: ...
  def EvidenceIdsIsNone(self) -> bool: ...
class DiagnosticHitT(object):
  id: str | None
  executionId: str | None
  returnedPosition: int
  relevance: RelevanceT | None
  signals: typing.List[DiagnosticSignalT]
  evidenceIds: typing.List[str]
  def __init__(
    self,
    id: str | None = ...,
    executionId: str | None = ...,
    returnedPosition: int = ...,
    relevance: 'RelevanceT' | None = ...,
    signals: typing.List['DiagnosticSignalT'] | None = ...,
    evidenceIds: typing.List[str] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DiagnosticHitT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DiagnosticHitT: ...
  @classmethod
  def InitFromObj(cls, diagnosticHit: DiagnosticHit) -> DiagnosticHitT: ...
  def _UnPack(self, diagnosticHit: DiagnosticHit) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DiagnosticHitStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DiagnosticHitAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def DiagnosticHitAddExecutionId(builder: flatbuffers.Builder, executionId: uoffset) -> None: ...
def DiagnosticHitAddReturnedPosition(builder: flatbuffers.Builder, returnedPosition: int) -> None: ...
def DiagnosticHitAddRelevance(builder: flatbuffers.Builder, relevance: uoffset) -> None: ...
def DiagnosticHitAddSignals(builder: flatbuffers.Builder, signals: uoffset) -> None: ...
def DiagnosticHitStartSignalsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartSignalsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def DiagnosticHitAddEvidenceIds(builder: flatbuffers.Builder, evidenceIds: uoffset) -> None: ...
def DiagnosticHitStartEvidenceIdsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartEvidenceIdsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def DiagnosticHitEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
