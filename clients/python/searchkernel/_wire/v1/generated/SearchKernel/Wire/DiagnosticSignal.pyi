from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalUInt32 import OptionalUInt32, OptionalUInt32T
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DiagnosticSignal(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DiagnosticSignal: ...
  @classmethod
  def GetRootAsDiagnosticSignal(cls, buf: bytes, offset: int) -> DiagnosticSignal: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def Value(self) -> Value | None: ...
  def Position(self) -> OptionalUInt32 | None: ...
  def Ties(self) -> OptionalUInt32 | None: ...
  def ComparisonCount(self) -> int: ...
  def ComparisonSet(self) -> str | None: ...
class DiagnosticSignalT(object):
  name: str | None
  value: ValueT | None
  position: OptionalUInt32T | None
  ties: OptionalUInt32T | None
  comparisonCount: int
  comparisonSet: str | None
  def __init__(
    self,
    name: str | None = ...,
    value: 'ValueT' | None = ...,
    position: 'OptionalUInt32T' | None = ...,
    ties: 'OptionalUInt32T' | None = ...,
    comparisonCount: int = ...,
    comparisonSet: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DiagnosticSignalT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DiagnosticSignalT: ...
  @classmethod
  def InitFromObj(cls, diagnosticSignal: DiagnosticSignal) -> DiagnosticSignalT: ...
  def _UnPack(self, diagnosticSignal: DiagnosticSignal) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DiagnosticSignalStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DiagnosticSignalAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def DiagnosticSignalAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def DiagnosticSignalAddPosition(builder: flatbuffers.Builder, position: uoffset) -> None: ...
def DiagnosticSignalAddTies(builder: flatbuffers.Builder, ties: uoffset) -> None: ...
def DiagnosticSignalAddComparisonCount(builder: flatbuffers.Builder, comparisonCount: int) -> None: ...
def DiagnosticSignalAddComparisonSet(builder: flatbuffers.Builder, comparisonSet: uoffset) -> None: ...
def DiagnosticSignalEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
