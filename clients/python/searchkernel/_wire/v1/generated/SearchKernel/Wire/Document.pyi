from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Document(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Document: ...
  @classmethod
  def GetRootAsDocument(cls, buf: bytes, offset: int) -> Document: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def Fields(self, i: int) -> ValueEntry | None: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
class DocumentT(object):
  id: str | None
  fields: typing.List[ValueEntryT]
  def __init__(
    self,
    id: str | None = ...,
    fields: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DocumentT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DocumentT: ...
  @classmethod
  def InitFromObj(cls, document: Document) -> DocumentT: ...
  def _UnPack(self, document: Document) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DocumentStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DocumentAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def DocumentAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def DocumentStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def DocumentEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
