from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ErrorCode import ErrorCode
from SearchKernel.Wire.ErrorDetail import ErrorDetail, ErrorDetailT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Error(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Error: ...
  @classmethod
  def GetRootAsError(cls, buf: bytes, offset: int) -> Error: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Code(self) -> typing.Literal[ErrorCode.Unspecified, ErrorCode.InvalidArgument, ErrorCode.NotFound, ErrorCode.AlreadyExists, ErrorCode.FailedPrecondition, ErrorCode.Conflict, ErrorCode.Unsupported, ErrorCode.ResourceExhausted, ErrorCode.Internal, ErrorCode.Unavailable, ErrorCode.DeadlineExceeded]: ...
  def Message(self) -> str | None: ...
  def Details(self, i: int) -> ErrorDetail | None: ...
  def DetailsLength(self) -> int: ...
  def DetailsIsNone(self) -> bool: ...
  def Retryable(self) -> bool: ...
class ErrorT(object):
  code: typing.Literal[ErrorCode.Unspecified, ErrorCode.InvalidArgument, ErrorCode.NotFound, ErrorCode.AlreadyExists, ErrorCode.FailedPrecondition, ErrorCode.Conflict, ErrorCode.Unsupported, ErrorCode.ResourceExhausted, ErrorCode.Internal, ErrorCode.Unavailable, ErrorCode.DeadlineExceeded]
  message: str | None
  details: typing.List[ErrorDetailT]
  retryable: bool
  def __init__(
    self,
    code: typing.Literal[ErrorCode.Unspecified, ErrorCode.InvalidArgument, ErrorCode.NotFound, ErrorCode.AlreadyExists, ErrorCode.FailedPrecondition, ErrorCode.Conflict, ErrorCode.Unsupported, ErrorCode.ResourceExhausted, ErrorCode.Internal, ErrorCode.Unavailable, ErrorCode.DeadlineExceeded] = ...,
    message: str | None = ...,
    details: typing.List['ErrorDetailT'] | None = ...,
    retryable: bool = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ErrorT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ErrorT: ...
  @classmethod
  def InitFromObj(cls, error: Error) -> ErrorT: ...
  def _UnPack(self, error: Error) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ErrorStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ErrorAddCode(builder: flatbuffers.Builder, code: typing.Literal[ErrorCode.Unspecified, ErrorCode.InvalidArgument, ErrorCode.NotFound, ErrorCode.AlreadyExists, ErrorCode.FailedPrecondition, ErrorCode.Conflict, ErrorCode.Unsupported, ErrorCode.ResourceExhausted, ErrorCode.Internal, ErrorCode.Unavailable, ErrorCode.DeadlineExceeded]) -> None: ...
def ErrorAddMessage(builder: flatbuffers.Builder, message: uoffset) -> None: ...
def ErrorAddDetails(builder: flatbuffers.Builder, details: uoffset) -> None: ...
def ErrorStartDetailsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartDetailsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ErrorAddRetryable(builder: flatbuffers.Builder, retryable: bool) -> None: ...
def ErrorEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
