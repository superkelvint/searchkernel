from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.StringEntry import StringEntry, StringEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ErrorDetail(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ErrorDetail: ...
  @classmethod
  def GetRootAsErrorDetail(cls, buf: bytes, offset: int) -> ErrorDetail: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Code(self) -> str | None: ...
  def Path(self) -> str | None: ...
  def Message(self) -> str | None: ...
  def Metadata(self, i: int) -> StringEntry | None: ...
  def MetadataLength(self) -> int: ...
  def MetadataIsNone(self) -> bool: ...
class ErrorDetailT(object):
  code: str | None
  path: str | None
  message: str | None
  metadata: typing.List[StringEntryT]
  def __init__(
    self,
    code: str | None = ...,
    path: str | None = ...,
    message: str | None = ...,
    metadata: typing.List['StringEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ErrorDetailT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ErrorDetailT: ...
  @classmethod
  def InitFromObj(cls, errorDetail: ErrorDetail) -> ErrorDetailT: ...
  def _UnPack(self, errorDetail: ErrorDetail) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ErrorDetailStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ErrorDetailAddCode(builder: flatbuffers.Builder, code: uoffset) -> None: ...
def ErrorDetailAddPath(builder: flatbuffers.Builder, path: uoffset) -> None: ...
def ErrorDetailAddMessage(builder: flatbuffers.Builder, message: uoffset) -> None: ...
def ErrorDetailAddMetadata(builder: flatbuffers.Builder, metadata: uoffset) -> None: ...
def ErrorDetailStartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ErrorDetailEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
