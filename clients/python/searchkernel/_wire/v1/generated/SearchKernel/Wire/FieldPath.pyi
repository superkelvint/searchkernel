from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FieldPath(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FieldPath: ...
  @classmethod
  def GetRootAsFieldPath(cls, buf: bytes, offset: int) -> FieldPath: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Path(self) -> str | None: ...
class FieldPathT(object):
  path: str | None
  def __init__(
    self,
    path: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FieldPathT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FieldPathT: ...
  @classmethod
  def InitFromObj(cls, fieldPath: FieldPath) -> FieldPathT: ...
  def _UnPack(self, fieldPath: FieldPath) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FieldPathStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FieldPathAddPath(builder: flatbuffers.Builder, path: uoffset) -> None: ...
def FieldPathEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
