  def GetRootAsFieldSetDefinition(cls, buf: bytes, offset: int) -> FieldSetDefinition: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def Fields(self, i: int) -> str: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
  def Matching(self) -> MatchingConfig | None: ...
  def QueryCommands(self, i: int) -> str: ...
  def QueryCommandsLength(self) -> int: ...
  def QueryCommandsIsNone(self) -> bool: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
class FieldSetDefinitionT(object):
  name: str | None
  fields: typing.List[str]
  matching: MatchingConfigT | None
  queryCommands: typing.List[str]
  properties: typing.List[ValueEntryT]
  def __init__(
    self,
    name: str | None = ...,
    fields: typing.List[str] | None = ...,
    matching: 'MatchingConfigT' | None = ...,
    queryCommands: typing.List[str] | None = ...,
    properties: typing.List['ValueEntryT'] | None = ...,
