  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FieldSetDefinitionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FieldSetDefinitionT: ...
  @classmethod
  def InitFromObj(cls, fieldSetDefinition: FieldSetDefinition) -> FieldSetDefinitionT: ...
  def _UnPack(self, fieldSetDefinition: FieldSetDefinition) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
