from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FieldSortTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FieldSortTarget: ...
  @classmethod
  def GetRootAsFieldSortTarget(cls, buf: bytes, offset: int) -> FieldSortTarget: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
class FieldSortTargetT(object):
  field: str | None
  def __init__(
    self,
    field: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FieldSortTargetT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FieldSortTargetT: ...
  @classmethod
  def InitFromObj(cls, fieldSortTarget: FieldSortTarget) -> FieldSortTargetT: ...
  def _UnPack(self, fieldSortTarget: FieldSortTarget) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FieldSortTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FieldSortTargetAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def FieldSortTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
