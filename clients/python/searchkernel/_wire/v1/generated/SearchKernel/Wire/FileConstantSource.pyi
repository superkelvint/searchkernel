from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FileConstantSource(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FileConstantSource: ...
  @classmethod
  def GetRootAsFileConstantSource(cls, buf: bytes, offset: int) -> FileConstantSource: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Path(self) -> str | None: ...
class FileConstantSourceT(object):
  path: str | None
  def __init__(
    self,
    path: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FileConstantSourceT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FileConstantSourceT: ...
  @classmethod
  def InitFromObj(cls, fileConstantSource: FileConstantSource) -> FileConstantSourceT: ...
  def _UnPack(self, fileConstantSource: FileConstantSource) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FileConstantSourceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FileConstantSourceAddPath(builder: flatbuffers.Builder, path: uoffset) -> None: ...
def FileConstantSourceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
