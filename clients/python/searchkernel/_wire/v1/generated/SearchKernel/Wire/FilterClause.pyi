from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterClause(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterClause: ...
  @classmethod
  def GetRootAsFilterClause(cls, buf: bytes, offset: int) -> FilterClause: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Source(self) -> str | None: ...
  def Bindings(self, i: int) -> ValueEntry | None: ...
  def BindingsLength(self) -> int: ...
  def BindingsIsNone(self) -> bool: ...
class FilterClauseT(object):
  source: str | None
  bindings: typing.List[ValueEntryT]
  def __init__(
    self,
    source: str | None = ...,
    bindings: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FilterClauseT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FilterClauseT: ...
  @classmethod
  def InitFromObj(cls, filterClause: FilterClause) -> FilterClauseT: ...
  def _UnPack(self, filterClause: FilterClause) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FilterClauseStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterClauseAddSource(builder: flatbuffers.Builder, source: uoffset) -> None: ...
def FilterClauseAddBindings(builder: flatbuffers.Builder, bindings: uoffset) -> None: ...
def FilterClauseStartBindingsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartBindingsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterClauseEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
