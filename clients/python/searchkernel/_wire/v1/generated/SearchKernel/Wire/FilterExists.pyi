from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryFieldRef import QueryFieldRef, QueryFieldRefT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterExists(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterExists: ...
  @classmethod
  def GetRootAsFilterExists(cls, buf: bytes, offset: int) -> FilterExists: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
class FilterExistsT(object):
  field: QueryFieldRefT | None
  def __init__(
    self,
    field: 'QueryFieldRefT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FilterExistsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FilterExistsT: ...
  @classmethod
  def InitFromObj(cls, filterExists: FilterExists) -> FilterExistsT: ...
  def _UnPack(self, filterExists: FilterExists) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FilterExistsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterExistsAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def FilterExistsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
