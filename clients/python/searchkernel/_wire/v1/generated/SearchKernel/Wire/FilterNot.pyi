from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FilterExpr import FilterExpr, FilterExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterNot(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterNot: ...
  @classmethod
  def GetRootAsFilterNot(cls, buf: bytes, offset: int) -> FilterNot: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clause(self) -> FilterExpr | None: ...
class FilterNotT(object):
  clause: FilterExprT | None
  def __init__(
    self,
    clause: 'FilterExprT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FilterNotT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FilterNotT: ...
  @classmethod
  def InitFromObj(cls, filterNot: FilterNot) -> FilterNotT: ...
  def _UnPack(self, filterNot: FilterNot) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FilterNotStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterNotAddClause(builder: flatbuffers.Builder, clause: uoffset) -> None: ...
def FilterNotEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
