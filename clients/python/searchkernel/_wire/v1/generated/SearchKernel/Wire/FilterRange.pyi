from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT
from SearchKernel.Wire.QueryFieldRef import QueryFieldRef, QueryFieldRefT
from SearchKernel.Wire.RangeBound import RangeBound, RangeBoundT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterRange(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterRange: ...
  @classmethod
  def GetRootAsFilterRange(cls, buf: bytes, offset: int) -> FilterRange: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Lower(self) -> RangeBound | None: ...
  def Upper(self) -> RangeBound | None: ...
  def IncludeLower(self) -> OptionalBool | None: ...
  def IncludeUpper(self) -> OptionalBool | None: ...
class FilterRangeT(object):
  field: QueryFieldRefT | None
  lower: RangeBoundT | None
  upper: RangeBoundT | None
  includeLower: OptionalBoolT | None
  includeUpper: OptionalBoolT | None
  def __init__(
    self,
    field: 'QueryFieldRefT' | None = ...,
    lower: 'RangeBoundT' | None = ...,
    upper: 'RangeBoundT' | None = ...,
    includeLower: 'OptionalBoolT' | None = ...,
    includeUpper: 'OptionalBoolT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FilterRangeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FilterRangeT: ...
  @classmethod
  def InitFromObj(cls, filterRange: FilterRange) -> FilterRangeT: ...
  def _UnPack(self, filterRange: FilterRange) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FilterRangeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterRangeAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def FilterRangeAddLower(builder: flatbuffers.Builder, lower: uoffset) -> None: ...
def FilterRangeAddUpper(builder: flatbuffers.Builder, upper: uoffset) -> None: ...
def FilterRangeAddIncludeLower(builder: flatbuffers.Builder, includeLower: uoffset) -> None: ...
def FilterRangeAddIncludeUpper(builder: flatbuffers.Builder, includeUpper: uoffset) -> None: ...
def FilterRangeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
