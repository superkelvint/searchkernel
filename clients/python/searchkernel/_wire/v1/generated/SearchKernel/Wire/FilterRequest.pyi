from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FilterClause import FilterClause, FilterClauseT
from SearchKernel.Wire.FilterExpr import FilterExpr, FilterExprT
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterRequest: ...
  @classmethod
  def GetRootAsFilterRequest(cls, buf: bytes, offset: int) -> FilterRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Structured(self, i: int) -> FilterExpr | None: ...
  def StructuredLength(self) -> int: ...
  def StructuredIsNone(self) -> bool: ...
  def Sources(self, i: int) -> str: ...
  def SourcesLength(self) -> int: ...
  def SourcesIsNone(self) -> bool: ...
  def Parameters(self, i: int) -> ValueEntry | None: ...
  def ParametersLength(self) -> int: ...
  def ParametersIsNone(self) -> bool: ...
  def Textual(self, i: int) -> FilterClause | None: ...
  def TextualLength(self) -> int: ...
  def TextualIsNone(self) -> bool: ...
class FilterRequestT(object):
  structured: typing.List[FilterExprT]
  sources: typing.List[str]
  parameters: typing.List[ValueEntryT]
  textual: typing.List[FilterClauseT]
  def __init__(
    self,
    structured: typing.List['FilterExprT'] | None = ...,
    sources: typing.List[str] | None = ...,
    parameters: typing.List['ValueEntryT'] | None = ...,
    textual: typing.List['FilterClauseT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FilterRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FilterRequestT: ...
  @classmethod
  def InitFromObj(cls, filterRequest: FilterRequest) -> FilterRequestT: ...
  def _UnPack(self, filterRequest: FilterRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FilterRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterRequestAddStructured(builder: flatbuffers.Builder, structured: uoffset) -> None: ...
def FilterRequestStartStructuredVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartStructuredVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterRequestAddSources(builder: flatbuffers.Builder, sources: uoffset) -> None: ...
def FilterRequestStartSourcesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartSourcesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterRequestAddParameters(builder: flatbuffers.Builder, parameters: uoffset) -> None: ...
def FilterRequestStartParametersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartParametersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterRequestAddTextual(builder: flatbuffers.Builder, textual: uoffset) -> None: ...
def FilterRequestStartTextualVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartTextualVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
