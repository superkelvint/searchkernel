from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FiniteRangeBound(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FiniteRangeBound: ...
  @classmethod
  def GetRootAsFiniteRangeBound(cls, buf: bytes, offset: int) -> FiniteRangeBound: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class FiniteRangeBoundT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FiniteRangeBoundT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FiniteRangeBoundT: ...
  @classmethod
  def InitFromObj(cls, finiteRangeBound: FiniteRangeBound) -> FiniteRangeBoundT: ...
  def _UnPack(self, finiteRangeBound: FiniteRangeBound) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FiniteRangeBoundStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FiniteRangeBoundAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def FiniteRangeBoundEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
