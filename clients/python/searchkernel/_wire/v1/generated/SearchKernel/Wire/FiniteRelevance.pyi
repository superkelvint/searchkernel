from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FiniteRelevance(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FiniteRelevance: ...
  @classmethod
  def GetRootAsFiniteRelevance(cls, buf: bytes, offset: int) -> FiniteRelevance: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> float: ...
class FiniteRelevanceT(object):
  value: float
  def __init__(
    self,
    value: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FiniteRelevanceT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FiniteRelevanceT: ...
  @classmethod
  def InitFromObj(cls, finiteRelevance: FiniteRelevance) -> FiniteRelevanceT: ...
  def _UnPack(self, finiteRelevance: FiniteRelevance) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FiniteRelevanceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FiniteRelevanceAddValue(builder: flatbuffers.Builder, value: float) -> None: ...
def FiniteRelevanceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
