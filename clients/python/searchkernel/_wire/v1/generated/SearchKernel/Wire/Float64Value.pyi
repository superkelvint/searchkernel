from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Float64Value(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Float64Value: ...
  @classmethod
  def GetRootAsFloat64Value(cls, buf: bytes, offset: int) -> Float64Value: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> float: ...
class Float64ValueT(object):
  value: float
  def __init__(
    self,
    value: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> Float64ValueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> Float64ValueT: ...
  @classmethod
  def InitFromObj(cls, float64Value: Float64Value) -> Float64ValueT: ...
  def _UnPack(self, float64Value: Float64Value) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def Float64ValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def Float64ValueAddValue(builder: flatbuffers.Builder, value: float) -> None: ...
def Float64ValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
