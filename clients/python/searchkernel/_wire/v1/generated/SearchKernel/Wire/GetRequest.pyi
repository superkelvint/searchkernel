from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FieldProjection import FieldProjection, FieldProjectionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GetRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GetRequest: ...
  @classmethod
  def GetRootAsGetRequest(cls, buf: bytes, offset: int) -> GetRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def Projection(self) -> FieldProjection | None: ...
class GetRequestT(object):
  id: str | None
  projection: FieldProjectionT | None
  def __init__(
    self,
    id: str | None = ...,
    projection: 'FieldProjectionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GetRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GetRequestT: ...
  @classmethod
  def InitFromObj(cls, getRequest: GetRequest) -> GetRequestT: ...
  def _UnPack(self, getRequest: GetRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GetRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GetRequestAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def GetRequestAddProjection(builder: flatbuffers.Builder, projection: uoffset) -> None: ...
def GetRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
