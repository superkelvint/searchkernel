from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Document import Document, DocumentT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GetResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GetResult: ...
  @classmethod
  def GetRootAsGetResult(cls, buf: bytes, offset: int) -> GetResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Document(self) -> Document | None: ...
class GetResultT(object):
  document: DocumentT | None
  def __init__(
    self,
    document: 'DocumentT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GetResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GetResultT: ...
  @classmethod
  def InitFromObj(cls, getResult: GetResult) -> GetResultT: ...
  def _UnPack(self, getResult: GetResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GetResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GetResultAddDocument(builder: flatbuffers.Builder, document: uoffset) -> None: ...
def GetResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
