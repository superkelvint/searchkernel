  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingAliasReferenceT: ...
  @classmethod
  def InitFromObj(cls, groupingAliasReference: GroupingAliasReference) -> GroupingAliasReferenceT: ...
