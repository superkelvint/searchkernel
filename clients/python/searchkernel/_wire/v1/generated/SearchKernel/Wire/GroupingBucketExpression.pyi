from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT
from SearchKernel.Wire.RangeBound import RangeBound, RangeBoundT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingBucketExpression(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingBucketExpression: ...
  @classmethod
  def GetRootAsGroupingBucketExpression(cls, buf: bytes, offset: int) -> GroupingBucketExpression: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Lower(self) -> RangeBound | None: ...
  def Upper(self) -> RangeBound | None: ...
  def IncludeLower(self) -> OptionalBool | None: ...
  def IncludeUpper(self) -> OptionalBool | None: ...
class GroupingBucketExpressionT(object):
  lower: RangeBoundT | None
  upper: RangeBoundT | None
  includeLower: OptionalBoolT | None
  includeUpper: OptionalBoolT | None
  def __init__(
    self,
    lower: 'RangeBoundT' | None = ...,
    upper: 'RangeBoundT' | None = ...,
    includeLower: 'OptionalBoolT' | None = ...,
    includeUpper: 'OptionalBoolT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingBucketExpressionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingBucketExpressionT: ...
  @classmethod
  def InitFromObj(cls, groupingBucketExpression: GroupingBucketExpression) -> GroupingBucketExpressionT: ...
  def _UnPack(self, groupingBucketExpression: GroupingBucketExpression) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingBucketExpressionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingBucketExpressionAddLower(builder: flatbuffers.Builder, lower: uoffset) -> None: ...
def GroupingBucketExpressionAddUpper(builder: flatbuffers.Builder, upper: uoffset) -> None: ...
def GroupingBucketExpressionAddIncludeLower(builder: flatbuffers.Builder, includeLower: uoffset) -> None: ...
def GroupingBucketExpressionAddIncludeUpper(builder: flatbuffers.Builder, includeUpper: uoffset) -> None: ...
def GroupingBucketExpressionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
