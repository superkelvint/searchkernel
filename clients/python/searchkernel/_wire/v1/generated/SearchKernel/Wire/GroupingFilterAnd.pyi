from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingFilterExpr import GroupingFilterExpr, GroupingFilterExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingFilterAnd(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingFilterAnd: ...
  @classmethod
  def GetRootAsGroupingFilterAnd(cls, buf: bytes, offset: int) -> GroupingFilterAnd: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> GroupingFilterExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
class GroupingFilterAndT(object):
  clauses: typing.List[GroupingFilterExprT]
  def __init__(
    self,
    clauses: typing.List['GroupingFilterExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingFilterAndT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingFilterAndT: ...
  @classmethod
  def InitFromObj(cls, groupingFilterAnd: GroupingFilterAnd) -> GroupingFilterAndT: ...
  def _UnPack(self, groupingFilterAnd: GroupingFilterAnd) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingFilterAndStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingFilterAndAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def GroupingFilterAndStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GroupingFilterAndEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
