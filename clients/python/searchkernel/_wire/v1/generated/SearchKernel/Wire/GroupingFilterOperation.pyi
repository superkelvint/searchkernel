from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingFilterExpr import GroupingFilterExpr, GroupingFilterExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingFilterOperation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingFilterOperation: ...
  @classmethod
  def GetRootAsGroupingFilterOperation(cls, buf: bytes, offset: int) -> GroupingFilterOperation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Filter(self) -> GroupingFilterExpr | None: ...
class GroupingFilterOperationT(object):
  filter: GroupingFilterExprT | None
  def __init__(
    self,
    filter: 'GroupingFilterExprT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingFilterOperationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingFilterOperationT: ...
  @classmethod
  def InitFromObj(cls, groupingFilterOperation: GroupingFilterOperation) -> GroupingFilterOperationT: ...
  def _UnPack(self, groupingFilterOperation: GroupingFilterOperation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingFilterOperationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingFilterOperationAddFilter(builder: flatbuffers.Builder, filter: uoffset) -> None: ...
def GroupingFilterOperationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
