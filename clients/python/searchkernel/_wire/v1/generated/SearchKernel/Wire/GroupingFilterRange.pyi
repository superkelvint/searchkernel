  def InitFromObj(cls, groupingFilterRange: GroupingFilterRange) -> GroupingFilterRangeT: ...
  def _UnPack(self, groupingFilterRange: GroupingFilterRange) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
