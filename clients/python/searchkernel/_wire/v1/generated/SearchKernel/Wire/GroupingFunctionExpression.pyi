from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingFunctionExpression(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingFunctionExpression: ...
  @classmethod
  def GetRootAsGroupingFunctionExpression(cls, buf: bytes, offset: int) -> GroupingFunctionExpression: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def Arguments(self, i: int) -> GroupingExpression | None: ...
  def ArgumentsLength(self) -> int: ...
  def ArgumentsIsNone(self) -> bool: ...
class GroupingFunctionExpressionT(object):
  name: str | None
  arguments: typing.List[GroupingExpressionT]
  def __init__(
    self,
    name: str | None = ...,
    arguments: typing.List['GroupingExpressionT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingFunctionExpressionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingFunctionExpressionT: ...
  @classmethod
  def InitFromObj(cls, groupingFunctionExpression: GroupingFunctionExpression) -> GroupingFunctionExpressionT: ...
  def _UnPack(self, groupingFunctionExpression: GroupingFunctionExpression) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingFunctionExpressionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingFunctionExpressionAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def GroupingFunctionExpressionAddArguments(builder: flatbuffers.Builder, arguments: uoffset) -> None: ...
def GroupingFunctionExpressionStartArgumentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartArgumentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GroupingFunctionExpressionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
