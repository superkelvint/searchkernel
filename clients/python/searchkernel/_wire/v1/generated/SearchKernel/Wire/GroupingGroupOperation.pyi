from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingGroupOperation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingGroupOperation: ...
  @classmethod
  def GetRootAsGroupingGroupOperation(cls, buf: bytes, offset: int) -> GroupingGroupOperation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
class GroupingGroupOperationT(object):
  expression: GroupingExpressionT | None
  def __init__(
    self,
    expression: 'GroupingExpressionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingGroupOperationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingGroupOperationT: ...
  @classmethod
  def InitFromObj(cls, groupingGroupOperation: GroupingGroupOperation) -> GroupingGroupOperationT: ...
  def _UnPack(self, groupingGroupOperation: GroupingGroupOperation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingGroupOperationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingGroupOperationAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def GroupingGroupOperationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
