from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingLiteralExpression(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingLiteralExpression: ...
  @classmethod
  def GetRootAsGroupingLiteralExpression(cls, buf: bytes, offset: int) -> GroupingLiteralExpression: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class GroupingLiteralExpressionT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingLiteralExpressionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingLiteralExpressionT: ...
  @classmethod
  def InitFromObj(cls, groupingLiteralExpression: GroupingLiteralExpression) -> GroupingLiteralExpressionT: ...
  def _UnPack(self, groupingLiteralExpression: GroupingLiteralExpression) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingLiteralExpressionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingLiteralExpressionAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def GroupingLiteralExpressionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
