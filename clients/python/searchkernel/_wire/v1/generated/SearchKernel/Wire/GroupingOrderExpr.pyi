  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingOrderExprT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingOrderExprT: ...
  @classmethod
  def InitFromObj(cls, groupingOrderExpr: GroupingOrderExpr) -> GroupingOrderExprT: ...
  def _UnPack(self, groupingOrderExpr: GroupingOrderExpr) -> None: ...
