  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingOrderExpr: ...
  @classmethod
  def GetRootAsGroupingOrderExpr(cls, buf: bytes, offset: int) -> GroupingOrderExpr: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
class GroupingOrderExprT(object):
