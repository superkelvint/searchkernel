def GroupingOrderExprStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingOrderExprAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def GroupingOrderExprEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
