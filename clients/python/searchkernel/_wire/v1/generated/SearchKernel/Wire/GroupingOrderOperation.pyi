from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingOrderExpr import GroupingOrderExpr, GroupingOrderExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingOrderOperation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingOrderOperation: ...
  @classmethod
  def GetRootAsGroupingOrderOperation(cls, buf: bytes, offset: int) -> GroupingOrderOperation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expressions(self, i: int) -> GroupingOrderExpr | None: ...
  def ExpressionsLength(self) -> int: ...
  def ExpressionsIsNone(self) -> bool: ...
class GroupingOrderOperationT(object):
  expressions: typing.List[GroupingOrderExprT]
  def __init__(
    self,
    expressions: typing.List['GroupingOrderExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingOrderOperationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingOrderOperationT: ...
  @classmethod
  def InitFromObj(cls, groupingOrderOperation: GroupingOrderOperation) -> GroupingOrderOperationT: ...
  def _UnPack(self, groupingOrderOperation: GroupingOrderOperation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingOrderOperationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingOrderOperationAddExpressions(builder: flatbuffers.Builder, expressions: uoffset) -> None: ...
def GroupingOrderOperationStartExpressionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartExpressionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GroupingOrderOperationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
