from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingOutput(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingOutput: ...
  @classmethod
  def GetRootAsGroupingOutput(cls, buf: bytes, offset: int) -> GroupingOutput: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Label(self) -> str | None: ...
  def Expression(self) -> GroupingExpression | None: ...
class GroupingOutputT(object):
  label: str | None
  expression: GroupingExpressionT | None
  def __init__(
    self,
    label: str | None = ...,
    expression: 'GroupingExpressionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingOutputT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingOutputT: ...
  @classmethod
  def InitFromObj(cls, groupingOutput: GroupingOutput) -> GroupingOutputT: ...
  def _UnPack(self, groupingOutput: GroupingOutput) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingOutputStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingOutputAddLabel(builder: flatbuffers.Builder, label: uoffset) -> None: ...
def GroupingOutputAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def GroupingOutputEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
