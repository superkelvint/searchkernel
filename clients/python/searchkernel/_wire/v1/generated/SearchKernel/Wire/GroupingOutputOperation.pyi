from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingOutput import GroupingOutput, GroupingOutputT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingOutputOperation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingOutputOperation: ...
  @classmethod
  def GetRootAsGroupingOutputOperation(cls, buf: bytes, offset: int) -> GroupingOutputOperation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Outputs(self, i: int) -> GroupingOutput | None: ...
  def OutputsLength(self) -> int: ...
  def OutputsIsNone(self) -> bool: ...
class GroupingOutputOperationT(object):
  outputs: typing.List[GroupingOutputT]
  def __init__(
    self,
    outputs: typing.List['GroupingOutputT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingOutputOperationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingOutputOperationT: ...
  @classmethod
  def InitFromObj(cls, groupingOutputOperation: GroupingOutputOperation) -> GroupingOutputOperationT: ...
  def _UnPack(self, groupingOutputOperation: GroupingOutputOperation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingOutputOperationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingOutputOperationAddOutputs(builder: flatbuffers.Builder, outputs: uoffset) -> None: ...
def GroupingOutputOperationStartOutputsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOutputsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GroupingOutputOperationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
