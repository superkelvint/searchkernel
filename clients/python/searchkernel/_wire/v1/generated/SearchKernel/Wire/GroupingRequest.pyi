from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingSourceKind import GroupingSourceKind
from SearchKernel.Wire.RawGroupingSource import RawGroupingSourceT
from SearchKernel.Wire.StructuredGroupingSource import StructuredGroupingSourceT
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingRequest: ...
  @classmethod
  def GetRootAsGroupingRequest(cls, buf: bytes, offset: int) -> GroupingRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def SourceType(self) -> typing.Literal[GroupingSourceKind.NONE, GroupingSourceKind.RawGroupingSource, GroupingSourceKind.StructuredGroupingSource]: ...
  def Source(self) -> table.Table | None: ...
  def Continuations(self, i: int) -> str: ...
  def ContinuationsLength(self) -> int: ...
  def ContinuationsIsNone(self) -> bool: ...
class GroupingRequestT(object):
  sourceType: typing.Literal[GroupingSourceKind.NONE, GroupingSourceKind.RawGroupingSource, GroupingSourceKind.StructuredGroupingSource]
  source: typing.Union[None, RawGroupingSourceT, StructuredGroupingSourceT]
  continuations: typing.List[str]
  def __init__(
    self,
    sourceType: typing.Literal[GroupingSourceKind.NONE, GroupingSourceKind.RawGroupingSource, GroupingSourceKind.StructuredGroupingSource] = ...,
    source: typing.Union[None, RawGroupingSourceT, StructuredGroupingSourceT] = ...,
    continuations: typing.List[str] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GroupingRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GroupingRequestT: ...
  @classmethod
  def InitFromObj(cls, groupingRequest: GroupingRequest) -> GroupingRequestT: ...
  def _UnPack(self, groupingRequest: GroupingRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GroupingRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingRequestAddSourceType(builder: flatbuffers.Builder, sourceType: typing.Literal[GroupingSourceKind.NONE, GroupingSourceKind.RawGroupingSource, GroupingSourceKind.StructuredGroupingSource]) -> None: ...
def GroupingRequestAddSource(builder: flatbuffers.Builder, source: uoffset) -> None: ...
def GroupingRequestAddContinuations(builder: flatbuffers.Builder, continuations: uoffset) -> None: ...
def GroupingRequestStartContinuationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartContinuationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GroupingRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
