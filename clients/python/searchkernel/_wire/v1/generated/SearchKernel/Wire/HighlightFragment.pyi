from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.HighlightSpan import HighlightSpan, HighlightSpanT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class HighlightFragment(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> HighlightFragment: ...
  @classmethod
  def GetRootAsHighlightFragment(cls, buf: bytes, offset: int) -> HighlightFragment: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Text(self) -> str | None: ...
  def Matches(self, i: int) -> HighlightSpan | None: ...
  def MatchesLength(self) -> int: ...
  def MatchesIsNone(self) -> bool: ...
class HighlightFragmentT(object):
  text: str | None
  matches: typing.List[HighlightSpanT]
  def __init__(
    self,
    text: str | None = ...,
    matches: typing.List['HighlightSpanT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> HighlightFragmentT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> HighlightFragmentT: ...
  @classmethod
  def InitFromObj(cls, highlightFragment: HighlightFragment) -> HighlightFragmentT: ...
  def _UnPack(self, highlightFragment: HighlightFragment) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def HighlightFragmentStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def HighlightFragmentAddText(builder: flatbuffers.Builder, text: uoffset) -> None: ...
def HighlightFragmentAddMatches(builder: flatbuffers.Builder, matches: uoffset) -> None: ...
def HighlightFragmentStartMatchesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartMatchesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def HighlightFragmentEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
