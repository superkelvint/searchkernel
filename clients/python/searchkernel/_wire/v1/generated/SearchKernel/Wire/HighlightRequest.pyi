from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class HighlightRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> HighlightRequest: ...
  @classmethod
  def GetRootAsHighlightRequest(cls, buf: bytes, offset: int) -> HighlightRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Fields(self, i: int) -> str: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
class HighlightRequestT(object):
  fields: typing.List[str]
  def __init__(
    self,
    fields: typing.List[str] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> HighlightRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> HighlightRequestT: ...
  @classmethod
  def InitFromObj(cls, highlightRequest: HighlightRequest) -> HighlightRequestT: ...
  def _UnPack(self, highlightRequest: HighlightRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def HighlightRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def HighlightRequestAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def HighlightRequestStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def HighlightRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
