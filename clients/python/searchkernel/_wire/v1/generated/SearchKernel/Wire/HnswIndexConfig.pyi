from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalUInt32 import OptionalUInt32, OptionalUInt32T
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class HnswIndexConfig(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> HnswIndexConfig: ...
  @classmethod
  def GetRootAsHnswIndexConfig(cls, buf: bytes, offset: int) -> HnswIndexConfig: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def MaxLinksPerNode(self) -> OptionalUInt32 | None: ...
  def NeighborsToExploreAtInsert(self) -> OptionalUInt32 | None: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
class HnswIndexConfigT(object):
  maxLinksPerNode: OptionalUInt32T | None
  neighborsToExploreAtInsert: OptionalUInt32T | None
  options: typing.List[ValueEntryT]
  def __init__(
    self,
    maxLinksPerNode: 'OptionalUInt32T' | None = ...,
    neighborsToExploreAtInsert: 'OptionalUInt32T' | None = ...,
    options: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> HnswIndexConfigT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> HnswIndexConfigT: ...
  @classmethod
  def InitFromObj(cls, hnswIndexConfig: HnswIndexConfig) -> HnswIndexConfigT: ...
  def _UnPack(self, hnswIndexConfig: HnswIndexConfig) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def HnswIndexConfigStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def HnswIndexConfigAddMaxLinksPerNode(builder: flatbuffers.Builder, maxLinksPerNode: uoffset) -> None: ...
def HnswIndexConfigAddNeighborsToExploreAtInsert(builder: flatbuffers.Builder, neighborsToExploreAtInsert: uoffset) -> None: ...
def HnswIndexConfigAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def HnswIndexConfigStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def HnswIndexConfigEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
