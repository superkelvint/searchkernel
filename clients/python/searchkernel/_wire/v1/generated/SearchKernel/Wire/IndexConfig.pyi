from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.HnswIndexConfig import HnswIndexConfig, HnswIndexConfigT
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class IndexConfig(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> IndexConfig: ...
  @classmethod
  def GetRootAsIndexConfig(cls, buf: bytes, offset: int) -> IndexConfig: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Enabled(self) -> OptionalBool | None: ...
  def Hnsw(self) -> HnswIndexConfig | None: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
class IndexConfigT(object):
  enabled: OptionalBoolT | None
  hnsw: HnswIndexConfigT | None
  options: typing.List[ValueEntryT]
  def __init__(
    self,
    enabled: 'OptionalBoolT' | None = ...,
    hnsw: 'HnswIndexConfigT' | None = ...,
    options: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> IndexConfigT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> IndexConfigT: ...
  @classmethod
  def InitFromObj(cls, indexConfig: IndexConfig) -> IndexConfigT: ...
  def _UnPack(self, indexConfig: IndexConfig) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def IndexConfigStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def IndexConfigAddEnabled(builder: flatbuffers.Builder, enabled: uoffset) -> None: ...
def IndexConfigAddHnsw(builder: flatbuffers.Builder, hnsw: uoffset) -> None: ...
def IndexConfigAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def IndexConfigStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def IndexConfigEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
