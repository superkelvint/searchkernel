from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class IndexTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> IndexTarget: ...
  @classmethod
  def GetRootAsIndexTarget(cls, buf: bytes, offset: int) -> IndexTarget: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
class IndexTargetT(object):
  name: str | None
  def __init__(
    self,
    name: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> IndexTargetT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> IndexTargetT: ...
  @classmethod
  def InitFromObj(cls, indexTarget: IndexTarget) -> IndexTargetT: ...
  def _UnPack(self, indexTarget: IndexTarget) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def IndexTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def IndexTargetAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def IndexTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
