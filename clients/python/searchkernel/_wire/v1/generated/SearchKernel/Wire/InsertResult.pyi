from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class InsertResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> InsertResult: ...
  @classmethod
  def GetRootAsInsertResult(cls, buf: bytes, offset: int) -> InsertResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
class InsertResultT(object):
  id: str | None
  def __init__(
    self,
    id: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> InsertResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> InsertResultT: ...
  @classmethod
  def InitFromObj(cls, insertResult: InsertResult) -> InsertResultT: ...
  def _UnPack(self, insertResult: InsertResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def InsertResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def InsertResultAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def InsertResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
