  def GetRootAsInspectQueryRequest(cls, buf: bytes, offset: int) -> InspectQueryRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Request(self) -> SearchRequest | None: ...
class InspectQueryRequestT(object):
