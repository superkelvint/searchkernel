def InspectQueryRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def InspectQueryRequestAddRequest(builder: flatbuffers.Builder, request: uoffset) -> None: ...
def InspectQueryRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
