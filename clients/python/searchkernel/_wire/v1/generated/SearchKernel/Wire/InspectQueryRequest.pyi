from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.SearchRequest import SearchRequest, SearchRequestT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class InspectQueryRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> InspectQueryRequest: ...
