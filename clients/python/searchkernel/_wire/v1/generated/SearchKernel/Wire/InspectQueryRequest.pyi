  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> InspectQueryRequestT: ...
  @classmethod
  def InitFromObj(cls, inspectQueryRequest: InspectQueryRequest) -> InspectQueryRequestT: ...
  def _UnPack(self, inspectQueryRequest: InspectQueryRequest) -> None: ...
