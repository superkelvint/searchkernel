from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Int64Value(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Int64Value: ...
  @classmethod
  def GetRootAsInt64Value(cls, buf: bytes, offset: int) -> Int64Value: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> int: ...
class Int64ValueT(object):
  value: int
  def __init__(
    self,
    value: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> Int64ValueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> Int64ValueT: ...
  @classmethod
  def InitFromObj(cls, int64Value: Int64Value) -> Int64ValueT: ...
  def _UnPack(self, int64Value: Int64Value) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def Int64ValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def Int64ValueAddValue(builder: flatbuffers.Builder, value: int) -> None: ...
def Int64ValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
