from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class LiteralConstantSource(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> LiteralConstantSource: ...
  @classmethod
  def GetRootAsLiteralConstantSource(cls, buf: bytes, offset: int) -> LiteralConstantSource: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class LiteralConstantSourceT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> LiteralConstantSourceT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> LiteralConstantSourceT: ...
  @classmethod
  def InitFromObj(cls, literalConstantSource: LiteralConstantSource) -> LiteralConstantSourceT: ...
  def _UnPack(self, literalConstantSource: LiteralConstantSource) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def LiteralConstantSourceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def LiteralConstantSourceAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def LiteralConstantSourceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
