from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class LiteralQueryInput(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> LiteralQueryInput: ...
  @classmethod
  def GetRootAsLiteralQueryInput(cls, buf: bytes, offset: int) -> LiteralQueryInput: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class LiteralQueryInputT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> LiteralQueryInputT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> LiteralQueryInputT: ...
  @classmethod
  def InitFromObj(cls, literalQueryInput: LiteralQueryInput) -> LiteralQueryInputT: ...
  def _UnPack(self, literalQueryInput: LiteralQueryInput) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def LiteralQueryInputStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def LiteralQueryInputAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def LiteralQueryInputEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
