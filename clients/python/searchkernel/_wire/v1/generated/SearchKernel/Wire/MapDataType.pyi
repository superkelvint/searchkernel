from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.DataType import DataType, DataTypeT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MapDataType(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MapDataType: ...
  @classmethod
  def GetRootAsMapDataType(cls, buf: bytes, offset: int) -> MapDataType: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def KeyType(self) -> DataType | None: ...
  def ValueType(self) -> DataType | None: ...
class MapDataTypeT(object):
  keyType: DataTypeT | None
  valueType: DataTypeT | None
  def __init__(
    self,
    keyType: 'DataTypeT' | None = ...,
    valueType: 'DataTypeT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MapDataTypeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MapDataTypeT: ...
  @classmethod
  def InitFromObj(cls, mapDataType: MapDataType) -> MapDataTypeT: ...
  def _UnPack(self, mapDataType: MapDataType) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MapDataTypeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MapDataTypeAddKeyType(builder: flatbuffers.Builder, keyType: uoffset) -> None: ...
def MapDataTypeAddValueType(builder: flatbuffers.Builder, valueType: uoffset) -> None: ...
def MapDataTypeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
