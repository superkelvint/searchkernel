from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.MatchedElementUpdate import MatchedElementUpdate, MatchedElementUpdateT
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MatchUpdate(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MatchUpdate: ...
  @classmethod
  def GetRootAsMatchUpdate(cls, buf: bytes, offset: int) -> MatchUpdate: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Element(self) -> Value | None: ...
  def Update(self) -> MatchedElementUpdate | None: ...
class MatchUpdateT(object):
  element: ValueT | None
  update: MatchedElementUpdateT | None
  def __init__(
    self,
    element: 'ValueT' | None = ...,
    update: 'MatchedElementUpdateT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MatchUpdateT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MatchUpdateT: ...
  @classmethod
  def InitFromObj(cls, matchUpdate: MatchUpdate) -> MatchUpdateT: ...
  def _UnPack(self, matchUpdate: MatchUpdate) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MatchUpdateStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MatchUpdateAddElement(builder: flatbuffers.Builder, element: uoffset) -> None: ...
def MatchUpdateAddUpdate(builder: flatbuffers.Builder, update: uoffset) -> None: ...
def MatchUpdateEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
