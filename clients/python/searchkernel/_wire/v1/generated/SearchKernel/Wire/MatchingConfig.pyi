from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.MatchingMode import MatchingMode
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MatchingConfig(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MatchingConfig: ...
  @classmethod
  def GetRootAsMatchingConfig(cls, buf: bytes, offset: int) -> MatchingConfig: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Mode(self) -> typing.Literal[MatchingMode.Unspecified, MatchingMode.Text, MatchingMode.Word, MatchingMode.Exact, MatchingMode.Gram]: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
class MatchingConfigT(object):
  mode: typing.Literal[MatchingMode.Unspecified, MatchingMode.Text, MatchingMode.Word, MatchingMode.Exact, MatchingMode.Gram]
  options: typing.List[ValueEntryT]
  def __init__(
    self,
    mode: typing.Literal[MatchingMode.Unspecified, MatchingMode.Text, MatchingMode.Word, MatchingMode.Exact, MatchingMode.Gram] = ...,
    options: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MatchingConfigT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MatchingConfigT: ...
  @classmethod
  def InitFromObj(cls, matchingConfig: MatchingConfig) -> MatchingConfigT: ...
  def _UnPack(self, matchingConfig: MatchingConfig) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MatchingConfigStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MatchingConfigAddMode(builder: flatbuffers.Builder, mode: typing.Literal[MatchingMode.Unspecified, MatchingMode.Text, MatchingMode.Word, MatchingMode.Exact, MatchingMode.Gram]) -> None: ...
def MatchingConfigAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def MatchingConfigStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def MatchingConfigEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
