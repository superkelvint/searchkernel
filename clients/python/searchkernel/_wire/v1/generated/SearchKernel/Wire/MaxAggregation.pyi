from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MaxAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MaxAggregation: ...
  @classmethod
  def GetRootAsMaxAggregation(cls, buf: bytes, offset: int) -> MaxAggregation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
class MaxAggregationT(object):
  expression: GroupingExpressionT | None
  def __init__(
    self,
    expression: 'GroupingExpressionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MaxAggregationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MaxAggregationT: ...
  @classmethod
  def InitFromObj(cls, maxAggregation: MaxAggregation) -> MaxAggregationT: ...
  def _UnPack(self, maxAggregation: MaxAggregation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MaxAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MaxAggregationAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def MaxAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
