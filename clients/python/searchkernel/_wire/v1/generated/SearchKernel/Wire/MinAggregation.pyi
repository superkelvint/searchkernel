from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MinAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MinAggregation: ...
  @classmethod
  def GetRootAsMinAggregation(cls, buf: bytes, offset: int) -> MinAggregation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
class MinAggregationT(object):
  expression: GroupingExpressionT | None
  def __init__(
    self,
    expression: 'GroupingExpressionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MinAggregationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MinAggregationT: ...
  @classmethod
  def InitFromObj(cls, minAggregation: MinAggregation) -> MinAggregationT: ...
  def _UnPack(self, minAggregation: MinAggregation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MinAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MinAggregationAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def MinAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
