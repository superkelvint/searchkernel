from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MissingAs(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MissingAs: ...
  @classmethod
  def GetRootAsMissingAs(cls, buf: bytes, offset: int) -> MissingAs: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class MissingAsT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MissingAsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MissingAsT: ...
  @classmethod
  def InitFromObj(cls, missingAs: MissingAs) -> MissingAsT: ...
  def _UnPack(self, missingAs: MissingAs) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MissingAsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MissingAsAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def MissingAsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
