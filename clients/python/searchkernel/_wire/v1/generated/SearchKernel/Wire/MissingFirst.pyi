from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MissingFirst(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MissingFirst: ...
  @classmethod
  def GetRootAsMissingFirst(cls, buf: bytes, offset: int) -> MissingFirst: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
class MissingFirstT(object):
  def __init__(
    self,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MissingFirstT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MissingFirstT: ...
  @classmethod
  def InitFromObj(cls, missingFirst: MissingFirst) -> MissingFirstT: ...
  def _UnPack(self, missingFirst: MissingFirst) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MissingFirstStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MissingFirstEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
