from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MissingLast(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MissingLast: ...
  @classmethod
  def GetRootAsMissingLast(cls, buf: bytes, offset: int) -> MissingLast: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
class MissingLastT(object):
  def __init__(
    self,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> MissingLastT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> MissingLastT: ...
  @classmethod
  def InitFromObj(cls, missingLast: MissingLast) -> MissingLastT: ...
  def _UnPack(self, missingLast: MissingLast) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def MissingLastStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MissingLastEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
