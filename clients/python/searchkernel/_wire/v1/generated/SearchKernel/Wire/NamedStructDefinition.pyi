from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.StructFieldDefinition import StructFieldDefinition, StructFieldDefinitionT
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class NamedStructDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> NamedStructDefinition: ...
  @classmethod
  def GetRootAsNamedStructDefinition(cls, buf: bytes, offset: int) -> NamedStructDefinition: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def Fields(self, i: int) -> StructFieldDefinition | None: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
class NamedStructDefinitionT(object):
  name: str | None
  fields: typing.List[StructFieldDefinitionT]
  properties: typing.List[ValueEntryT]
  def __init__(
    self,
    name: str | None = ...,
    fields: typing.List['StructFieldDefinitionT'] | None = ...,
    properties: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> NamedStructDefinitionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> NamedStructDefinitionT: ...
  @classmethod
  def InitFromObj(cls, namedStructDefinition: NamedStructDefinition) -> NamedStructDefinitionT: ...
  def _UnPack(self, namedStructDefinition: NamedStructDefinition) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def NamedStructDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def NamedStructDefinitionAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def NamedStructDefinitionAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def NamedStructDefinitionStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def NamedStructDefinitionAddProperties(builder: flatbuffers.Builder, properties: uoffset) -> None: ...
def NamedStructDefinitionStartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def NamedStructDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
