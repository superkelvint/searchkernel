from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.NonFiniteFloatKind import NonFiniteFloatKind

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class NonFiniteFloatValue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> NonFiniteFloatValue: ...
  @classmethod
  def GetRootAsNonFiniteFloatValue(cls, buf: bytes, offset: int) -> NonFiniteFloatValue: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Kind(self) -> typing.Literal[NonFiniteFloatKind.Unspecified, NonFiniteFloatKind.NaN, NonFiniteFloatKind.PositiveInfinity, NonFiniteFloatKind.NegativeInfinity]: ...
class NonFiniteFloatValueT(object):
  kind: typing.Literal[NonFiniteFloatKind.Unspecified, NonFiniteFloatKind.NaN, NonFiniteFloatKind.PositiveInfinity, NonFiniteFloatKind.NegativeInfinity]
  def __init__(
    self,
    kind: typing.Literal[NonFiniteFloatKind.Unspecified, NonFiniteFloatKind.NaN, NonFiniteFloatKind.PositiveInfinity, NonFiniteFloatKind.NegativeInfinity] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> NonFiniteFloatValueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> NonFiniteFloatValueT: ...
  @classmethod
  def InitFromObj(cls, nonFiniteFloatValue: NonFiniteFloatValue) -> NonFiniteFloatValueT: ...
  def _UnPack(self, nonFiniteFloatValue: NonFiniteFloatValue) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def NonFiniteFloatValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def NonFiniteFloatValueAddKind(builder: flatbuffers.Builder, kind: typing.Literal[NonFiniteFloatKind.Unspecified, NonFiniteFloatKind.NaN, NonFiniteFloatKind.PositiveInfinity, NonFiniteFloatKind.NegativeInfinity]) -> None: ...
def NonFiniteFloatValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
