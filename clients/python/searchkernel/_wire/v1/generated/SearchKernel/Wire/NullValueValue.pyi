from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.NullValue import NullValue

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class NullValueValue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> NullValueValue: ...
  @classmethod
  def GetRootAsNullValueValue(cls, buf: bytes, offset: int) -> NullValueValue: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> typing.Literal[NullValue.Unspecified, NullValue.Null]: ...
class NullValueValueT(object):
  value: typing.Literal[NullValue.Unspecified, NullValue.Null]
  def __init__(
    self,
    value: typing.Literal[NullValue.Unspecified, NullValue.Null] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> NullValueValueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> NullValueValueT: ...
  @classmethod
  def InitFromObj(cls, nullValueValue: NullValueValue) -> NullValueValueT: ...
  def _UnPack(self, nullValueValue: NullValueValue) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def NullValueValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def NullValueValueAddValue(builder: flatbuffers.Builder, value: typing.Literal[NullValue.Unspecified, NullValue.Null]) -> None: ...
def NullValueValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
