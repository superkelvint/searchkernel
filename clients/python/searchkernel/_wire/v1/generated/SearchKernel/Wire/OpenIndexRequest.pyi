from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class OpenIndexRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> OpenIndexRequest: ...
  @classmethod
  def GetRootAsOpenIndexRequest(cls, buf: bytes, offset: int) -> OpenIndexRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
class OpenIndexRequestT(object):
  def __init__(
    self,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> OpenIndexRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> OpenIndexRequestT: ...
  @classmethod
  def InitFromObj(cls, openIndexRequest: OpenIndexRequest) -> OpenIndexRequestT: ...
  def _UnPack(self, openIndexRequest: OpenIndexRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def OpenIndexRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def OpenIndexRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
