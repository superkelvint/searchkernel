from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.IndexDefinition import IndexDefinition, IndexDefinitionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class OpenIndexResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> OpenIndexResult: ...
  @classmethod
  def GetRootAsOpenIndexResult(cls, buf: bytes, offset: int) -> OpenIndexResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Index(self) -> IndexDefinition | None: ...
class OpenIndexResultT(object):
  index: IndexDefinitionT | None
  def __init__(
    self,
    index: 'IndexDefinitionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> OpenIndexResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> OpenIndexResultT: ...
  @classmethod
  def InitFromObj(cls, openIndexResult: OpenIndexResult) -> OpenIndexResultT: ...
  def _UnPack(self, openIndexResult: OpenIndexResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def OpenIndexResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def OpenIndexResultAddIndex(builder: flatbuffers.Builder, index: uoffset) -> None: ...
def OpenIndexResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
