from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class OptionalBool(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> bool: ...
class OptionalBoolT(object):
  value: bool
  def __init__(
    self,
    value: bool = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> OptionalBoolT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> OptionalBoolT: ...
  @classmethod
  def InitFromObj(cls, optionalBool: OptionalBool) -> OptionalBoolT: ...
  def _UnPack(self, optionalBool: OptionalBool) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreateOptionalBool(builder: flatbuffers.Builder, value: bool) -> uoffset: ...
