from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class OptionalDouble(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> float: ...
class OptionalDoubleT(object):
  value: float
  def __init__(
    self,
    value: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> OptionalDoubleT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> OptionalDoubleT: ...
  @classmethod
  def InitFromObj(cls, optionalDouble: OptionalDouble) -> OptionalDoubleT: ...
  def _UnPack(self, optionalDouble: OptionalDouble) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreateOptionalDouble(builder: flatbuffers.Builder, value: float) -> uoffset: ...
