from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class OptionalUInt32(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> int: ...
class OptionalUInt32T(object):
  value: int
  def __init__(
    self,
    value: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> OptionalUInt32T: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> OptionalUInt32T: ...
  @classmethod
  def InitFromObj(cls, optionalUint32: OptionalUInt32) -> OptionalUInt32T: ...
  def _UnPack(self, optionalUint32: OptionalUInt32) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreateOptionalUInt32(builder: flatbuffers.Builder, value: int) -> uoffset: ...
