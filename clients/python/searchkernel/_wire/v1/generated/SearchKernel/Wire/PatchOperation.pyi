from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.PatchOperationKind import PatchOperationKind
from SearchKernel.Wire.SetField import SetFieldT
from SearchKernel.Wire.UnsetField import UnsetFieldT
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PatchOperation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PatchOperation: ...
  @classmethod
  def GetRootAsPatchOperation(cls, buf: bytes, offset: int) -> PatchOperation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def OperationType(self) -> typing.Literal[PatchOperationKind.NONE, PatchOperationKind.SetField, PatchOperationKind.UnsetField]: ...
  def Operation(self) -> table.Table | None: ...
class PatchOperationT(object):
  operationType: typing.Literal[PatchOperationKind.NONE, PatchOperationKind.SetField, PatchOperationKind.UnsetField]
  operation: typing.Union[None, SetFieldT, UnsetFieldT]
  def __init__(
    self,
    operationType: typing.Literal[PatchOperationKind.NONE, PatchOperationKind.SetField, PatchOperationKind.UnsetField] = ...,
    operation: typing.Union[None, SetFieldT, UnsetFieldT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PatchOperationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PatchOperationT: ...
  @classmethod
  def InitFromObj(cls, patchOperation: PatchOperation) -> PatchOperationT: ...
  def _UnPack(self, patchOperation: PatchOperation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PatchOperationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PatchOperationAddOperationType(builder: flatbuffers.Builder, operationType: typing.Literal[PatchOperationKind.NONE, PatchOperationKind.SetField, PatchOperationKind.UnsetField]) -> None: ...
def PatchOperationAddOperation(builder: flatbuffers.Builder, operation: uoffset) -> None: ...
def PatchOperationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
