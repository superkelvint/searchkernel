from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.PatchOperation import PatchOperation, PatchOperationT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PatchRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PatchRequest: ...
  @classmethod
  def GetRootAsPatchRequest(cls, buf: bytes, offset: int) -> PatchRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def Operations(self, i: int) -> PatchOperation | None: ...
  def OperationsLength(self) -> int: ...
  def OperationsIsNone(self) -> bool: ...
class PatchRequestT(object):
  id: str | None
  operations: typing.List[PatchOperationT]
  def __init__(
    self,
    id: str | None = ...,
    operations: typing.List['PatchOperationT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PatchRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PatchRequestT: ...
  @classmethod
  def InitFromObj(cls, patchRequest: PatchRequest) -> PatchRequestT: ...
  def _UnPack(self, patchRequest: PatchRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PatchRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PatchRequestAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def PatchRequestAddOperations(builder: flatbuffers.Builder, operations: uoffset) -> None: ...
def PatchRequestStartOperationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOperationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def PatchRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
