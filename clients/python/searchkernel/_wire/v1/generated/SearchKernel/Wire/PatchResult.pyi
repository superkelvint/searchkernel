from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PatchResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PatchResult: ...
  @classmethod
  def GetRootAsPatchResult(cls, buf: bytes, offset: int) -> PatchResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
class PatchResultT(object):
  id: str | None
  def __init__(
    self,
    id: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PatchResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PatchResultT: ...
  @classmethod
  def InitFromObj(cls, patchResult: PatchResult) -> PatchResultT: ...
  def _UnPack(self, patchResult: PatchResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PatchResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PatchResultAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def PatchResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
