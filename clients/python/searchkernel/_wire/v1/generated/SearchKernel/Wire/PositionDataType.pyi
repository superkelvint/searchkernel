from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PositionDataType(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PositionDataType: ...
  @classmethod
  def GetRootAsPositionDataType(cls, buf: bytes, offset: int) -> PositionDataType: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
class PositionDataTypeT(object):
  def __init__(
    self,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PositionDataTypeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PositionDataTypeT: ...
  @classmethod
  def InitFromObj(cls, positionDataType: PositionDataType) -> PositionDataTypeT: ...
  def _UnPack(self, positionDataType: PositionDataType) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PositionDataTypeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PositionDataTypeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
