  def GetRootAs(cls, buf: bytes, offset: int) -> PredicateDataType: ...
  @classmethod
  def GetRootAsPredicateDataType(cls, buf: bytes, offset: int) -> PredicateDataType: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
class PredicateDataTypeT(object):
  def __init__(
    self,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PredicateDataTypeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PredicateDataTypeT: ...
  @classmethod
  def InitFromObj(cls, predicateDataType: PredicateDataType) -> PredicateDataTypeT: ...
  def _UnPack(self, predicateDataType: PredicateDataType) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PredicateDataTypeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PredicateDataTypeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
