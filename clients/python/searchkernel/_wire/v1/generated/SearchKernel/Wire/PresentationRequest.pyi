from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FieldProjection import FieldProjection, FieldProjectionT
from SearchKernel.Wire.HighlightRequest import HighlightRequest, HighlightRequestT
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PresentationRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PresentationRequest: ...
  @classmethod
  def GetRootAsPresentationRequest(cls, buf: bytes, offset: int) -> PresentationRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Summary(self) -> str | None: ...
  def Fields(self) -> FieldProjection | None: ...
  def Highlighting(self) -> HighlightRequest | None: ...
  def Format(self) -> str | None: ...
  def Bolding(self) -> OptionalBool | None: ...
  def Timing(self) -> OptionalBool | None: ...
class PresentationRequestT(object):
  summary: str | None
  fields: FieldProjectionT | None
  highlighting: HighlightRequestT | None
  format: str | None
  bolding: OptionalBoolT | None
  timing: OptionalBoolT | None
  def __init__(
    self,
    summary: str | None = ...,
    fields: 'FieldProjectionT' | None = ...,
    highlighting: 'HighlightRequestT' | None = ...,
    format: str | None = ...,
    bolding: 'OptionalBoolT' | None = ...,
    timing: 'OptionalBoolT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PresentationRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PresentationRequestT: ...
  @classmethod
  def InitFromObj(cls, presentationRequest: PresentationRequest) -> PresentationRequestT: ...
  def _UnPack(self, presentationRequest: PresentationRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PresentationRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PresentationRequestAddSummary(builder: flatbuffers.Builder, summary: uoffset) -> None: ...
def PresentationRequestAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def PresentationRequestAddHighlighting(builder: flatbuffers.Builder, highlighting: uoffset) -> None: ...
def PresentationRequestAddFormat(builder: flatbuffers.Builder, format: uoffset) -> None: ...
def PresentationRequestAddBolding(builder: flatbuffers.Builder, bolding: uoffset) -> None: ...
def PresentationRequestAddTiming(builder: flatbuffers.Builder, timing: uoffset) -> None: ...
def PresentationRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
