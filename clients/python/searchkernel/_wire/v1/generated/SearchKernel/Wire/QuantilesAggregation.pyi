  def GetRootAs(cls, buf: bytes, offset: int) -> QuantilesAggregation: ...
  @classmethod
  def GetRootAsQuantilesAggregation(cls, buf: bytes, offset: int) -> QuantilesAggregation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Quantiles(self, i: int) -> typing.List[float]: ...
  def QuantilesAsNumpy(self) -> np.ndarray: ...
  def QuantilesLength(self) -> int: ...
  def QuantilesIsNone(self) -> bool: ...
  def Expression(self) -> GroupingExpression | None: ...
class QuantilesAggregationT(object):
