from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalDouble import OptionalDouble, OptionalDoubleT
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryAlternative(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryAlternative: ...
  @classmethod
  def GetRootAsQueryAlternative(cls, buf: bytes, offset: int) -> QueryAlternative: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Query(self) -> QueryExpr | None: ...
  def Exactness(self) -> OptionalDouble | None: ...
class QueryAlternativeT(object):
  query: QueryExprT | None
  exactness: OptionalDoubleT | None
  def __init__(
    self,
    query: 'QueryExprT' | None = ...,
    exactness: 'OptionalDoubleT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryAlternativeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryAlternativeT: ...
  @classmethod
  def InitFromObj(cls, queryAlternative: QueryAlternative) -> QueryAlternativeT: ...
  def _UnPack(self, queryAlternative: QueryAlternative) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryAlternativeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryAlternativeAddQuery(builder: flatbuffers.Builder, query: uoffset) -> None: ...
def QueryAlternativeAddExactness(builder: flatbuffers.Builder, exactness: uoffset) -> None: ...
def QueryAlternativeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
