from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryAlternative import QueryAlternative, QueryAlternativeT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryAlternatives(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryAlternatives: ...
  @classmethod
  def GetRootAsQueryAlternatives(cls, buf: bytes, offset: int) -> QueryAlternatives: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Alternatives(self, i: int) -> QueryAlternative | None: ...
  def AlternativesLength(self) -> int: ...
  def AlternativesIsNone(self) -> bool: ...
class QueryAlternativesT(object):
  alternatives: typing.List[QueryAlternativeT]
  def __init__(
    self,
    alternatives: typing.List['QueryAlternativeT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryAlternativesT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryAlternativesT: ...
  @classmethod
  def InitFromObj(cls, queryAlternatives: QueryAlternatives) -> QueryAlternativesT: ...
  def _UnPack(self, queryAlternatives: QueryAlternatives) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryAlternativesStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryAlternativesAddAlternatives(builder: flatbuffers.Builder, alternatives: uoffset) -> None: ...
def QueryAlternativesStartAlternativesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartAlternativesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryAlternativesEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
