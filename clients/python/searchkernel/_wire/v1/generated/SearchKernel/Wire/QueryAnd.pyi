from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryAnd(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryAnd: ...
  @classmethod
  def GetRootAsQueryAnd(cls, buf: bytes, offset: int) -> QueryAnd: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> QueryExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
class QueryAndT(object):
  clauses: typing.List[QueryExprT]
  def __init__(
    self,
    clauses: typing.List['QueryExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryAndT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryAndT: ...
  @classmethod
  def InitFromObj(cls, queryAnd: QueryAnd) -> QueryAndT: ...
  def _UnPack(self, queryAnd: QueryAnd) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryAndStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryAndAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def QueryAndStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryAndEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
