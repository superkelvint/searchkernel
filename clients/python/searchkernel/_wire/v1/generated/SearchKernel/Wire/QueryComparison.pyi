from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ComparisonOp import ComparisonOp
from SearchKernel.Wire.QueryFieldRef import QueryFieldRef, QueryFieldRefT
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryComparison(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryComparison: ...
  @classmethod
  def GetRootAsQueryComparison(cls, buf: bytes, offset: int) -> QueryComparison: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Op(self) -> typing.Literal[ComparisonOp.Unspecified, ComparisonOp.Eq, ComparisonOp.Ne, ComparisonOp.Lt, ComparisonOp.Lte, ComparisonOp.Gt, ComparisonOp.Gte]: ...
  def Value(self) -> Value | None: ...
class QueryComparisonT(object):
  field: QueryFieldRefT | None
  op: typing.Literal[ComparisonOp.Unspecified, ComparisonOp.Eq, ComparisonOp.Ne, ComparisonOp.Lt, ComparisonOp.Lte, ComparisonOp.Gt, ComparisonOp.Gte]
  value: ValueT | None
  def __init__(
    self,
    field: 'QueryFieldRefT' | None = ...,
    op: typing.Literal[ComparisonOp.Unspecified, ComparisonOp.Eq, ComparisonOp.Ne, ComparisonOp.Lt, ComparisonOp.Lte, ComparisonOp.Gt, ComparisonOp.Gte] = ...,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryComparisonT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryComparisonT: ...
  @classmethod
  def InitFromObj(cls, queryComparison: QueryComparison) -> QueryComparisonT: ...
  def _UnPack(self, queryComparison: QueryComparison) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryComparisonStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryComparisonAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryComparisonAddOp(builder: flatbuffers.Builder, op: typing.Literal[ComparisonOp.Unspecified, ComparisonOp.Eq, ComparisonOp.Ne, ComparisonOp.Lt, ComparisonOp.Lte, ComparisonOp.Gt, ComparisonOp.Gte]) -> None: ...
def QueryComparisonAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def QueryComparisonEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
