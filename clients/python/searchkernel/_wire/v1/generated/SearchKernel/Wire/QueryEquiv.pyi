from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryEquiv(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryEquiv: ...
  @classmethod
  def GetRootAsQueryEquiv(cls, buf: bytes, offset: int) -> QueryEquiv: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> QueryExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
class QueryEquivT(object):
  clauses: typing.List[QueryExprT]
  def __init__(
    self,
    clauses: typing.List['QueryExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryEquivT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryEquivT: ...
  @classmethod
  def InitFromObj(cls, queryEquiv: QueryEquiv) -> QueryEquivT: ...
  def _UnPack(self, queryEquiv: QueryEquiv) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryEquivStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryEquivAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def QueryEquivStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryEquivEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
