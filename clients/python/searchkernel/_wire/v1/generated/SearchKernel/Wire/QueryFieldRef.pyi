from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalUInt32 import OptionalUInt32, OptionalUInt32T

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryFieldRef(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryFieldRef: ...
  @classmethod
  def GetRootAsQueryFieldRef(cls, buf: bytes, offset: int) -> QueryFieldRef: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Path(self) -> str | None: ...
  def ElementIndex(self) -> OptionalUInt32 | None: ...
class QueryFieldRefT(object):
  path: str | None
  elementIndex: OptionalUInt32T | None
  def __init__(
    self,
    path: str | None = ...,
    elementIndex: 'OptionalUInt32T' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryFieldRefT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryFieldRefT: ...
  @classmethod
  def InitFromObj(cls, queryFieldRef: QueryFieldRef) -> QueryFieldRefT: ...
  def _UnPack(self, queryFieldRef: QueryFieldRef) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryFieldRefStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryFieldRefAddPath(builder: flatbuffers.Builder, path: uoffset) -> None: ...
def QueryFieldRefAddElementIndex(builder: flatbuffers.Builder, elementIndex: uoffset) -> None: ...
def QueryFieldRefEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
