from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryFuzzy(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryFuzzy: ...
  @classmethod
  def GetRootAsQueryFuzzy(cls, buf: bytes, offset: int) -> QueryFuzzy: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class QueryFuzzyT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryFuzzyT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryFuzzyT: ...
  @classmethod
  def InitFromObj(cls, queryFuzzy: QueryFuzzy) -> QueryFuzzyT: ...
  def _UnPack(self, queryFuzzy: QueryFuzzy) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryFuzzyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryFuzzyAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def QueryFuzzyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
