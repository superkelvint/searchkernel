from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ExpressionQueryInput import ExpressionQueryInputT
from SearchKernel.Wire.LiteralQueryInput import LiteralQueryInputT
from SearchKernel.Wire.QueryInputKind import QueryInputKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryInput(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryInput: ...
  @classmethod
  def GetRootAsQueryInput(cls, buf: bytes, offset: int) -> QueryInput: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def InputType(self) -> typing.Literal[QueryInputKind.NONE, QueryInputKind.LiteralQueryInput, QueryInputKind.ExpressionQueryInput]: ...
  def Input(self) -> table.Table | None: ...
class QueryInputT(object):
  name: str | None
  inputType: typing.Literal[QueryInputKind.NONE, QueryInputKind.LiteralQueryInput, QueryInputKind.ExpressionQueryInput]
  input: typing.Union[None, LiteralQueryInputT, ExpressionQueryInputT]
  def __init__(
    self,
    name: str | None = ...,
    inputType: typing.Literal[QueryInputKind.NONE, QueryInputKind.LiteralQueryInput, QueryInputKind.ExpressionQueryInput] = ...,
    input: typing.Union[None, LiteralQueryInputT, ExpressionQueryInputT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryInputT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryInputT: ...
  @classmethod
  def InitFromObj(cls, queryInput: QueryInput) -> QueryInputT: ...
  def _UnPack(self, queryInput: QueryInput) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryInputStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryInputAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def QueryInputAddInputType(builder: flatbuffers.Builder, inputType: typing.Literal[QueryInputKind.NONE, QueryInputKind.LiteralQueryInput, QueryInputKind.ExpressionQueryInput]) -> None: ...
def QueryInputAddInput(builder: flatbuffers.Builder, input: uoffset) -> None: ...
def QueryInputEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
