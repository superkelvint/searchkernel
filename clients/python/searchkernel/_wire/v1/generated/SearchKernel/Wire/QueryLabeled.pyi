from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryLabeled(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryLabeled: ...
  @classmethod
  def GetRootAsQueryLabeled(cls, buf: bytes, offset: int) -> QueryLabeled: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Query(self) -> QueryExpr | None: ...
  def Label(self) -> str | None: ...
  def Score(self) -> float: ...
class QueryLabeledT(object):
  query: QueryExprT | None
  label: str | None
  score: float
  def __init__(
    self,
    query: 'QueryExprT' | None = ...,
    label: str | None = ...,
    score: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryLabeledT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryLabeledT: ...
  @classmethod
  def InitFromObj(cls, queryLabeled: QueryLabeled) -> QueryLabeledT: ...
  def _UnPack(self, queryLabeled: QueryLabeled) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryLabeledStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryLabeledAddQuery(builder: flatbuffers.Builder, query: uoffset) -> None: ...
def QueryLabeledAddLabel(builder: flatbuffers.Builder, label: uoffset) -> None: ...
def QueryLabeledAddScore(builder: flatbuffers.Builder, score: float) -> None: ...
def QueryLabeledEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
