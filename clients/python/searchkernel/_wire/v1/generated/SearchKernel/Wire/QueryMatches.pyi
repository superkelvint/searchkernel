from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryFieldRef import QueryFieldRef, QueryFieldRefT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryMatches(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryMatches: ...
  @classmethod
  def GetRootAsQueryMatches(cls, buf: bytes, offset: int) -> QueryMatches: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Pattern(self) -> str | None: ...
class QueryMatchesT(object):
  field: QueryFieldRefT | None
  pattern: str | None
  def __init__(
    self,
    field: 'QueryFieldRefT' | None = ...,
    pattern: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryMatchesT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryMatchesT: ...
  @classmethod
  def InitFromObj(cls, queryMatches: QueryMatches) -> QueryMatchesT: ...
  def _UnPack(self, queryMatches: QueryMatches) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryMatchesStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryMatchesAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryMatchesAddPattern(builder: flatbuffers.Builder, pattern: uoffset) -> None: ...
def QueryMatchesEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
