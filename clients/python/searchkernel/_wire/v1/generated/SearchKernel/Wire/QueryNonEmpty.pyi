from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryNonEmpty(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryNonEmpty: ...
  @classmethod
  def GetRootAsQueryNonEmpty(cls, buf: bytes, offset: int) -> QueryNonEmpty: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Query(self) -> QueryExpr | None: ...
class QueryNonEmptyT(object):
  query: QueryExprT | None
  def __init__(
    self,
    query: 'QueryExprT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryNonEmptyT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryNonEmptyT: ...
  @classmethod
  def InitFromObj(cls, queryNonEmpty: QueryNonEmpty) -> QueryNonEmptyT: ...
  def _UnPack(self, queryNonEmpty: QueryNonEmpty) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryNonEmptyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryNonEmptyAddQuery(builder: flatbuffers.Builder, query: uoffset) -> None: ...
def QueryNonEmptyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
