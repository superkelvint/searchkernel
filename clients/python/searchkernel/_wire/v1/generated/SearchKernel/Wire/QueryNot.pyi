from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryNot(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryNot: ...
  @classmethod
  def GetRootAsQueryNot(cls, buf: bytes, offset: int) -> QueryNot: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clause(self) -> QueryExpr | None: ...
class QueryNotT(object):
  clause: QueryExprT | None
  def __init__(
    self,
    clause: 'QueryExprT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryNotT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryNotT: ...
  @classmethod
  def InitFromObj(cls, queryNot: QueryNot) -> QueryNotT: ...
  def _UnPack(self, queryNot: QueryNot) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryNotStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryNotAddClause(builder: flatbuffers.Builder, clause: uoffset) -> None: ...
def QueryNotEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
