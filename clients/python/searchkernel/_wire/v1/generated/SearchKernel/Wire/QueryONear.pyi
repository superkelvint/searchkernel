from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryONear(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryONear: ...
  @classmethod
  def GetRootAsQueryONear(cls, buf: bytes, offset: int) -> QueryONear: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Terms(self, i: int) -> QueryExpr | None: ...
  def TermsLength(self) -> int: ...
  def TermsIsNone(self) -> bool: ...
class QueryONearT(object):
  terms: typing.List[QueryExprT]
  def __init__(
    self,
    terms: typing.List['QueryExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryONearT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryONearT: ...
  @classmethod
  def InitFromObj(cls, queryOnear: QueryONear) -> QueryONearT: ...
  def _UnPack(self, queryOnear: QueryONear) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryONearStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryONearAddTerms(builder: flatbuffers.Builder, terms: uoffset) -> None: ...
def QueryONearStartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryONearEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
