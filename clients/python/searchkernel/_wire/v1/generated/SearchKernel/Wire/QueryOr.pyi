from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryOr(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryOr: ...
  @classmethod
  def GetRootAsQueryOr(cls, buf: bytes, offset: int) -> QueryOr: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> QueryExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
class QueryOrT(object):
  clauses: typing.List[QueryExprT]
  def __init__(
    self,
    clauses: typing.List['QueryExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryOrT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryOrT: ...
  @classmethod
  def InitFromObj(cls, queryOr: QueryOr) -> QueryOrT: ...
  def _UnPack(self, queryOr: QueryOr) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryOrStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryOrAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def QueryOrStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryOrEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
