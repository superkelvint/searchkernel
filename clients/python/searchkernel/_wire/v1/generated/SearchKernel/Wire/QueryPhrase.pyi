from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryPhrase(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryPhrase: ...
  @classmethod
  def GetRootAsQueryPhrase(cls, buf: bytes, offset: int) -> QueryPhrase: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Terms(self, i: int) -> QueryExpr | None: ...
  def TermsLength(self) -> int: ...
  def TermsIsNone(self) -> bool: ...
class QueryPhraseT(object):
  terms: typing.List[QueryExprT]
  def __init__(
    self,
    terms: typing.List['QueryExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryPhraseT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryPhraseT: ...
  @classmethod
  def InitFromObj(cls, queryPhrase: QueryPhrase) -> QueryPhraseT: ...
  def _UnPack(self, queryPhrase: QueryPhrase) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryPhraseStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryPhraseAddTerms(builder: flatbuffers.Builder, terms: uoffset) -> None: ...
def QueryPhraseStartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryPhraseEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
