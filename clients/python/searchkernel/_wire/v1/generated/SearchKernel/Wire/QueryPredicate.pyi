from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryFieldRef import QueryFieldRef, QueryFieldRefT
from SearchKernel.Wire.ValueObject import ValueObject, ValueObjectT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryPredicate(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryPredicate: ...
  @classmethod
  def GetRootAsQueryPredicate(cls, buf: bytes, offset: int) -> QueryPredicate: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Features(self) -> ValueObject | None: ...
  def RangeFeatures(self) -> ValueObject | None: ...
class QueryPredicateT(object):
  field: QueryFieldRefT | None
  features: ValueObjectT | None
  rangeFeatures: ValueObjectT | None
  def __init__(
    self,
    field: 'QueryFieldRefT' | None = ...,
    features: 'ValueObjectT' | None = ...,
    rangeFeatures: 'ValueObjectT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryPredicateT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryPredicateT: ...
  @classmethod
  def InitFromObj(cls, queryPredicate: QueryPredicate) -> QueryPredicateT: ...
  def _UnPack(self, queryPredicate: QueryPredicate) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryPredicateStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryPredicateAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryPredicateAddFeatures(builder: flatbuffers.Builder, features: uoffset) -> None: ...
def QueryPredicateAddRangeFeatures(builder: flatbuffers.Builder, rangeFeatures: uoffset) -> None: ...
def QueryPredicateEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
