from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT
from SearchKernel.Wire.QueryFieldRef import QueryFieldRef, QueryFieldRefT
from SearchKernel.Wire.RangeBound import RangeBound, RangeBoundT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryRange(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryRange: ...
  @classmethod
  def GetRootAsQueryRange(cls, buf: bytes, offset: int) -> QueryRange: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Lower(self) -> RangeBound | None: ...
  def Upper(self) -> RangeBound | None: ...
  def IncludeLower(self) -> OptionalBool | None: ...
  def IncludeUpper(self) -> OptionalBool | None: ...
class QueryRangeT(object):
  field: QueryFieldRefT | None
  lower: RangeBoundT | None
  upper: RangeBoundT | None
  includeLower: OptionalBoolT | None
  includeUpper: OptionalBoolT | None
  def __init__(
    self,
    field: 'QueryFieldRefT' | None = ...,
    lower: 'RangeBoundT' | None = ...,
    upper: 'RangeBoundT' | None = ...,
    includeLower: 'OptionalBoolT' | None = ...,
    includeUpper: 'OptionalBoolT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryRangeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryRangeT: ...
  @classmethod
  def InitFromObj(cls, queryRange: QueryRange) -> QueryRangeT: ...
  def _UnPack(self, queryRange: QueryRange) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryRangeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryRangeAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryRangeAddLower(builder: flatbuffers.Builder, lower: uoffset) -> None: ...
def QueryRangeAddUpper(builder: flatbuffers.Builder, upper: uoffset) -> None: ...
def QueryRangeAddIncludeLower(builder: flatbuffers.Builder, includeLower: uoffset) -> None: ...
def QueryRangeAddIncludeUpper(builder: flatbuffers.Builder, includeUpper: uoffset) -> None: ...
def QueryRangeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
