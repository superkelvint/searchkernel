from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryRank(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryRank: ...
  @classmethod
  def GetRootAsQueryRank(cls, buf: bytes, offset: int) -> QueryRank: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Match(self) -> QueryExpr | None: ...
  def Rank(self, i: int) -> QueryExpr | None: ...
  def RankLength(self) -> int: ...
  def RankIsNone(self) -> bool: ...
class QueryRankT(object):
  match: QueryExprT | None
  rank: typing.List[QueryExprT]
  def __init__(
    self,
    match: 'QueryExprT' | None = ...,
    rank: typing.List['QueryExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryRankT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryRankT: ...
  @classmethod
  def InitFromObj(cls, queryRank: QueryRank) -> QueryRankT: ...
  def _UnPack(self, queryRank: QueryRank) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryRankStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryRankAddMatch(builder: flatbuffers.Builder, match: uoffset) -> None: ...
def QueryRankAddRank(builder: flatbuffers.Builder, rank: uoffset) -> None: ...
def QueryRankStartRankVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartRankVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryRankEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
