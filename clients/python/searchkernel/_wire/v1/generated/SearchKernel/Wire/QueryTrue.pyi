from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryTrue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryTrue: ...
  @classmethod
  def GetRootAsQueryTrue(cls, buf: bytes, offset: int) -> QueryTrue: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
class QueryTrueT(object):
  def __init__(
    self,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryTrueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryTrueT: ...
  @classmethod
  def InitFromObj(cls, queryTrue: QueryTrue) -> QueryTrueT: ...
  def _UnPack(self, queryTrue: QueryTrue) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryTrueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryTrueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
