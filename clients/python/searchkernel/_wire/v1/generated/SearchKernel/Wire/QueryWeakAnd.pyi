from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryExpr import QueryExpr, QueryExprT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryWeakAnd(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryWeakAnd: ...
  @classmethod
  def GetRootAsQueryWeakAnd(cls, buf: bytes, offset: int) -> QueryWeakAnd: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> QueryExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
class QueryWeakAndT(object):
  clauses: typing.List[QueryExprT]
  def __init__(
    self,
    clauses: typing.List['QueryExprT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryWeakAndT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryWeakAndT: ...
  @classmethod
  def InitFromObj(cls, queryWeakAnd: QueryWeakAnd) -> QueryWeakAndT: ...
  def _UnPack(self, queryWeakAnd: QueryWeakAnd) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryWeakAndStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryWeakAndAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def QueryWeakAndStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryWeakAndEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
