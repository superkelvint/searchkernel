from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.QueryFieldRef import QueryFieldRef, QueryFieldRefT
from SearchKernel.Wire.WeightedQueryItem import WeightedQueryItem, WeightedQueryItemT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryWeightedSet(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryWeightedSet: ...
  @classmethod
  def GetRootAsQueryWeightedSet(cls, buf: bytes, offset: int) -> QueryWeightedSet: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Items(self, i: int) -> WeightedQueryItem | None: ...
  def ItemsLength(self) -> int: ...
  def ItemsIsNone(self) -> bool: ...
class QueryWeightedSetT(object):
  field: QueryFieldRefT | None
  items: typing.List[WeightedQueryItemT]
  def __init__(
    self,
    field: 'QueryFieldRefT' | None = ...,
    items: typing.List['WeightedQueryItemT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> QueryWeightedSetT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> QueryWeightedSetT: ...
  @classmethod
  def InitFromObj(cls, queryWeightedSet: QueryWeightedSet) -> QueryWeightedSetT: ...
  def _UnPack(self, queryWeightedSet: QueryWeightedSet) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def QueryWeightedSetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryWeightedSetAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryWeightedSetAddItems(builder: flatbuffers.Builder, items: uoffset) -> None: ...
def QueryWeightedSetStartItemsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartItemsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryWeightedSetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
