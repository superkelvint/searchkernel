from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FiniteRangeBound import FiniteRangeBoundT
from SearchKernel.Wire.NegativeInfinityBound import NegativeInfinityBoundT
from SearchKernel.Wire.PositiveInfinityBound import PositiveInfinityBoundT
from SearchKernel.Wire.RangeBoundKind import RangeBoundKind
from SearchKernel.Wire.UnboundedRangeBound import UnboundedRangeBoundT
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RangeBound(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RangeBound: ...
  @classmethod
  def GetRootAsRangeBound(cls, buf: bytes, offset: int) -> RangeBound: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def BoundType(self) -> typing.Literal[RangeBoundKind.NONE, RangeBoundKind.FiniteRangeBound, RangeBoundKind.NegativeInfinityBound, RangeBoundKind.PositiveInfinityBound, RangeBoundKind.UnboundedRangeBound]: ...
  def Bound(self) -> table.Table | None: ...
class RangeBoundT(object):
  boundType: typing.Literal[RangeBoundKind.NONE, RangeBoundKind.FiniteRangeBound, RangeBoundKind.NegativeInfinityBound, RangeBoundKind.PositiveInfinityBound, RangeBoundKind.UnboundedRangeBound]
  bound: typing.Union[None, FiniteRangeBoundT, NegativeInfinityBoundT, PositiveInfinityBoundT, UnboundedRangeBoundT]
  def __init__(
    self,
    boundType: typing.Literal[RangeBoundKind.NONE, RangeBoundKind.FiniteRangeBound, RangeBoundKind.NegativeInfinityBound, RangeBoundKind.PositiveInfinityBound, RangeBoundKind.UnboundedRangeBound] = ...,
    bound: typing.Union[None, FiniteRangeBoundT, NegativeInfinityBoundT, PositiveInfinityBoundT, UnboundedRangeBoundT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RangeBoundT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RangeBoundT: ...
  @classmethod
  def InitFromObj(cls, rangeBound: RangeBound) -> RangeBoundT: ...
  def _UnPack(self, rangeBound: RangeBound) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def RangeBoundStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RangeBoundAddBoundType(builder: flatbuffers.Builder, boundType: typing.Literal[RangeBoundKind.NONE, RangeBoundKind.FiniteRangeBound, RangeBoundKind.NegativeInfinityBound, RangeBoundKind.PositiveInfinityBound, RangeBoundKind.UnboundedRangeBound]) -> None: ...
def RangeBoundAddBound(builder: flatbuffers.Builder, bound: uoffset) -> None: ...
def RangeBoundEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
