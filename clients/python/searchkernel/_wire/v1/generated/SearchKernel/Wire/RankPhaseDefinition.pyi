  def GetRootAsRankPhaseDefinition(cls, buf: bytes, offset: int) -> RankPhaseDefinition: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> str | None: ...
  def RerankCount(self) -> OptionalUInt32 | None: ...
  def RankScoreDropLimit(self) -> OptionalDouble | None: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
  def TotalRerankCount(self) -> OptionalUInt32 | None: ...
  def KeepRankCount(self) -> OptionalUInt32 | None: ...
  def TotalKeepRankCount(self) -> OptionalUInt32 | None: ...
class RankPhaseDefinitionT(object):
  expression: str | None
  rerankCount: OptionalUInt32T | None
  rankScoreDropLimit: OptionalDoubleT | None
  properties: typing.List[ValueEntryT]
  totalRerankCount: OptionalUInt32T | None
  keepRankCount: OptionalUInt32T | None
  totalKeepRankCount: OptionalUInt32T | None
  def __init__(
    self,
    expression: str | None = ...,
    rerankCount: 'OptionalUInt32T' | None = ...,
    rankScoreDropLimit: 'OptionalDoubleT' | None = ...,
    properties: typing.List['ValueEntryT'] | None = ...,
    totalRerankCount: 'OptionalUInt32T' | None = ...,
    keepRankCount: 'OptionalUInt32T' | None = ...,
    totalKeepRankCount: 'OptionalUInt32T' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RankPhaseDefinitionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RankPhaseDefinitionT: ...
  @classmethod
  def InitFromObj(cls, rankPhaseDefinition: RankPhaseDefinition) -> RankPhaseDefinitionT: ...
  def _UnPack(self, rankPhaseDefinition: RankPhaseDefinition) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
