from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.StringEntry import StringEntry, StringEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RankingRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RankingRequest: ...
  @classmethod
  def GetRootAsRankingRequest(cls, buf: bytes, offset: int) -> RankingRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Profile(self) -> str | None: ...
  def Properties(self, i: int) -> StringEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
class RankingRequestT(object):
  profile: str | None
  properties: typing.List[StringEntryT]
  def __init__(
    self,
    profile: str | None = ...,
    properties: typing.List['StringEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RankingRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RankingRequestT: ...
  @classmethod
  def InitFromObj(cls, rankingRequest: RankingRequest) -> RankingRequestT: ...
  def _UnPack(self, rankingRequest: RankingRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def RankingRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RankingRequestAddProfile(builder: flatbuffers.Builder, profile: uoffset) -> None: ...
def RankingRequestAddProperties(builder: flatbuffers.Builder, properties: uoffset) -> None: ...
def RankingRequestStartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def RankingRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
