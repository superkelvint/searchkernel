from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RawGroupingSource(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RawGroupingSource: ...
  @classmethod
  def GetRootAsRawGroupingSource(cls, buf: bytes, offset: int) -> RawGroupingSource: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> str | None: ...
class RawGroupingSourceT(object):
  expression: str | None
  def __init__(
    self,
    expression: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RawGroupingSourceT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RawGroupingSourceT: ...
  @classmethod
  def InitFromObj(cls, rawGroupingSource: RawGroupingSource) -> RawGroupingSourceT: ...
  def _UnPack(self, rawGroupingSource: RawGroupingSource) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def RawGroupingSourceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RawGroupingSourceAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def RawGroupingSourceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
