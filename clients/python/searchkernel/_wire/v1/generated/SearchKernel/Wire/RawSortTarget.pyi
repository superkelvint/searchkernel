from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RawSortTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RawSortTarget: ...
  @classmethod
  def GetRootAsRawSortTarget(cls, buf: bytes, offset: int) -> RawSortTarget: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> str | None: ...
class RawSortTargetT(object):
  expression: str | None
  def __init__(
    self,
    expression: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RawSortTargetT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RawSortTargetT: ...
  @classmethod
  def InitFromObj(cls, rawSortTarget: RawSortTarget) -> RawSortTargetT: ...
  def _UnPack(self, rawSortTarget: RawSortTarget) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def RawSortTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RawSortTargetAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def RawSortTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
