from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ReferenceDataType(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ReferenceDataType: ...
  @classmethod
  def GetRootAsReferenceDataType(cls, buf: bytes, offset: int) -> ReferenceDataType: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def DocumentType(self) -> str | None: ...
class ReferenceDataTypeT(object):
  documentType: str | None
  def __init__(
    self,
    documentType: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ReferenceDataTypeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ReferenceDataTypeT: ...
  @classmethod
  def InitFromObj(cls, referenceDataType: ReferenceDataType) -> ReferenceDataTypeT: ...
  def _UnPack(self, referenceDataType: ReferenceDataType) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ReferenceDataTypeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ReferenceDataTypeAddDocumentType(builder: flatbuffers.Builder, documentType: uoffset) -> None: ...
def ReferenceDataTypeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
