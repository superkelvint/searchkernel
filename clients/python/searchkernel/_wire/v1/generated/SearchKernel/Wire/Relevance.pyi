from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FiniteRelevance import FiniteRelevanceT
from SearchKernel.Wire.NegativeInfinityRelevance import NegativeInfinityRelevanceT
from SearchKernel.Wire.PositiveInfinityRelevance import PositiveInfinityRelevanceT
from SearchKernel.Wire.RelevanceKind import RelevanceKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Relevance(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Relevance: ...
  @classmethod
  def GetRootAsRelevance(cls, buf: bytes, offset: int) -> Relevance: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ValueType(self) -> typing.Literal[RelevanceKind.NONE, RelevanceKind.FiniteRelevance, RelevanceKind.NegativeInfinityRelevance, RelevanceKind.PositiveInfinityRelevance]: ...
  def Value(self) -> table.Table | None: ...
class RelevanceT(object):
  valueType: typing.Literal[RelevanceKind.NONE, RelevanceKind.FiniteRelevance, RelevanceKind.NegativeInfinityRelevance, RelevanceKind.PositiveInfinityRelevance]
  value: typing.Union[None, FiniteRelevanceT, NegativeInfinityRelevanceT, PositiveInfinityRelevanceT]
  def __init__(
    self,
    valueType: typing.Literal[RelevanceKind.NONE, RelevanceKind.FiniteRelevance, RelevanceKind.NegativeInfinityRelevance, RelevanceKind.PositiveInfinityRelevance] = ...,
    value: typing.Union[None, FiniteRelevanceT, NegativeInfinityRelevanceT, PositiveInfinityRelevanceT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RelevanceT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RelevanceT: ...
  @classmethod
  def InitFromObj(cls, relevance: Relevance) -> RelevanceT: ...
  def _UnPack(self, relevance: Relevance) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def RelevanceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RelevanceAddValueType(builder: flatbuffers.Builder, valueType: typing.Literal[RelevanceKind.NONE, RelevanceKind.FiniteRelevance, RelevanceKind.NegativeInfinityRelevance, RelevanceKind.PositiveInfinityRelevance]) -> None: ...
def RelevanceAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def RelevanceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
