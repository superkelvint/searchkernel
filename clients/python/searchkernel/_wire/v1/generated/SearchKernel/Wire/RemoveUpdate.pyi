from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RemoveUpdate(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RemoveUpdate: ...
  @classmethod
  def GetRootAsRemoveUpdate(cls, buf: bytes, offset: int) -> RemoveUpdate: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
class RemoveUpdateT(object):
  value: ValueT | None
  def __init__(
    self,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RemoveUpdateT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RemoveUpdateT: ...
  @classmethod
  def InitFromObj(cls, removeUpdate: RemoveUpdate) -> RemoveUpdateT: ...
  def _UnPack(self, removeUpdate: RemoveUpdate) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def RemoveUpdateStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RemoveUpdateAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def RemoveUpdateEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
