from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.MissingPolicy import MissingPolicy, MissingPolicyT
from SearchKernel.Wire.ResolvedSortTarget import ResolvedSortTarget, ResolvedSortTargetT
from SearchKernel.Wire.SortDirection import SortDirection
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ResolvedSortExpr(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ResolvedSortExpr: ...
  @classmethod
  def GetRootAsResolvedSortExpr(cls, buf: bytes, offset: int) -> ResolvedSortExpr: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Target(self) -> ResolvedSortTarget | None: ...
  def Direction(self) -> typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc]: ...
  def Missing(self) -> MissingPolicy | None: ...
  def Annotations(self, i: int) -> ValueEntry | None: ...
  def AnnotationsLength(self) -> int: ...
  def AnnotationsIsNone(self) -> bool: ...
class ResolvedSortExprT(object):
  target: ResolvedSortTargetT | None
  direction: typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc]
  missing: MissingPolicyT | None
  annotations: typing.List[ValueEntryT]
  def __init__(
    self,
    target: 'ResolvedSortTargetT' | None = ...,
    direction: typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc] = ...,
    missing: 'MissingPolicyT' | None = ...,
    annotations: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ResolvedSortExprT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ResolvedSortExprT: ...
  @classmethod
  def InitFromObj(cls, resolvedSortExpr: ResolvedSortExpr) -> ResolvedSortExprT: ...
  def _UnPack(self, resolvedSortExpr: ResolvedSortExpr) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ResolvedSortExprStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ResolvedSortExprAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def ResolvedSortExprAddDirection(builder: flatbuffers.Builder, direction: typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc]) -> None: ...
def ResolvedSortExprAddMissing(builder: flatbuffers.Builder, missing: uoffset) -> None: ...
def ResolvedSortExprAddAnnotations(builder: flatbuffers.Builder, annotations: uoffset) -> None: ...
def ResolvedSortExprStartAnnotationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartAnnotationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ResolvedSortExprEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
