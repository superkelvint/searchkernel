from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Hit import HitT
from SearchKernel.Wire.ResultGroup import ResultGroupT
from SearchKernel.Wire.ResultNodeKind import ResultNodeKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ResultNode(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ResultNode: ...
  @classmethod
  def GetRootAsResultNode(cls, buf: bytes, offset: int) -> ResultNode: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def NodeType(self) -> typing.Literal[ResultNodeKind.NONE, ResultNodeKind.Hit, ResultNodeKind.ResultGroup]: ...
  def Node(self) -> table.Table | None: ...
class ResultNodeT(object):
  nodeType: typing.Literal[ResultNodeKind.NONE, ResultNodeKind.Hit, ResultNodeKind.ResultGroup]
  node: typing.Union[None, HitT, ResultGroupT]
  def __init__(
    self,
    nodeType: typing.Literal[ResultNodeKind.NONE, ResultNodeKind.Hit, ResultNodeKind.ResultGroup] = ...,
    node: typing.Union[None, HitT, ResultGroupT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ResultNodeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ResultNodeT: ...
  @classmethod
  def InitFromObj(cls, resultNode: ResultNode) -> ResultNodeT: ...
  def _UnPack(self, resultNode: ResultNode) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ResultNodeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ResultNodeAddNodeType(builder: flatbuffers.Builder, nodeType: typing.Literal[ResultNodeKind.NONE, ResultNodeKind.Hit, ResultNodeKind.ResultGroup]) -> None: ...
def ResultNodeAddNode(builder: flatbuffers.Builder, node: uoffset) -> None: ...
def ResultNodeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
