from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalDouble import OptionalDouble, OptionalDoubleT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchField(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchField: ...
  @classmethod
  def GetRootAsSearchField(cls, buf: bytes, offset: int) -> SearchField: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
  def Weight(self) -> OptionalDouble | None: ...
class SearchFieldT(object):
  field: str | None
  weight: OptionalDoubleT | None
  def __init__(
    self,
    field: str | None = ...,
    weight: 'OptionalDoubleT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SearchFieldT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SearchFieldT: ...
  @classmethod
  def InitFromObj(cls, searchField: SearchField) -> SearchFieldT: ...
  def _UnPack(self, searchField: SearchField) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SearchFieldStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchFieldAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def SearchFieldAddWeight(builder: flatbuffers.Builder, weight: uoffset) -> None: ...
def SearchFieldEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
