from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.SearchField import SearchField, SearchFieldT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchFieldSelection(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchFieldSelection: ...
  @classmethod
  def GetRootAsSearchFieldSelection(cls, buf: bytes, offset: int) -> SearchFieldSelection: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Fields(self, i: int) -> SearchField | None: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
class SearchFieldSelectionT(object):
  fields: typing.List[SearchFieldT]
  def __init__(
    self,
    fields: typing.List['SearchFieldT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SearchFieldSelectionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SearchFieldSelectionT: ...
  @classmethod
  def InitFromObj(cls, searchFieldSelection: SearchFieldSelection) -> SearchFieldSelectionT: ...
  def _UnPack(self, searchFieldSelection: SearchFieldSelection) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SearchFieldSelectionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchFieldSelectionAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def SearchFieldSelectionStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SearchFieldSelectionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
