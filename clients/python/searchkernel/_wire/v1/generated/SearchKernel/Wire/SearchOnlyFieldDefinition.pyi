from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FieldDefinition import FieldDefinition, FieldDefinitionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchOnlyFieldDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchOnlyFieldDefinition: ...
  @classmethod
  def GetRootAsSearchOnlyFieldDefinition(cls, buf: bytes, offset: int) -> SearchOnlyFieldDefinition: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> FieldDefinition | None: ...
class SearchOnlyFieldDefinitionT(object):
  field: FieldDefinitionT | None
  def __init__(
    self,
    field: 'FieldDefinitionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SearchOnlyFieldDefinitionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SearchOnlyFieldDefinitionT: ...
  @classmethod
  def InitFromObj(cls, searchOnlyFieldDefinition: SearchOnlyFieldDefinition) -> SearchOnlyFieldDefinitionT: ...
  def _UnPack(self, searchOnlyFieldDefinition: SearchOnlyFieldDefinition) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SearchOnlyFieldDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchOnlyFieldDefinitionAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def SearchOnlyFieldDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
