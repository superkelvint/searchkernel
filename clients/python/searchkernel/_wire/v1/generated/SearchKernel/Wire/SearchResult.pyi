from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Coverage import Coverage, CoverageT
from SearchKernel.Wire.ResultNode import ResultNode, ResultNodeT
from SearchKernel.Wire.SearchResultError import SearchResultError, SearchResultErrorT
from SearchKernel.Wire.SearchTiming import SearchTiming, SearchTimingT
from SearchKernel.Wire.TotalHits import TotalHits, TotalHitsT
from SearchKernel.Wire.Value import Value, ValueT
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchResult: ...
  @classmethod
  def GetRootAsSearchResult(cls, buf: bytes, offset: int) -> SearchResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Root(self) -> ResultNode | None: ...
  def TotalHits(self) -> TotalHits | None: ...
  def Coverage(self) -> Coverage | None: ...
  def Timing(self) -> SearchTiming | None: ...
  def Errors(self, i: int) -> SearchResultError | None: ...
  def ErrorsLength(self) -> int: ...
  def ErrorsIsNone(self) -> bool: ...
  def Trace(self) -> Value | None: ...
  def Metadata(self, i: int) -> ValueEntry | None: ...
  def MetadataLength(self) -> int: ...
  def MetadataIsNone(self) -> bool: ...
class SearchResultT(object):
  root: ResultNodeT | None
  totalHits: TotalHitsT | None
  coverage: CoverageT | None
  timing: SearchTimingT | None
  errors: typing.List[SearchResultErrorT]
  trace: ValueT | None
  metadata: typing.List[ValueEntryT]
  def __init__(
    self,
    root: 'ResultNodeT' | None = ...,
    totalHits: 'TotalHitsT' | None = ...,
    coverage: 'CoverageT' | None = ...,
    timing: 'SearchTimingT' | None = ...,
    errors: typing.List['SearchResultErrorT'] | None = ...,
    trace: 'ValueT' | None = ...,
    metadata: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SearchResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SearchResultT: ...
  @classmethod
  def InitFromObj(cls, searchResult: SearchResult) -> SearchResultT: ...
  def _UnPack(self, searchResult: SearchResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SearchResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchResultAddRoot(builder: flatbuffers.Builder, root: uoffset) -> None: ...
def SearchResultAddTotalHits(builder: flatbuffers.Builder, totalHits: uoffset) -> None: ...
def SearchResultAddCoverage(builder: flatbuffers.Builder, coverage: uoffset) -> None: ...
def SearchResultAddTiming(builder: flatbuffers.Builder, timing: uoffset) -> None: ...
def SearchResultAddErrors(builder: flatbuffers.Builder, errors: uoffset) -> None: ...
def SearchResultStartErrorsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartErrorsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SearchResultAddTrace(builder: flatbuffers.Builder, trace: uoffset) -> None: ...
def SearchResultAddMetadata(builder: flatbuffers.Builder, metadata: uoffset) -> None: ...
def SearchResultStartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SearchResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
