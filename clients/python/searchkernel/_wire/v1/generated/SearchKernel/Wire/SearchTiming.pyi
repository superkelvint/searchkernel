from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalDouble import OptionalDouble, OptionalDoubleT
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchTiming(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchTiming: ...
  @classmethod
  def GetRootAsSearchTiming(cls, buf: bytes, offset: int) -> SearchTiming: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def QueryTimeSeconds(self) -> OptionalDouble | None: ...
  def SearchTimeSeconds(self) -> OptionalDouble | None: ...
  def SummaryFetchTimeSeconds(self) -> OptionalDouble | None: ...
  def Metadata(self, i: int) -> ValueEntry | None: ...
  def MetadataLength(self) -> int: ...
  def MetadataIsNone(self) -> bool: ...
class SearchTimingT(object):
  queryTimeSeconds: OptionalDoubleT | None
  searchTimeSeconds: OptionalDoubleT | None
  summaryFetchTimeSeconds: OptionalDoubleT | None
  metadata: typing.List[ValueEntryT]
  def __init__(
    self,
    queryTimeSeconds: 'OptionalDoubleT' | None = ...,
    searchTimeSeconds: 'OptionalDoubleT' | None = ...,
    summaryFetchTimeSeconds: 'OptionalDoubleT' | None = ...,
    metadata: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SearchTimingT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SearchTimingT: ...
  @classmethod
  def InitFromObj(cls, searchTiming: SearchTiming) -> SearchTimingT: ...
  def _UnPack(self, searchTiming: SearchTiming) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SearchTimingStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchTimingAddQueryTimeSeconds(builder: flatbuffers.Builder, queryTimeSeconds: uoffset) -> None: ...
def SearchTimingAddSearchTimeSeconds(builder: flatbuffers.Builder, searchTimeSeconds: uoffset) -> None: ...
def SearchTimingAddSummaryFetchTimeSeconds(builder: flatbuffers.Builder, summaryFetchTimeSeconds: uoffset) -> None: ...
def SearchTimingAddMetadata(builder: flatbuffers.Builder, metadata: uoffset) -> None: ...
def SearchTimingStartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SearchTimingEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
