from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SetField(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SetField: ...
  @classmethod
  def GetRootAsSetField(cls, buf: bytes, offset: int) -> SetField: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
  def Value(self) -> Value | None: ...
class SetFieldT(object):
  field: str | None
  value: ValueT | None
  def __init__(
    self,
    field: str | None = ...,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SetFieldT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SetFieldT: ...
  @classmethod
  def InitFromObj(cls, setField: SetField) -> SetFieldT: ...
  def _UnPack(self, setField: SetField) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SetFieldStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SetFieldAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def SetFieldAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def SetFieldEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
