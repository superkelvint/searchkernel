from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.FieldSortTarget import FieldSortTargetT
from SearchKernel.Wire.RankFeatureSortTarget import RankFeatureSortTargetT
from SearchKernel.Wire.RawSortTarget import RawSortTargetT
from SearchKernel.Wire.RelevanceSortTarget import RelevanceSortTargetT
from SearchKernel.Wire.SortTargetKind import SortTargetKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SortTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SortTarget: ...
  @classmethod
  def GetRootAsSortTarget(cls, buf: bytes, offset: int) -> SortTarget: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def TargetType(self) -> typing.Literal[SortTargetKind.NONE, SortTargetKind.FieldSortTarget, SortTargetKind.RelevanceSortTarget, SortTargetKind.RankFeatureSortTarget, SortTargetKind.RawSortTarget]: ...
  def Target(self) -> table.Table | None: ...
class SortTargetT(object):
  targetType: typing.Literal[SortTargetKind.NONE, SortTargetKind.FieldSortTarget, SortTargetKind.RelevanceSortTarget, SortTargetKind.RankFeatureSortTarget, SortTargetKind.RawSortTarget]
  target: typing.Union[None, FieldSortTargetT, RelevanceSortTargetT, RankFeatureSortTargetT, RawSortTargetT]
  def __init__(
    self,
    targetType: typing.Literal[SortTargetKind.NONE, SortTargetKind.FieldSortTarget, SortTargetKind.RelevanceSortTarget, SortTargetKind.RankFeatureSortTarget, SortTargetKind.RawSortTarget] = ...,
    target: typing.Union[None, FieldSortTargetT, RelevanceSortTargetT, RankFeatureSortTargetT, RawSortTargetT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SortTargetT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SortTargetT: ...
  @classmethod
  def InitFromObj(cls, sortTarget: SortTarget) -> SortTargetT: ...
  def _UnPack(self, sortTarget: SortTarget) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SortTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SortTargetAddTargetType(builder: flatbuffers.Builder, targetType: typing.Literal[SortTargetKind.NONE, SortTargetKind.FieldSortTarget, SortTargetKind.RelevanceSortTarget, SortTargetKind.RankFeatureSortTarget, SortTargetKind.RawSortTarget]) -> None: ...
def SortTargetAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def SortTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
