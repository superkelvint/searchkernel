from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class StringEntry(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> StringEntry: ...
  @classmethod
  def GetRootAsStringEntry(cls, buf: bytes, offset: int) -> StringEntry: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Key(self) -> str | None: ...
  def Value(self) -> str | None: ...
class StringEntryT(object):
  key: str | None
  value: str | None
  def __init__(
    self,
    key: str | None = ...,
    value: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> StringEntryT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> StringEntryT: ...
  @classmethod
  def InitFromObj(cls, stringEntry: StringEntry) -> StringEntryT: ...
  def _UnPack(self, stringEntry: StringEntry) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def StringEntryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def StringEntryAddKey(builder: flatbuffers.Builder, key: uoffset) -> None: ...
def StringEntryAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def StringEntryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
