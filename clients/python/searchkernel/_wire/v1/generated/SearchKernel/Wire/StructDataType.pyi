from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.StructFieldDefinition import StructFieldDefinition, StructFieldDefinitionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class StructDataType(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> StructDataType: ...
  @classmethod
  def GetRootAsStructDataType(cls, buf: bytes, offset: int) -> StructDataType: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Fields(self, i: int) -> StructFieldDefinition | None: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
class StructDataTypeT(object):
  fields: typing.List[StructFieldDefinitionT]
  def __init__(
    self,
    fields: typing.List['StructFieldDefinitionT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> StructDataTypeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> StructDataTypeT: ...
  @classmethod
  def InitFromObj(cls, structDataType: StructDataType) -> StructDataTypeT: ...
  def _UnPack(self, structDataType: StructDataType) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def StructDataTypeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def StructDataTypeAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def StructDataTypeStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StructDataTypeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
