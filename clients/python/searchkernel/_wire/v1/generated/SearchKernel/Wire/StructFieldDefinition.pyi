from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.DataType import DataType, DataTypeT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class StructFieldDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> StructFieldDefinition: ...
  @classmethod
  def GetRootAsStructFieldDefinition(cls, buf: bytes, offset: int) -> StructFieldDefinition: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def DataType(self) -> DataType | None: ...
class StructFieldDefinitionT(object):
  name: str | None
  dataType: DataTypeT | None
  def __init__(
    self,
    name: str | None = ...,
    dataType: 'DataTypeT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> StructFieldDefinitionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> StructFieldDefinitionT: ...
  @classmethod
  def InitFromObj(cls, structFieldDefinition: StructFieldDefinition) -> StructFieldDefinitionT: ...
  def _UnPack(self, structFieldDefinition: StructFieldDefinition) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def StructFieldDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def StructFieldDefinitionAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def StructFieldDefinitionAddDataType(builder: flatbuffers.Builder, dataType: uoffset) -> None: ...
def StructFieldDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
