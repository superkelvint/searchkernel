from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingAllOperation import GroupingAllOperation, GroupingAllOperationT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class StructuredGroupingSource(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> StructuredGroupingSource: ...
  @classmethod
  def GetRootAsStructuredGroupingSource(cls, buf: bytes, offset: int) -> StructuredGroupingSource: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Root(self) -> GroupingAllOperation | None: ...
class StructuredGroupingSourceT(object):
  root: GroupingAllOperationT | None
  def __init__(
    self,
    root: 'GroupingAllOperationT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> StructuredGroupingSourceT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> StructuredGroupingSourceT: ...
  @classmethod
  def InitFromObj(cls, structuredGroupingSource: StructuredGroupingSource) -> StructuredGroupingSourceT: ...
  def _UnPack(self, structuredGroupingSource: StructuredGroupingSource) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def StructuredGroupingSourceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def StructuredGroupingSourceAddRoot(builder: flatbuffers.Builder, root: uoffset) -> None: ...
def StructuredGroupingSourceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
