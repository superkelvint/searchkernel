from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SumAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SumAggregation: ...
  @classmethod
  def GetRootAsSumAggregation(cls, buf: bytes, offset: int) -> SumAggregation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
class SumAggregationT(object):
  expression: GroupingExpressionT | None
  def __init__(
    self,
    expression: 'GroupingExpressionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SumAggregationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SumAggregationT: ...
  @classmethod
  def InitFromObj(cls, sumAggregation: SumAggregation) -> SumAggregationT: ...
  def _UnPack(self, sumAggregation: SumAggregation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SumAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SumAggregationAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def SumAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
