from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SummaryAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SummaryAggregation: ...
  @classmethod
  def GetRootAsSummaryAggregation(cls, buf: bytes, offset: int) -> SummaryAggregation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Summary(self) -> str | None: ...
class SummaryAggregationT(object):
  summary: str | None
  def __init__(
    self,
    summary: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SummaryAggregationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SummaryAggregationT: ...
  @classmethod
  def InitFromObj(cls, summaryAggregation: SummaryAggregation) -> SummaryAggregationT: ...
  def _UnPack(self, summaryAggregation: SummaryAggregation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SummaryAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SummaryAggregationAddSummary(builder: flatbuffers.Builder, summary: uoffset) -> None: ...
def SummaryAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
