from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SummaryConfig(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SummaryConfig: ...
  @classmethod
  def GetRootAsSummaryConfig(cls, buf: bytes, offset: int) -> SummaryConfig: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Enabled(self) -> OptionalBool | None: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
class SummaryConfigT(object):
  enabled: OptionalBoolT | None
  options: typing.List[ValueEntryT]
  def __init__(
    self,
    enabled: 'OptionalBoolT' | None = ...,
    options: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SummaryConfigT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SummaryConfigT: ...
  @classmethod
  def InitFromObj(cls, summaryConfig: SummaryConfig) -> SummaryConfigT: ...
  def _UnPack(self, summaryConfig: SummaryConfig) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SummaryConfigStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SummaryConfigAddEnabled(builder: flatbuffers.Builder, enabled: uoffset) -> None: ...
def SummaryConfigAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def SummaryConfigStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SummaryConfigEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
