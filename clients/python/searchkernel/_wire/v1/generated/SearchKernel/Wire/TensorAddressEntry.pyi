from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TensorAddressEntry(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TensorAddressEntry: ...
  @classmethod
  def GetRootAsTensorAddressEntry(cls, buf: bytes, offset: int) -> TensorAddressEntry: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Dimension(self) -> str | None: ...
  def Label(self) -> str | None: ...
class TensorAddressEntryT(object):
  dimension: str | None
  label: str | None
  def __init__(
    self,
    dimension: str | None = ...,
    label: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> TensorAddressEntryT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> TensorAddressEntryT: ...
  @classmethod
  def InitFromObj(cls, tensorAddressEntry: TensorAddressEntry) -> TensorAddressEntryT: ...
  def _UnPack(self, tensorAddressEntry: TensorAddressEntry) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def TensorAddressEntryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TensorAddressEntryAddDimension(builder: flatbuffers.Builder, dimension: uoffset) -> None: ...
def TensorAddressEntryAddLabel(builder: flatbuffers.Builder, label: uoffset) -> None: ...
def TensorAddressEntryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
