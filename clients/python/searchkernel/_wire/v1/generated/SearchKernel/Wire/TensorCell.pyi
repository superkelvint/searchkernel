from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.TensorAddressEntry import TensorAddressEntry, TensorAddressEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TensorCell(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TensorCell: ...
  @classmethod
  def GetRootAsTensorCell(cls, buf: bytes, offset: int) -> TensorCell: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Address(self, i: int) -> TensorAddressEntry | None: ...
  def AddressLength(self) -> int: ...
  def AddressIsNone(self) -> bool: ...
  def Value(self) -> float: ...
class TensorCellT(object):
  address: typing.List[TensorAddressEntryT]
  value: float
  def __init__(
    self,
    address: typing.List['TensorAddressEntryT'] | None = ...,
    value: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> TensorCellT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> TensorCellT: ...
  @classmethod
  def InitFromObj(cls, tensorCell: TensorCell) -> TensorCellT: ...
  def _UnPack(self, tensorCell: TensorCell) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def TensorCellStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TensorCellAddAddress(builder: flatbuffers.Builder, address: uoffset) -> None: ...
def TensorCellStartAddressVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartAddressVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def TensorCellAddValue(builder: flatbuffers.Builder, value: float) -> None: ...
def TensorCellEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
