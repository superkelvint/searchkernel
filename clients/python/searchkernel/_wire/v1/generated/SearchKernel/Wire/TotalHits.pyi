from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.TotalHitsRelation import TotalHitsRelation

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TotalHits(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TotalHits: ...
  @classmethod
  def GetRootAsTotalHits(cls, buf: bytes, offset: int) -> TotalHits: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> int: ...
  def Relation(self) -> typing.Literal[TotalHitsRelation.Unspecified, TotalHitsRelation.Exact, TotalHitsRelation.LowerBound, TotalHitsRelation.Approximate, TotalHitsRelation.Unknown]: ...
class TotalHitsT(object):
  value: int
  relation: typing.Literal[TotalHitsRelation.Unspecified, TotalHitsRelation.Exact, TotalHitsRelation.LowerBound, TotalHitsRelation.Approximate, TotalHitsRelation.Unknown]
  def __init__(
    self,
    value: int = ...,
    relation: typing.Literal[TotalHitsRelation.Unspecified, TotalHitsRelation.Exact, TotalHitsRelation.LowerBound, TotalHitsRelation.Approximate, TotalHitsRelation.Unknown] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> TotalHitsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> TotalHitsT: ...
  @classmethod
  def InitFromObj(cls, totalHits: TotalHits) -> TotalHitsT: ...
  def _UnPack(self, totalHits: TotalHits) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def TotalHitsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TotalHitsAddValue(builder: flatbuffers.Builder, value: int) -> None: ...
def TotalHitsAddRelation(builder: flatbuffers.Builder, relation: typing.Literal[TotalHitsRelation.Unspecified, TotalHitsRelation.Exact, TotalHitsRelation.LowerBound, TotalHitsRelation.Approximate, TotalHitsRelation.Unknown]) -> None: ...
def TotalHitsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
