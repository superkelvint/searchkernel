from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class UInt64Value(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> UInt64Value: ...
  @classmethod
  def GetRootAsUInt64Value(cls, buf: bytes, offset: int) -> UInt64Value: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> int: ...
class UInt64ValueT(object):
  value: int
  def __init__(
    self,
    value: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> UInt64ValueT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> UInt64ValueT: ...
  @classmethod
  def InitFromObj(cls, uint64Value: UInt64Value) -> UInt64ValueT: ...
  def _UnPack(self, uint64Value: UInt64Value) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def UInt64ValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def UInt64ValueAddValue(builder: flatbuffers.Builder, value: int) -> None: ...
def UInt64ValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
