from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class UnboundedRangeBound(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> UnboundedRangeBound: ...
  @classmethod
  def GetRootAsUnboundedRangeBound(cls, buf: bytes, offset: int) -> UnboundedRangeBound: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
class UnboundedRangeBoundT(object):
  def __init__(
    self,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> UnboundedRangeBoundT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> UnboundedRangeBoundT: ...
  @classmethod
  def InitFromObj(cls, unboundedRangeBound: UnboundedRangeBound) -> UnboundedRangeBoundT: ...
  def _UnPack(self, unboundedRangeBound: UnboundedRangeBound) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def UnboundedRangeBoundStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def UnboundedRangeBoundEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
