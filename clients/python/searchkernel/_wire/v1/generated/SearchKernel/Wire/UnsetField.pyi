from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class UnsetField(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> UnsetField: ...
  @classmethod
  def GetRootAsUnsetField(cls, buf: bytes, offset: int) -> UnsetField: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
class UnsetFieldT(object):
  field: str | None
  def __init__(
    self,
    field: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> UnsetFieldT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> UnsetFieldT: ...
  @classmethod
  def InitFromObj(cls, unsetField: UnsetField) -> UnsetFieldT: ...
  def _UnPack(self, unsetField: UnsetField) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def UnsetFieldStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def UnsetFieldAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def UnsetFieldEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
