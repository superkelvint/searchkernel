from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.OptionalBool import OptionalBool, OptionalBoolT
from SearchKernel.Wire.UpdateOperation import UpdateOperation, UpdateOperationT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class UpdateRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> UpdateRequest: ...
  @classmethod
  def GetRootAsUpdateRequest(cls, buf: bytes, offset: int) -> UpdateRequest: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def Operations(self, i: int) -> UpdateOperation | None: ...
  def OperationsLength(self) -> int: ...
  def OperationsIsNone(self) -> bool: ...
  def Condition(self) -> str | None: ...
  def Create(self) -> OptionalBool | None: ...
class UpdateRequestT(object):
  id: str | None
  operations: typing.List[UpdateOperationT]
  condition: str | None
  create: OptionalBoolT | None
  def __init__(
    self,
    id: str | None = ...,
    operations: typing.List['UpdateOperationT'] | None = ...,
    condition: str | None = ...,
    create: 'OptionalBoolT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> UpdateRequestT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> UpdateRequestT: ...
  @classmethod
  def InitFromObj(cls, updateRequest: UpdateRequest) -> UpdateRequestT: ...
  def _UnPack(self, updateRequest: UpdateRequest) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def UpdateRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def UpdateRequestAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def UpdateRequestAddOperations(builder: flatbuffers.Builder, operations: uoffset) -> None: ...
def UpdateRequestStartOperationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOperationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def UpdateRequestAddCondition(builder: flatbuffers.Builder, condition: uoffset) -> None: ...
def UpdateRequestAddCreate(builder: flatbuffers.Builder, create: uoffset) -> None: ...
def UpdateRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
