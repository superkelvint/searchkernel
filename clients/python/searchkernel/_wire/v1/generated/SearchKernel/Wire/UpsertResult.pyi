from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class UpsertResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> UpsertResult: ...
  @classmethod
  def GetRootAsUpsertResult(cls, buf: bytes, offset: int) -> UpsertResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
class UpsertResultT(object):
  id: str | None
  def __init__(
    self,
    id: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> UpsertResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> UpsertResultT: ...
  @classmethod
  def InitFromObj(cls, upsertResult: UpsertResult) -> UpsertResultT: ...
  def _UnPack(self, upsertResult: UpsertResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def UpsertResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def UpsertResultAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def UpsertResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
