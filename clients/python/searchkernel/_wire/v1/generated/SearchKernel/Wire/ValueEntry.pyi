from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ValueEntry(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ValueEntry: ...
  @classmethod
  def GetRootAsValueEntry(cls, buf: bytes, offset: int) -> ValueEntry: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Key(self) -> str | None: ...
  def Value(self) -> Value | None: ...
class ValueEntryT(object):
  key: str | None
  value: ValueT | None
  def __init__(
    self,
    key: str | None = ...,
    value: 'ValueT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ValueEntryT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ValueEntryT: ...
  @classmethod
  def InitFromObj(cls, valueEntry: ValueEntry) -> ValueEntryT: ...
  def _UnPack(self, valueEntry: ValueEntry) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ValueEntryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ValueEntryAddKey(builder: flatbuffers.Builder, key: uoffset) -> None: ...
def ValueEntryAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def ValueEntryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
