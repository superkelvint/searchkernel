from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ValueList(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ValueList: ...
  @classmethod
  def GetRootAsValueList(cls, buf: bytes, offset: int) -> ValueList: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Values(self, i: int) -> Value | None: ...
  def ValuesLength(self) -> int: ...
  def ValuesIsNone(self) -> bool: ...
class ValueListT(object):
  values: typing.List[ValueT]
  def __init__(
    self,
    values: typing.List['ValueT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ValueListT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ValueListT: ...
  @classmethod
  def InitFromObj(cls, valueList: ValueList) -> ValueListT: ...
  def _UnPack(self, valueList: ValueList) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ValueListStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ValueListAddValues(builder: flatbuffers.Builder, values: uoffset) -> None: ...
def ValueListStartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ValueListEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
