from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ValueObject(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ValueObject: ...
  @classmethod
  def GetRootAsValueObject(cls, buf: bytes, offset: int) -> ValueObject: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Fields(self, i: int) -> ValueEntry | None: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
class ValueObjectT(object):
  fields: typing.List[ValueEntryT]
  def __init__(
    self,
    fields: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ValueObjectT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ValueObjectT: ...
  @classmethod
  def InitFromObj(cls, valueObject: ValueObject) -> ValueObjectT: ...
  def _UnPack(self, valueObject: ValueObject) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ValueObjectStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ValueObjectAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def ValueObjectStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ValueObjectEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
