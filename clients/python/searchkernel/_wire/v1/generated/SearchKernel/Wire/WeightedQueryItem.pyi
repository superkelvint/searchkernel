from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.Value import Value, ValueT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class WeightedQueryItem(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> WeightedQueryItem: ...
  @classmethod
  def GetRootAsWeightedQueryItem(cls, buf: bytes, offset: int) -> WeightedQueryItem: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Key(self) -> Value | None: ...
  def Weight(self) -> int: ...
class WeightedQueryItemT(object):
  key: ValueT | None
  weight: int
  def __init__(
    self,
    key: 'ValueT' | None = ...,
    weight: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> WeightedQueryItemT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> WeightedQueryItemT: ...
  @classmethod
  def InitFromObj(cls, weightedQueryItem: WeightedQueryItem) -> WeightedQueryItemT: ...
  def _UnPack(self, weightedQueryItem: WeightedQueryItem) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def WeightedQueryItemStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def WeightedQueryItemAddKey(builder: flatbuffers.Builder, key: uoffset) -> None: ...
def WeightedQueryItemAddWeight(builder: flatbuffers.Builder, weight: int) -> None: ...
def WeightedQueryItemEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
