from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.GroupingExpression import GroupingExpression, GroupingExpressionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class XorAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> XorAggregation: ...
  @classmethod
  def GetRootAsXorAggregation(cls, buf: bytes, offset: int) -> XorAggregation: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
class XorAggregationT(object):
  expression: GroupingExpressionT | None
  def __init__(
    self,
    expression: 'GroupingExpressionT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> XorAggregationT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> XorAggregationT: ...
  @classmethod
  def InitFromObj(cls, xorAggregation: XorAggregation) -> XorAggregationT: ...
  def _UnPack(self, xorAggregation: XorAggregation) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def XorAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def XorAggregationAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def XorAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
