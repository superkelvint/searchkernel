from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.Wire.ValueEntry import ValueEntry, ValueEntryT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class YqlQuery(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> YqlQuery: ...
  @classmethod
  def GetRootAsYqlQuery(cls, buf: bytes, offset: int) -> YqlQuery: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Source(self) -> str | None: ...
  def Parameters(self, i: int) -> ValueEntry | None: ...
  def ParametersLength(self) -> int: ...
  def ParametersIsNone(self) -> bool: ...
class YqlQueryT(object):
  source: str | None
  parameters: typing.List[ValueEntryT]
  def __init__(
    self,
    source: str | None = ...,
    parameters: typing.List['ValueEntryT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> YqlQueryT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> YqlQueryT: ...
  @classmethod
  def InitFromObj(cls, yqlQuery: YqlQuery) -> YqlQueryT: ...
  def _UnPack(self, yqlQuery: YqlQuery) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def YqlQueryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def YqlQueryAddSource(builder: flatbuffers.Builder, source: uoffset) -> None: ...
def YqlQueryAddParameters(builder: flatbuffers.Builder, parameters: uoffset) -> None: ...
def YqlQueryStartParametersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartParametersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def YqlQueryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...
