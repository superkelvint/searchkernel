from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AnalyzeFieldTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AnalyzeFieldTarget: ...
  @classmethod
  def GetRootAsAnalyzeFieldTarget(cls, buf: bytes, offset: int) -> AnalyzeFieldTarget: ...
  @classmethod
  def AnalyzeFieldTargetBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
def AnalyzeFieldTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AnalyzeFieldTargetAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def AnalyzeFieldTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

