from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.AnalyzedToken import AnalyzedToken

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AnalyzeResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AnalyzeResult: ...
  @classmethod
  def GetRootAsAnalyzeResult(cls, buf: bytes, offset: int) -> AnalyzeResult: ...
  @classmethod
  def AnalyzeResultBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Tokens(self, i: int) -> AnalyzedToken | None: ...
  def TokensLength(self) -> int: ...
  def TokensIsNone(self) -> bool: ...
def AnalyzeResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AnalyzeResultAddTokens(builder: flatbuffers.Builder, tokens: uoffset) -> None: ...
def AnalyzeResultStartTokensVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartTokensVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def AnalyzeResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

