from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.DataType import DataType

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ArrayDataType(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ArrayDataType: ...
  @classmethod
  def GetRootAsArrayDataType(cls, buf: bytes, offset: int) -> ArrayDataType: ...
  @classmethod
  def ArrayDataTypeBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ElementType(self) -> DataType | None: ...
def ArrayDataTypeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ArrayDataTypeAddElementType(builder: flatbuffers.Builder, elementType: uoffset) -> None: ...
def ArrayDataTypeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

