from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.DistanceMetric import DistanceMetric
from SearchKernel.V2.OptionalBool import OptionalBool
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class AttributeConfig(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> AttributeConfig: ...
  @classmethod
  def GetRootAsAttributeConfig(cls, buf: bytes, offset: int) -> AttributeConfig: ...
  @classmethod
  def AttributeConfigBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Enabled(self) -> OptionalBool | None: ...
  def FastSearch(self) -> OptionalBool | None: ...
  def FastAccess(self) -> OptionalBool | None: ...
  def DistanceMetric(self) -> typing.Literal[DistanceMetric.Unspecified, DistanceMetric.Euclidean, DistanceMetric.Angular, DistanceMetric.DotProduct, DistanceMetric.PrenormalizedAngular, DistanceMetric.GeoDegrees, DistanceMetric.Hamming]: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
def AttributeConfigStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AttributeConfigAddEnabled(builder: flatbuffers.Builder, enabled: uoffset) -> None: ...
def AttributeConfigAddFastSearch(builder: flatbuffers.Builder, fastSearch: uoffset) -> None: ...
def AttributeConfigAddFastAccess(builder: flatbuffers.Builder, fastAccess: uoffset) -> None: ...
def AttributeConfigAddDistanceMetric(builder: flatbuffers.Builder, distanceMetric: typing.Literal[DistanceMetric.Unspecified, DistanceMetric.Euclidean, DistanceMetric.Angular, DistanceMetric.DotProduct, DistanceMetric.PrenormalizedAngular, DistanceMetric.GeoDegrees, DistanceMetric.Hamming]) -> None: ...
def AttributeConfigAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def AttributeConfigStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def AttributeConfigEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

