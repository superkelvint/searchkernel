from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class BoolValue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> BoolValue: ...
  @classmethod
  def GetRootAsBoolValue(cls, buf: bytes, offset: int) -> BoolValue: ...
  @classmethod
  def BoolValueBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> bool: ...
def BoolValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def BoolValueAddValue(builder: flatbuffers.Builder, value: bool) -> None: ...
def BoolValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

