  def CoverageDegradedBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def MatchPhase(self) -> OptionalBool | None: ...
