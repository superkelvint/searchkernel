from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.IndexDefinition import IndexDefinition, IndexDefinitionT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class CreateIndexResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> CreateIndexResult: ...
  @classmethod
  def GetRootAsCreateIndexResult(cls, buf: bytes, offset: int) -> CreateIndexResult: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Index(self) -> IndexDefinition | None: ...
  def Generation(self) -> str | None: ...
class CreateIndexResultT(object):
  index: IndexDefinitionT | None
  generation: str | None
  def __init__(
    self,
    index: 'IndexDefinitionT' | None = ...,
    generation: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> CreateIndexResultT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> CreateIndexResultT: ...
  @classmethod
  def InitFromObj(cls, createIndexResult: CreateIndexResult) -> CreateIndexResultT: ...
  def _UnPack(self, createIndexResult: CreateIndexResult) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def CreateIndexResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def CreateIndexResultAddIndex(builder: flatbuffers.Builder, index: uoffset) -> None: ...
def CreateIndexResultAddGeneration(builder: flatbuffers.Builder, generation: uoffset) -> None: ...
def CreateIndexResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

