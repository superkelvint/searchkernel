from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DeleteResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DeleteResult: ...
  @classmethod
  def GetRootAsDeleteResult(cls, buf: bytes, offset: int) -> DeleteResult: ...
  @classmethod
  def DeleteResultBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def Deleted(self) -> bool: ...
def DeleteResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DeleteResultAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def DeleteResultAddDeleted(builder: flatbuffers.Builder, deleted: bool) -> None: ...
def DeleteResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

