from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DenseTensorValues(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DenseTensorValues: ...
  @classmethod
  def GetRootAsDenseTensorValues(cls, buf: bytes, offset: int) -> DenseTensorValues: ...
  @classmethod
  def DenseTensorValuesBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Values(self, i: int) -> typing.List[float]: ...
  def ValuesAsNumpy(self) -> np.ndarray: ...
  def ValuesLength(self) -> int: ...
  def ValuesIsNone(self) -> bool: ...
def DenseTensorValuesStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DenseTensorValuesAddValues(builder: flatbuffers.Builder, values: uoffset) -> None: ...
def DenseTensorValuesStartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def DenseTensorValuesEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

