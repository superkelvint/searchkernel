from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.Analyzer import Analyzer
from SearchKernel.V2.AttributeConfig import AttributeConfig
from SearchKernel.V2.DataType import DataType
from SearchKernel.V2.IndexConfig import IndexConfig
from SearchKernel.V2.MatchingConfig import MatchingConfig
from SearchKernel.V2.OptionalBool import OptionalBool
from SearchKernel.V2.StructFieldConfig import StructFieldConfig
from SearchKernel.V2.SummaryConfig import SummaryConfig
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FieldDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FieldDefinition: ...
  @classmethod
  def GetRootAsFieldDefinition(cls, buf: bytes, offset: int) -> FieldDefinition: ...
  @classmethod
  def FieldDefinitionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def DataType(self) -> DataType | None: ...
  def Stored(self) -> OptionalBool | None: ...
  def Searchable(self) -> OptionalBool | None: ...
  def Filterable(self) -> OptionalBool | None: ...
  def Sortable(self) -> OptionalBool | None: ...
  def Facetable(self) -> OptionalBool | None: ...
  def Analyzer(self) -> Analyzer | None: ...
  def Matching(self) -> MatchingConfig | None: ...
  def Index(self) -> IndexConfig | None: ...
  def Attribute(self) -> AttributeConfig | None: ...
  def Summary(self) -> SummaryConfig | None: ...
  def IndexingScript(self) -> str | None: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
  def StructFields(self, i: int) -> StructFieldConfig | None: ...
  def StructFieldsLength(self) -> int: ...
  def StructFieldsIsNone(self) -> bool: ...
def FieldDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FieldDefinitionAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def FieldDefinitionAddDataType(builder: flatbuffers.Builder, dataType: uoffset) -> None: ...
def FieldDefinitionAddStored(builder: flatbuffers.Builder, stored: uoffset) -> None: ...
def FieldDefinitionAddSearchable(builder: flatbuffers.Builder, searchable: uoffset) -> None: ...
def FieldDefinitionAddFilterable(builder: flatbuffers.Builder, filterable: uoffset) -> None: ...
def FieldDefinitionAddSortable(builder: flatbuffers.Builder, sortable: uoffset) -> None: ...
def FieldDefinitionAddFacetable(builder: flatbuffers.Builder, facetable: uoffset) -> None: ...
def FieldDefinitionAddAnalyzer(builder: flatbuffers.Builder, analyzer: uoffset) -> None: ...
def FieldDefinitionAddMatching(builder: flatbuffers.Builder, matching: uoffset) -> None: ...
def FieldDefinitionAddIndex(builder: flatbuffers.Builder, index: uoffset) -> None: ...
def FieldDefinitionAddAttribute(builder: flatbuffers.Builder, attribute: uoffset) -> None: ...
def FieldDefinitionAddSummary(builder: flatbuffers.Builder, summary: uoffset) -> None: ...
def FieldDefinitionAddIndexingScript(builder: flatbuffers.Builder, indexingScript: uoffset) -> None: ...
def FieldDefinitionAddProperties(builder: flatbuffers.Builder, properties: uoffset) -> None: ...
def FieldDefinitionStartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FieldDefinitionAddStructFields(builder: flatbuffers.Builder, structFields: uoffset) -> None: ...
def FieldDefinitionStartStructFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartStructFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FieldDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

