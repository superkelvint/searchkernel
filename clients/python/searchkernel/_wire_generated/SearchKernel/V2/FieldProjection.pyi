from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FieldProjection(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FieldProjection: ...
  @classmethod
  def GetRootAsFieldProjection(cls, buf: bytes, offset: int) -> FieldProjection: ...
  @classmethod
  def FieldProjectionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Fields(self, i: int) -> str: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
def FieldProjectionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FieldProjectionAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def FieldProjectionStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FieldProjectionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

