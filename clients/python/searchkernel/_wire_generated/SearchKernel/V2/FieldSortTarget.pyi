from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FieldSortTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FieldSortTarget: ...
  @classmethod
  def GetRootAsFieldSortTarget(cls, buf: bytes, offset: int) -> FieldSortTarget: ...
  @classmethod
  def FieldSortTargetBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
def FieldSortTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FieldSortTargetAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def FieldSortTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

