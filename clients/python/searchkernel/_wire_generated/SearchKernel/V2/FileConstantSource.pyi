from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FileConstantSource(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FileConstantSource: ...
  @classmethod
  def GetRootAsFileConstantSource(cls, buf: bytes, offset: int) -> FileConstantSource: ...
  @classmethod
  def FileConstantSourceBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Path(self) -> str | None: ...
def FileConstantSourceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FileConstantSourceAddPath(builder: flatbuffers.Builder, path: uoffset) -> None: ...
def FileConstantSourceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

