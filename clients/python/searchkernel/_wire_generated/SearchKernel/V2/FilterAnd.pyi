from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.FilterExpr import FilterExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterAnd(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterAnd: ...
  @classmethod
  def GetRootAsFilterAnd(cls, buf: bytes, offset: int) -> FilterAnd: ...
  @classmethod
  def FilterAndBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> FilterExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
def FilterAndStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterAndAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def FilterAndStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterAndEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

