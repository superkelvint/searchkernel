from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.ComparisonOp import ComparisonOp
from SearchKernel.V2.QueryFieldRef import QueryFieldRef
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterComparison(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterComparison: ...
  @classmethod
  def GetRootAsFilterComparison(cls, buf: bytes, offset: int) -> FilterComparison: ...
  @classmethod
  def FilterComparisonBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Op(self) -> typing.Literal[ComparisonOp.Unspecified, ComparisonOp.Eq, ComparisonOp.Ne, ComparisonOp.Lt, ComparisonOp.Lte, ComparisonOp.Gt, ComparisonOp.Gte]: ...
  def Value(self) -> Value | None: ...
def FilterComparisonStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterComparisonAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def FilterComparisonAddOp(builder: flatbuffers.Builder, op: typing.Literal[ComparisonOp.Unspecified, ComparisonOp.Eq, ComparisonOp.Ne, ComparisonOp.Lt, ComparisonOp.Lte, ComparisonOp.Gt, ComparisonOp.Gte]) -> None: ...
def FilterComparisonAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def FilterComparisonEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

