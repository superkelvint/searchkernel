class FilterExpr(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterExpr: ...
  @classmethod
  def GetRootAsFilterExpr(cls, buf: bytes, offset: int) -> FilterExpr: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ExprType(self) -> typing.Literal[FilterExprKind.NONE, FilterExprKind.FilterAnd, FilterExprKind.FilterOr, FilterExprKind.FilterNot, FilterExprKind.FilterComparison, FilterExprKind.FilterRange, FilterExprKind.FilterExists, FilterExprKind.FilterIn]: ...
  def Expr(self) -> table.Table | None: ...
class FilterExprT(object):
  exprType: typing.Literal[FilterExprKind.NONE, FilterExprKind.FilterAnd, FilterExprKind.FilterOr, FilterExprKind.FilterNot, FilterExprKind.FilterComparison, FilterExprKind.FilterRange, FilterExprKind.FilterExists, FilterExprKind.FilterIn]
  expr: typing.Union[None, FilterAndT, FilterOrT, FilterNotT, FilterComparisonT, FilterRangeT, FilterExistsT, FilterInT]
  def __init__(
    self,
    exprType: typing.Literal[FilterExprKind.NONE, FilterExprKind.FilterAnd, FilterExprKind.FilterOr, FilterExprKind.FilterNot, FilterExprKind.FilterComparison, FilterExprKind.FilterRange, FilterExprKind.FilterExists, FilterExprKind.FilterIn] = ...,
    expr: typing.Union[None, FilterAndT, FilterOrT, FilterNotT, FilterComparisonT, FilterRangeT, FilterExistsT, FilterInT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FilterExprT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FilterExprT: ...
  @classmethod
  def InitFromObj(cls, filterExpr: FilterExpr) -> FilterExprT: ...
  def _UnPack(self, filterExpr: FilterExpr) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FilterExprStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterExprAddExprType(builder: flatbuffers.Builder, exprType: typing.Literal[FilterExprKind.NONE, FilterExprKind.FilterAnd, FilterExprKind.FilterOr, FilterExprKind.FilterNot, FilterExprKind.FilterComparison, FilterExprKind.FilterRange, FilterExprKind.FilterExists, FilterExprKind.FilterIn]) -> None: ...
def FilterExprAddExpr(builder: flatbuffers.Builder, expr: uoffset) -> None: ...
def FilterExprEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

