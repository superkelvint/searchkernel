from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryFieldRef import QueryFieldRef
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterIn(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterIn: ...
  @classmethod
  def GetRootAsFilterIn(cls, buf: bytes, offset: int) -> FilterIn: ...
  @classmethod
  def FilterInBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Values(self, i: int) -> Value | None: ...
  def ValuesLength(self) -> int: ...
  def ValuesIsNone(self) -> bool: ...
def FilterInStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterInAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def FilterInAddValues(builder: flatbuffers.Builder, values: uoffset) -> None: ...
def FilterInStartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterInEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

