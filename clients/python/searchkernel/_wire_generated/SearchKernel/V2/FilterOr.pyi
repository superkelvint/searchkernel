from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.FilterExpr import FilterExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterOr(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterOr: ...
  @classmethod
  def GetRootAsFilterOr(cls, buf: bytes, offset: int) -> FilterOr: ...
  @classmethod
  def FilterOrBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> FilterExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
def FilterOrStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterOrAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def FilterOrStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterOrEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

