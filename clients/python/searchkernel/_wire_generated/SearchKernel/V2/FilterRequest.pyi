from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.FilterExpr import FilterExpr
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FilterRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FilterRequest: ...
  @classmethod
  def GetRootAsFilterRequest(cls, buf: bytes, offset: int) -> FilterRequest: ...
  @classmethod
  def FilterRequestBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Structured(self, i: int) -> FilterExpr | None: ...
  def StructuredLength(self) -> int: ...
  def StructuredIsNone(self) -> bool: ...
  def Sources(self, i: int) -> str: ...
  def SourcesLength(self) -> int: ...
  def SourcesIsNone(self) -> bool: ...
  def Parameters(self, i: int) -> ValueEntry | None: ...
  def ParametersLength(self) -> int: ...
  def ParametersIsNone(self) -> bool: ...
def FilterRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FilterRequestAddStructured(builder: flatbuffers.Builder, structured: uoffset) -> None: ...
def FilterRequestStartStructuredVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartStructuredVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterRequestAddSources(builder: flatbuffers.Builder, sources: uoffset) -> None: ...
def FilterRequestStartSourcesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartSourcesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterRequestAddParameters(builder: flatbuffers.Builder, parameters: uoffset) -> None: ...
def FilterRequestStartParametersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartParametersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FilterRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

