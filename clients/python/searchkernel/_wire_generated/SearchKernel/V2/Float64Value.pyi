from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Float64Value(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Float64Value: ...
  @classmethod
  def GetRootAsFloat64Value(cls, buf: bytes, offset: int) -> Float64Value: ...
  @classmethod
  def Float64ValueBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> float: ...
def Float64ValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def Float64ValueAddValue(builder: flatbuffers.Builder, value: float) -> None: ...
def Float64ValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

