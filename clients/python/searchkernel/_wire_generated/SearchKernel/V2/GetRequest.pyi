from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.FieldProjection import FieldProjection

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GetRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GetRequest: ...
  @classmethod
  def GetRootAsGetRequest(cls, buf: bytes, offset: int) -> GetRequest: ...
  @classmethod
  def GetRequestBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
  def Projection(self) -> FieldProjection | None: ...
def GetRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GetRequestAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def GetRequestAddProjection(builder: flatbuffers.Builder, projection: uoffset) -> None: ...
def GetRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

