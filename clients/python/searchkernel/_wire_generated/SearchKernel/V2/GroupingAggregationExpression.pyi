from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.AggregationKind import AggregationKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingAggregationExpression(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingAggregationExpression: ...
  @classmethod
  def GetRootAsGroupingAggregationExpression(cls, buf: bytes, offset: int) -> GroupingAggregationExpression: ...
  @classmethod
  def GroupingAggregationExpressionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def AggregationType(self) -> typing.Literal[AggregationKind.NONE, AggregationKind.CountAggregation, AggregationKind.SumAggregation, AggregationKind.AvgAggregation, AggregationKind.MinAggregation, AggregationKind.MaxAggregation, AggregationKind.XorAggregation, AggregationKind.StdDevAggregation, AggregationKind.QuantilesAggregation, AggregationKind.SummaryAggregation]: ...
  def Aggregation(self) -> table.Table | None: ...
def GroupingAggregationExpressionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingAggregationExpressionAddAggregationType(builder: flatbuffers.Builder, aggregationType: typing.Literal[AggregationKind.NONE, AggregationKind.CountAggregation, AggregationKind.SumAggregation, AggregationKind.AvgAggregation, AggregationKind.MinAggregation, AggregationKind.MaxAggregation, AggregationKind.XorAggregation, AggregationKind.StdDevAggregation, AggregationKind.QuantilesAggregation, AggregationKind.SummaryAggregation]) -> None: ...
def GroupingAggregationExpressionAddAggregation(builder: flatbuffers.Builder, aggregation: uoffset) -> None: ...
def GroupingAggregationExpressionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

