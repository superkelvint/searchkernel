  def GetRootAsGroupingAttributeExpression(cls, buf: bytes, offset: int) -> GroupingAttributeExpression: ...
  @classmethod
  def GroupingAttributeExpressionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
def GroupingAttributeExpressionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingAttributeExpressionAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def GroupingAttributeExpressionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

