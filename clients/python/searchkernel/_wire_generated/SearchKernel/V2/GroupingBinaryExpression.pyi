from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.GroupingBinaryOperator import GroupingBinaryOperator
from SearchKernel.V2.GroupingExpression import GroupingExpression

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingBinaryExpression(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingBinaryExpression: ...
  @classmethod
  def GetRootAsGroupingBinaryExpression(cls, buf: bytes, offset: int) -> GroupingBinaryExpression: ...
  @classmethod
  def GroupingBinaryExpressionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Op(self) -> typing.Literal[GroupingBinaryOperator.Unspecified, GroupingBinaryOperator.Add, GroupingBinaryOperator.Subtract, GroupingBinaryOperator.Multiply, GroupingBinaryOperator.Divide, GroupingBinaryOperator.Modulo]: ...
  def Left(self) -> GroupingExpression | None: ...
  def Right(self) -> GroupingExpression | None: ...
def GroupingBinaryExpressionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingBinaryExpressionAddOp(builder: flatbuffers.Builder, op: typing.Literal[GroupingBinaryOperator.Unspecified, GroupingBinaryOperator.Add, GroupingBinaryOperator.Subtract, GroupingBinaryOperator.Multiply, GroupingBinaryOperator.Divide, GroupingBinaryOperator.Modulo]) -> None: ...
def GroupingBinaryExpressionAddLeft(builder: flatbuffers.Builder, left: uoffset) -> None: ...
def GroupingBinaryExpressionAddRight(builder: flatbuffers.Builder, right: uoffset) -> None: ...
def GroupingBinaryExpressionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

