from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.GroupingFilterExpr import GroupingFilterExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingFilterAnd(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingFilterAnd: ...
  @classmethod
  def GetRootAsGroupingFilterAnd(cls, buf: bytes, offset: int) -> GroupingFilterAnd: ...
  @classmethod
  def GroupingFilterAndBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> GroupingFilterExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
def GroupingFilterAndStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingFilterAndAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def GroupingFilterAndStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GroupingFilterAndEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

