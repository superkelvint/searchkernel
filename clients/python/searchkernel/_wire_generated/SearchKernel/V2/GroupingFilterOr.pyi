from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.GroupingFilterExpr import GroupingFilterExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingFilterOr(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingFilterOr: ...
  @classmethod
  def GetRootAsGroupingFilterOr(cls, buf: bytes, offset: int) -> GroupingFilterOr: ...
  @classmethod
  def GroupingFilterOrBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clauses(self, i: int) -> GroupingFilterExpr | None: ...
  def ClausesLength(self) -> int: ...
  def ClausesIsNone(self) -> bool: ...
def GroupingFilterOrStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingFilterOrAddClauses(builder: flatbuffers.Builder, clauses: uoffset) -> None: ...
def GroupingFilterOrStartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartClausesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GroupingFilterOrEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

