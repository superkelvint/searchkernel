from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.GroupingExpression import GroupingExpression
from SearchKernel.V2.OptionalBool import OptionalBool

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingFilterRange(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingFilterRange: ...
  @classmethod
  def GetRootAsGroupingFilterRange(cls, buf: bytes, offset: int) -> GroupingFilterRange: ...
  @classmethod
  def GroupingFilterRangeBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> GroupingExpression | None: ...
  def Lower(self) -> GroupingExpression | None: ...
  def Upper(self) -> GroupingExpression | None: ...
  def IncludeLower(self) -> OptionalBool | None: ...
  def IncludeUpper(self) -> OptionalBool | None: ...
def GroupingFilterRangeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingFilterRangeAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def GroupingFilterRangeAddLower(builder: flatbuffers.Builder, lower: uoffset) -> None: ...
def GroupingFilterRangeAddUpper(builder: flatbuffers.Builder, upper: uoffset) -> None: ...
def GroupingFilterRangeAddIncludeLower(builder: flatbuffers.Builder, includeLower: uoffset) -> None: ...
def GroupingFilterRangeAddIncludeUpper(builder: flatbuffers.Builder, includeUpper: uoffset) -> None: ...
def GroupingFilterRangeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

