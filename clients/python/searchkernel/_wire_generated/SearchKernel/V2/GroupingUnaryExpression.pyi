from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.GroupingExpression import GroupingExpression
from SearchKernel.V2.GroupingUnaryOperator import GroupingUnaryOperator

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GroupingUnaryExpression(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GroupingUnaryExpression: ...
  @classmethod
  def GetRootAsGroupingUnaryExpression(cls, buf: bytes, offset: int) -> GroupingUnaryExpression: ...
  @classmethod
  def GroupingUnaryExpressionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Op(self) -> typing.Literal[GroupingUnaryOperator.Unspecified, GroupingUnaryOperator.Positive, GroupingUnaryOperator.Negative]: ...
  def Expression(self) -> GroupingExpression | None: ...
def GroupingUnaryExpressionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GroupingUnaryExpressionAddOp(builder: flatbuffers.Builder, op: typing.Literal[GroupingUnaryOperator.Unspecified, GroupingUnaryOperator.Positive, GroupingUnaryOperator.Negative]) -> None: ...
def GroupingUnaryExpressionAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def GroupingUnaryExpressionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

