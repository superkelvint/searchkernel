from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.HighlightFragment import HighlightFragment

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class HighlightResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> HighlightResult: ...
  @classmethod
  def GetRootAsHighlightResult(cls, buf: bytes, offset: int) -> HighlightResult: ...
  @classmethod
  def HighlightResultBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
  def Fragments(self, i: int) -> HighlightFragment | None: ...
  def FragmentsLength(self) -> int: ...
  def FragmentsIsNone(self) -> bool: ...
def HighlightResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def HighlightResultAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def HighlightResultAddFragments(builder: flatbuffers.Builder, fragments: uoffset) -> None: ...
def HighlightResultStartFragmentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFragmentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def HighlightResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

