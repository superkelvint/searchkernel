from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class HighlightSpan(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> HighlightSpan: ...
  @classmethod
  def GetRootAsHighlightSpan(cls, buf: bytes, offset: int) -> HighlightSpan: ...
  @classmethod
  def HighlightSpanBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def StartByte(self) -> int: ...
  def EndByte(self) -> int: ...
def HighlightSpanStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def HighlightSpanAddStartByte(builder: flatbuffers.Builder, startByte: int) -> None: ...
def HighlightSpanAddEndByte(builder: flatbuffers.Builder, endByte: int) -> None: ...
def HighlightSpanEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

