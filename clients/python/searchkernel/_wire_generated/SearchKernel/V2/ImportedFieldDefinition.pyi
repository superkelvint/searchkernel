from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ImportedFieldDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ImportedFieldDefinition: ...
  @classmethod
  def GetRootAsImportedFieldDefinition(cls, buf: bytes, offset: int) -> ImportedFieldDefinition: ...
  @classmethod
  def ImportedFieldDefinitionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ReferenceField(self) -> str | None: ...
  def TargetField(self) -> str | None: ...
  def Alias(self) -> str | None: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
def ImportedFieldDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ImportedFieldDefinitionAddReferenceField(builder: flatbuffers.Builder, referenceField: uoffset) -> None: ...
def ImportedFieldDefinitionAddTargetField(builder: flatbuffers.Builder, targetField: uoffset) -> None: ...
def ImportedFieldDefinitionAddAlias(builder: flatbuffers.Builder, alias: uoffset) -> None: ...
def ImportedFieldDefinitionAddProperties(builder: flatbuffers.Builder, properties: uoffset) -> None: ...
def ImportedFieldDefinitionStartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ImportedFieldDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

