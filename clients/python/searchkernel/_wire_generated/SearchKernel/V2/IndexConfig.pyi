from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.HnswIndexConfig import HnswIndexConfig
from SearchKernel.V2.OptionalBool import OptionalBool
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class IndexConfig(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> IndexConfig: ...
  @classmethod
  def GetRootAsIndexConfig(cls, buf: bytes, offset: int) -> IndexConfig: ...
  @classmethod
  def IndexConfigBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Enabled(self) -> OptionalBool | None: ...
  def Hnsw(self) -> HnswIndexConfig | None: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
def IndexConfigStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def IndexConfigAddEnabled(builder: flatbuffers.Builder, enabled: uoffset) -> None: ...
def IndexConfigAddHnsw(builder: flatbuffers.Builder, hnsw: uoffset) -> None: ...
def IndexConfigAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def IndexConfigStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def IndexConfigEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

