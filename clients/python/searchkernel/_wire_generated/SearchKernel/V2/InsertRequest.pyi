from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.Document import Document

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class InsertRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> InsertRequest: ...
  @classmethod
  def GetRootAsInsertRequest(cls, buf: bytes, offset: int) -> InsertRequest: ...
  @classmethod
  def InsertRequestBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Document(self) -> Document | None: ...
def InsertRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def InsertRequestAddDocument(builder: flatbuffers.Builder, document: uoffset) -> None: ...
def InsertRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

