from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class InsertResult(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> InsertResult: ...
  @classmethod
  def GetRootAsInsertResult(cls, buf: bytes, offset: int) -> InsertResult: ...
  @classmethod
  def InsertResultBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> str | None: ...
def InsertResultStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def InsertResultAddId(builder: flatbuffers.Builder, id: uoffset) -> None: ...
def InsertResultEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

