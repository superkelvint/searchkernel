from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Int64Value(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Int64Value: ...
  @classmethod
  def GetRootAsInt64Value(cls, buf: bytes, offset: int) -> Int64Value: ...
  @classmethod
  def Int64ValueBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> int: ...
def Int64ValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def Int64ValueAddValue(builder: flatbuffers.Builder, value: int) -> None: ...
def Int64ValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

