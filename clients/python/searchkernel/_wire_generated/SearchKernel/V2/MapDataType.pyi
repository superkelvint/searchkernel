def Start(builder: flatbuffers.Builder) -> None: ...
def MapDataTypeAddKeyType(builder: flatbuffers.Builder, keyType: uoffset) -> None: ...
def MapDataTypeAddValueType(builder: flatbuffers.Builder, valueType: uoffset) -> None: ...
