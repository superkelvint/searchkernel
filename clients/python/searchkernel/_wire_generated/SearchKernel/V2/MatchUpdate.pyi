from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.MatchedElementUpdate import MatchedElementUpdate
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MatchUpdate(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MatchUpdate: ...
  @classmethod
  def GetRootAsMatchUpdate(cls, buf: bytes, offset: int) -> MatchUpdate: ...
  @classmethod
  def MatchUpdateBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Element(self) -> Value | None: ...
  def Update(self) -> MatchedElementUpdate | None: ...
def MatchUpdateStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MatchUpdateAddElement(builder: flatbuffers.Builder, element: uoffset) -> None: ...
def MatchUpdateAddUpdate(builder: flatbuffers.Builder, update: uoffset) -> None: ...
def MatchUpdateEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

