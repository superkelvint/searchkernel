from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MissingFirst(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MissingFirst: ...
  @classmethod
  def GetRootAsMissingFirst(cls, buf: bytes, offset: int) -> MissingFirst: ...
  @classmethod
  def MissingFirstBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
def MissingFirstStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MissingFirstEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

