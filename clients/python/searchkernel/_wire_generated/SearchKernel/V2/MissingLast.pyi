from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MissingLast(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MissingLast: ...
  @classmethod
  def GetRootAsMissingLast(cls, buf: bytes, offset: int) -> MissingLast: ...
  @classmethod
  def MissingLastBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
def MissingLastStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MissingLastEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

