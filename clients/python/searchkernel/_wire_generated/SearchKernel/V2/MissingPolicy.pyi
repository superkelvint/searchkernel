from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.MissingPolicyKind import MissingPolicyKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MissingPolicy(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MissingPolicy: ...
  @classmethod
  def GetRootAsMissingPolicy(cls, buf: bytes, offset: int) -> MissingPolicy: ...
  @classmethod
  def MissingPolicyBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def PolicyType(self) -> typing.Literal[MissingPolicyKind.NONE, MissingPolicyKind.MissingFirst, MissingPolicyKind.MissingLast, MissingPolicyKind.MissingAs]: ...
  def Policy(self) -> table.Table | None: ...
def MissingPolicyStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MissingPolicyAddPolicyType(builder: flatbuffers.Builder, policyType: typing.Literal[MissingPolicyKind.NONE, MissingPolicyKind.MissingFirst, MissingPolicyKind.MissingLast, MissingPolicyKind.MissingAs]) -> None: ...
def MissingPolicyAddPolicy(builder: flatbuffers.Builder, policy: uoffset) -> None: ...
def MissingPolicyEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

