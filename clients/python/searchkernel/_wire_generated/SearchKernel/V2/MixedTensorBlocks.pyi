from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.TensorBlock import TensorBlock

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class MixedTensorBlocks(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> MixedTensorBlocks: ...
  @classmethod
  def GetRootAsMixedTensorBlocks(cls, buf: bytes, offset: int) -> MixedTensorBlocks: ...
  @classmethod
  def MixedTensorBlocksBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Blocks(self, i: int) -> TensorBlock | None: ...
  def BlocksLength(self) -> int: ...
  def BlocksIsNone(self) -> bool: ...
def MixedTensorBlocksStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def MixedTensorBlocksAddBlocks(builder: flatbuffers.Builder, blocks: uoffset) -> None: ...
def MixedTensorBlocksStartBlocksVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartBlocksVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def MixedTensorBlocksEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

