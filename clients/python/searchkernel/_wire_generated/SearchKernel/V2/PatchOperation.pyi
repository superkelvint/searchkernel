from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.PatchOperationKind import PatchOperationKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PatchOperation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PatchOperation: ...
  @classmethod
  def GetRootAsPatchOperation(cls, buf: bytes, offset: int) -> PatchOperation: ...
  @classmethod
  def PatchOperationBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def OperationType(self) -> typing.Literal[PatchOperationKind.NONE, PatchOperationKind.SetField, PatchOperationKind.UnsetField]: ...
  def Operation(self) -> table.Table | None: ...
def PatchOperationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PatchOperationAddOperationType(builder: flatbuffers.Builder, operationType: typing.Literal[PatchOperationKind.NONE, PatchOperationKind.SetField, PatchOperationKind.UnsetField]) -> None: ...
def PatchOperationAddOperation(builder: flatbuffers.Builder, operation: uoffset) -> None: ...
def PatchOperationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

