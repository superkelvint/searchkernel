from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.FieldProjection import FieldProjection
from SearchKernel.V2.HighlightRequest import HighlightRequest
from SearchKernel.V2.OptionalBool import OptionalBool

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PresentationRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PresentationRequest: ...
  @classmethod
  def GetRootAsPresentationRequest(cls, buf: bytes, offset: int) -> PresentationRequest: ...
  @classmethod
  def PresentationRequestBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Summary(self) -> str | None: ...
  def Fields(self) -> FieldProjection | None: ...
  def Highlighting(self) -> HighlightRequest | None: ...
  def Format(self) -> str | None: ...
  def Bolding(self) -> OptionalBool | None: ...
  def Timing(self) -> OptionalBool | None: ...
def PresentationRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PresentationRequestAddSummary(builder: flatbuffers.Builder, summary: uoffset) -> None: ...
def PresentationRequestAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def PresentationRequestAddHighlighting(builder: flatbuffers.Builder, highlighting: uoffset) -> None: ...
def PresentationRequestAddFormat(builder: flatbuffers.Builder, format: uoffset) -> None: ...
def PresentationRequestAddBolding(builder: flatbuffers.Builder, bolding: uoffset) -> None: ...
def PresentationRequestAddTiming(builder: flatbuffers.Builder, timing: uoffset) -> None: ...
def PresentationRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

