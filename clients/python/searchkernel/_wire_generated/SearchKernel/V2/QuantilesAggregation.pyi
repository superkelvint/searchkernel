from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.GroupingExpression import GroupingExpression

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QuantilesAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QuantilesAggregation: ...
  @classmethod
  def GetRootAsQuantilesAggregation(cls, buf: bytes, offset: int) -> QuantilesAggregation: ...
  @classmethod
  def QuantilesAggregationBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Quantiles(self, i: int) -> typing.List[float]: ...
  def QuantilesAsNumpy(self) -> np.ndarray: ...
  def QuantilesLength(self) -> int: ...
  def QuantilesIsNone(self) -> bool: ...
  def Expression(self) -> GroupingExpression | None: ...
def QuantilesAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QuantilesAggregationAddQuantiles(builder: flatbuffers.Builder, quantiles: uoffset) -> None: ...
def QuantilesAggregationStartQuantilesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartQuantilesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QuantilesAggregationAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def QuantilesAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

