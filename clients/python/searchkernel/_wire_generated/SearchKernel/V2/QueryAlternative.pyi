from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.OptionalDouble import OptionalDouble
from SearchKernel.V2.QueryExpr import QueryExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryAlternative(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryAlternative: ...
  @classmethod
  def GetRootAsQueryAlternative(cls, buf: bytes, offset: int) -> QueryAlternative: ...
  @classmethod
  def QueryAlternativeBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Query(self) -> QueryExpr | None: ...
  def Exactness(self) -> OptionalDouble | None: ...
def QueryAlternativeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryAlternativeAddQuery(builder: flatbuffers.Builder, query: uoffset) -> None: ...
def QueryAlternativeAddExactness(builder: flatbuffers.Builder, exactness: uoffset) -> None: ...
def QueryAlternativeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

