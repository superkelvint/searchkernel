  def GetRootAs(cls, buf: bytes, offset: int) -> QueryDotProduct: ...
  @classmethod
  def GetRootAsQueryDotProduct(cls, buf: bytes, offset: int) -> QueryDotProduct: ...
  @classmethod
  def QueryDotProductBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Items(self, i: int) -> WeightedQueryItem | None: ...
  def ItemsLength(self) -> int: ...
  def ItemsIsNone(self) -> bool: ...
def QueryDotProductStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryDotProductAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryDotProductAddItems(builder: flatbuffers.Builder, items: uoffset) -> None: ...
def QueryDotProductStartItemsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartItemsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryDotProductEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

