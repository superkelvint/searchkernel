from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryFieldRef import QueryFieldRef
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryIn(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryIn: ...
  @classmethod
  def GetRootAsQueryIn(cls, buf: bytes, offset: int) -> QueryIn: ...
  @classmethod
  def QueryInBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Values(self, i: int) -> Value | None: ...
  def ValuesLength(self) -> int: ...
  def ValuesIsNone(self) -> bool: ...
def QueryInStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryInAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryInAddValues(builder: flatbuffers.Builder, values: uoffset) -> None: ...
def QueryInStartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryInEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

