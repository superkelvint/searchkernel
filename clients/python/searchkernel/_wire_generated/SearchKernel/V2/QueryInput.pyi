from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryInputKind import QueryInputKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryInput(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryInput: ...
  @classmethod
  def GetRootAsQueryInput(cls, buf: bytes, offset: int) -> QueryInput: ...
  @classmethod
  def QueryInputBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def InputType(self) -> typing.Literal[QueryInputKind.NONE, QueryInputKind.LiteralQueryInput, QueryInputKind.ExpressionQueryInput]: ...
  def Input(self) -> table.Table | None: ...
def QueryInputStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryInputAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def QueryInputAddInputType(builder: flatbuffers.Builder, inputType: typing.Literal[QueryInputKind.NONE, QueryInputKind.LiteralQueryInput, QueryInputKind.ExpressionQueryInput]) -> None: ...
def QueryInputAddInput(builder: flatbuffers.Builder, input: uoffset) -> None: ...
def QueryInputEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

