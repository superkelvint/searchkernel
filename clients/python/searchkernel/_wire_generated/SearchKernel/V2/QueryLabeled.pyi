from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryExpr import QueryExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryLabeled(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryLabeled: ...
  @classmethod
  def GetRootAsQueryLabeled(cls, buf: bytes, offset: int) -> QueryLabeled: ...
  @classmethod
  def QueryLabeledBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Query(self) -> QueryExpr | None: ...
  def Label(self) -> str | None: ...
  def Score(self) -> float: ...
def QueryLabeledStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryLabeledAddQuery(builder: flatbuffers.Builder, query: uoffset) -> None: ...
def QueryLabeledAddLabel(builder: flatbuffers.Builder, label: uoffset) -> None: ...
def QueryLabeledAddScore(builder: flatbuffers.Builder, score: float) -> None: ...
def QueryLabeledEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

