from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryExpr import QueryExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryNear(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryNear: ...
  @classmethod
  def GetRootAsQueryNear(cls, buf: bytes, offset: int) -> QueryNear: ...
  @classmethod
  def QueryNearBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Terms(self, i: int) -> QueryExpr | None: ...
  def TermsLength(self) -> int: ...
  def TermsIsNone(self) -> bool: ...
def QueryNearStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryNearAddTerms(builder: flatbuffers.Builder, terms: uoffset) -> None: ...
def QueryNearStartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryNearEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

