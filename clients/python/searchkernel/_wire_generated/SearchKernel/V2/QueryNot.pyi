from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryExpr import QueryExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryNot(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryNot: ...
  @classmethod
  def GetRootAsQueryNot(cls, buf: bytes, offset: int) -> QueryNot: ...
  @classmethod
  def QueryNotBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Clause(self) -> QueryExpr | None: ...
def QueryNotStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryNotAddClause(builder: flatbuffers.Builder, clause: uoffset) -> None: ...
def QueryNotEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

