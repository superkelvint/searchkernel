from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryExpr import QueryExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryPhrase(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryPhrase: ...
  @classmethod
  def GetRootAsQueryPhrase(cls, buf: bytes, offset: int) -> QueryPhrase: ...
  @classmethod
  def QueryPhraseBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Terms(self, i: int) -> QueryExpr | None: ...
  def TermsLength(self) -> int: ...
  def TermsIsNone(self) -> bool: ...
def QueryPhraseStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryPhraseAddTerms(builder: flatbuffers.Builder, terms: uoffset) -> None: ...
def QueryPhraseStartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartTermsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryPhraseEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

