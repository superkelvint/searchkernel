from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QuerySourceKind import QuerySourceKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QuerySource(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QuerySource: ...
  @classmethod
  def GetRootAsQuerySource(cls, buf: bytes, offset: int) -> QuerySource: ...
  @classmethod
  def QuerySourceBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def SourceType(self) -> typing.Literal[QuerySourceKind.NONE, QuerySourceKind.SearchKernelTextQuery, QuerySourceKind.TypedQuery, QuerySourceKind.YqlQuery, QuerySourceKind.MatchAllQuery]: ...
  def Source(self) -> table.Table | None: ...
def QuerySourceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QuerySourceAddSourceType(builder: flatbuffers.Builder, sourceType: typing.Literal[QuerySourceKind.NONE, QuerySourceKind.SearchKernelTextQuery, QuerySourceKind.TypedQuery, QuerySourceKind.YqlQuery, QuerySourceKind.MatchAllQuery]) -> None: ...
def QuerySourceAddSource(builder: flatbuffers.Builder, source: uoffset) -> None: ...
def QuerySourceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

