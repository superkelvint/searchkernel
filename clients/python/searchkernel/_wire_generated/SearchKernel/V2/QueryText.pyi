from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryText(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryText: ...
  @classmethod
  def GetRootAsQueryText(cls, buf: bytes, offset: int) -> QueryText: ...
  @classmethod
  def QueryTextBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Text(self) -> str | None: ...
def QueryTextStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryTextAddText(builder: flatbuffers.Builder, text: uoffset) -> None: ...
def QueryTextEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

