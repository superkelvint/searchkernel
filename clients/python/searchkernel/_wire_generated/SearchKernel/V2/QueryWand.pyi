from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryFieldRef import QueryFieldRef
from SearchKernel.V2.WeightedQueryItem import WeightedQueryItem

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class QueryWand(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> QueryWand: ...
  @classmethod
  def GetRootAsQueryWand(cls, buf: bytes, offset: int) -> QueryWand: ...
  @classmethod
  def QueryWandBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> QueryFieldRef | None: ...
  def Items(self, i: int) -> WeightedQueryItem | None: ...
  def ItemsLength(self) -> int: ...
  def ItemsIsNone(self) -> bool: ...
def QueryWandStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def QueryWandAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def QueryWandAddItems(builder: flatbuffers.Builder, items: uoffset) -> None: ...
def QueryWandStartItemsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartItemsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def QueryWandEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

