from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.OptionalBool import OptionalBool

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RankFunctionDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RankFunctionDefinition: ...
  @classmethod
  def GetRootAsRankFunctionDefinition(cls, buf: bytes, offset: int) -> RankFunctionDefinition: ...
  @classmethod
  def RankFunctionDefinitionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def Arguments(self, i: int) -> str: ...
  def ArgumentsLength(self) -> int: ...
  def ArgumentsIsNone(self) -> bool: ...
  def Expression(self) -> str | None: ...
  def Inline(self) -> OptionalBool | None: ...
def RankFunctionDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RankFunctionDefinitionAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def RankFunctionDefinitionAddArguments(builder: flatbuffers.Builder, arguments: uoffset) -> None: ...
def RankFunctionDefinitionStartArgumentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartArgumentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def RankFunctionDefinitionAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def RankFunctionDefinitionAddInline(builder: flatbuffers.Builder, inline: uoffset) -> None: ...
def RankFunctionDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

