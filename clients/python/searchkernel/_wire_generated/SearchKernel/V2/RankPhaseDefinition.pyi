  def GetRootAs(cls, buf: bytes, offset: int) -> RankPhaseDefinition: ...
  @classmethod
  def GetRootAsRankPhaseDefinition(cls, buf: bytes, offset: int) -> RankPhaseDefinition: ...
  @classmethod
  def RankPhaseDefinitionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> str | None: ...
  def RerankCount(self) -> OptionalUInt32 | None: ...
  def RankScoreDropLimit(self) -> OptionalDouble | None: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
  def TotalRerankCount(self) -> OptionalUInt32 | None: ...
  def KeepRankCount(self) -> OptionalUInt32 | None: ...
  def TotalKeepRankCount(self) -> OptionalUInt32 | None: ...
def RankPhaseDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RankPhaseDefinitionAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def RankPhaseDefinitionAddRerankCount(builder: flatbuffers.Builder, rerankCount: uoffset) -> None: ...
def RankPhaseDefinitionAddRankScoreDropLimit(builder: flatbuffers.Builder, rankScoreDropLimit: uoffset) -> None: ...
def RankPhaseDefinitionAddProperties(builder: flatbuffers.Builder, properties: uoffset) -> None: ...
def RankPhaseDefinitionStartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def RankPhaseDefinitionAddTotalRerankCount(builder: flatbuffers.Builder, totalRerankCount: uoffset) -> None: ...
def RankPhaseDefinitionAddKeepRankCount(builder: flatbuffers.Builder, keepRankCount: uoffset) -> None: ...
def RankPhaseDefinitionAddTotalKeepRankCount(builder: flatbuffers.Builder, totalKeepRankCount: uoffset) -> None: ...
def RankPhaseDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

