from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RawGroupingSource(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> RawGroupingSource: ...
  @classmethod
  def GetRootAsRawGroupingSource(cls, buf: bytes, offset: int) -> RawGroupingSource: ...
  @classmethod
  def RawGroupingSourceBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Expression(self) -> str | None: ...
def RawGroupingSourceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RawGroupingSourceAddExpression(builder: flatbuffers.Builder, expression: uoffset) -> None: ...
def RawGroupingSourceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

