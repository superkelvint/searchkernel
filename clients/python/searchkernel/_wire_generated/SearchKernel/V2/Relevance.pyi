from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.RelevanceKind import RelevanceKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Relevance(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Relevance: ...
  @classmethod
  def GetRootAsRelevance(cls, buf: bytes, offset: int) -> Relevance: ...
  @classmethod
  def RelevanceBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ValueType(self) -> typing.Literal[RelevanceKind.NONE, RelevanceKind.FiniteRelevance, RelevanceKind.NegativeInfinityRelevance, RelevanceKind.PositiveInfinityRelevance]: ...
  def Value(self) -> table.Table | None: ...
def RelevanceStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def RelevanceAddValueType(builder: flatbuffers.Builder, valueType: typing.Literal[RelevanceKind.NONE, RelevanceKind.FiniteRelevance, RelevanceKind.NegativeInfinityRelevance, RelevanceKind.PositiveInfinityRelevance]) -> None: ...
def RelevanceAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def RelevanceEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

