from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.MissingPolicy import MissingPolicy
from SearchKernel.V2.ResolvedSortTarget import ResolvedSortTarget
from SearchKernel.V2.SortDirection import SortDirection
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ResolvedSortExpr(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ResolvedSortExpr: ...
  @classmethod
  def GetRootAsResolvedSortExpr(cls, buf: bytes, offset: int) -> ResolvedSortExpr: ...
  @classmethod
  def ResolvedSortExprBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Target(self) -> ResolvedSortTarget | None: ...
  def Direction(self) -> typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc]: ...
  def Missing(self) -> MissingPolicy | None: ...
  def Annotations(self, i: int) -> ValueEntry | None: ...
  def AnnotationsLength(self) -> int: ...
  def AnnotationsIsNone(self) -> bool: ...
def ResolvedSortExprStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ResolvedSortExprAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def ResolvedSortExprAddDirection(builder: flatbuffers.Builder, direction: typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc]) -> None: ...
def ResolvedSortExprAddMissing(builder: flatbuffers.Builder, missing: uoffset) -> None: ...
def ResolvedSortExprAddAnnotations(builder: flatbuffers.Builder, annotations: uoffset) -> None: ...
def ResolvedSortExprStartAnnotationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartAnnotationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ResolvedSortExprEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

