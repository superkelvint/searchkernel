  def ResolvedSortTargetBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def TargetType(self) -> typing.Literal[ResolvedSortTargetKind.NONE, ResolvedSortTargetKind.FieldSortTarget, ResolvedSortTargetKind.RelevanceSortTarget, ResolvedSortTargetKind.RankFeatureSortTarget]: ...
  def Target(self) -> table.Table | None: ...
def ResolvedSortTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ResolvedSortTargetAddTargetType(builder: flatbuffers.Builder, targetType: typing.Literal[ResolvedSortTargetKind.NONE, ResolvedSortTargetKind.FieldSortTarget, ResolvedSortTargetKind.RelevanceSortTarget, ResolvedSortTargetKind.RankFeatureSortTarget]) -> None: ...
def ResolvedSortTargetAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def ResolvedSortTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

