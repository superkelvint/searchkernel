from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.OptionalDouble import OptionalDouble

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchField(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchField: ...
  @classmethod
  def GetRootAsSearchField(cls, buf: bytes, offset: int) -> SearchField: ...
  @classmethod
  def SearchFieldBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
  def Weight(self) -> OptionalDouble | None: ...
def SearchFieldStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchFieldAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def SearchFieldAddWeight(builder: flatbuffers.Builder, weight: uoffset) -> None: ...
def SearchFieldEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

