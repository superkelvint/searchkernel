uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchRequest: ...
  @classmethod
  def GetRootAsSearchRequest(cls, buf: bytes, offset: int) -> SearchRequest: ...
  @classmethod
  def SearchRequestBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Query(self) -> QuerySource | None: ...
  def SearchFields(self) -> SearchFieldSelection | None: ...
  def Filters(self) -> FilterRequest | None: ...
  def Sort(self, i: int) -> SortExpr | None: ...
  def SortLength(self) -> int: ...
  def SortIsNone(self) -> bool: ...
  def Grouping(self, i: int) -> GroupingRequest | None: ...
  def GroupingLength(self) -> int: ...
  def GroupingIsNone(self) -> bool: ...
  def Ranking(self) -> RankingRequest | None: ...
  def Inputs(self, i: int) -> QueryInput | None: ...
  def InputsLength(self) -> int: ...
  def InputsIsNone(self) -> bool: ...
  def Limit(self) -> OptionalUInt32 | None: ...
  def Offset(self) -> OptionalUInt32 | None: ...
  def TimeoutMs(self) -> OptionalUInt64 | None: ...
  def QueryModel(self) -> QueryModel | None: ...
  def Presentation(self) -> PresentationRequest | None: ...
  def Properties(self, i: int) -> ValueEntry | None: ...
  def PropertiesLength(self) -> int: ...
  def PropertiesIsNone(self) -> bool: ...
  def QueryProfile(self) -> str | None: ...
  def SearchChain(self) -> str | None: ...
def SearchRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchRequestAddQuery(builder: flatbuffers.Builder, query: uoffset) -> None: ...
def SearchRequestAddSearchFields(builder: flatbuffers.Builder, searchFields: uoffset) -> None: ...
def SearchRequestAddFilters(builder: flatbuffers.Builder, filters: uoffset) -> None: ...
def SearchRequestAddSort(builder: flatbuffers.Builder, sort: uoffset) -> None: ...
def SearchRequestStartSortVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartSortVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
