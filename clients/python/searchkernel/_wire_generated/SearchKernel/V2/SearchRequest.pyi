def SearchRequestAddInputs(builder: flatbuffers.Builder, inputs: uoffset) -> None: ...
def SearchRequestStartInputsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartInputsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SearchRequestAddLimit(builder: flatbuffers.Builder, limit: uoffset) -> None: ...
def SearchRequestAddOffset(builder: flatbuffers.Builder, offset: uoffset) -> None: ...
def SearchRequestAddTimeoutMs(builder: flatbuffers.Builder, timeoutMs: uoffset) -> None: ...
def SearchRequestAddQueryModel(builder: flatbuffers.Builder, queryModel: uoffset) -> None: ...
def SearchRequestAddPresentation(builder: flatbuffers.Builder, presentation: uoffset) -> None: ...
def SearchRequestAddProperties(builder: flatbuffers.Builder, properties: uoffset) -> None: ...
def SearchRequestStartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPropertiesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SearchRequestAddQueryProfile(builder: flatbuffers.Builder, queryProfile: uoffset) -> None: ...
def SearchRequestAddSearchChain(builder: flatbuffers.Builder, searchChain: uoffset) -> None: ...
def SearchRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

