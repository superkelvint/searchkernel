from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.OptionalBool import OptionalBool
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SearchResultError(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SearchResultError: ...
  @classmethod
  def GetRootAsSearchResultError(cls, buf: bytes, offset: int) -> SearchResultError: ...
  @classmethod
  def SearchResultErrorBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Code(self) -> int: ...
  def Summary(self) -> str | None: ...
  def Message(self) -> str | None: ...
  def Source(self) -> str | None: ...
  def StackTrace(self) -> str | None: ...
  def Transient(self) -> OptionalBool | None: ...
  def Metadata(self, i: int) -> ValueEntry | None: ...
  def MetadataLength(self) -> int: ...
  def MetadataIsNone(self) -> bool: ...
def SearchResultErrorStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SearchResultErrorAddCode(builder: flatbuffers.Builder, code: int) -> None: ...
def SearchResultErrorAddSummary(builder: flatbuffers.Builder, summary: uoffset) -> None: ...
def SearchResultErrorAddMessage(builder: flatbuffers.Builder, message: uoffset) -> None: ...
def SearchResultErrorAddSource(builder: flatbuffers.Builder, source: uoffset) -> None: ...
def SearchResultErrorAddStackTrace(builder: flatbuffers.Builder, stackTrace: uoffset) -> None: ...
def SearchResultErrorAddTransient(builder: flatbuffers.Builder, transient: uoffset) -> None: ...
def SearchResultErrorAddMetadata(builder: flatbuffers.Builder, metadata: uoffset) -> None: ...
def SearchResultErrorStartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartMetadataVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SearchResultErrorEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

