from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SetField(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SetField: ...
  @classmethod
  def GetRootAsSetField(cls, buf: bytes, offset: int) -> SetField: ...
  @classmethod
  def SetFieldBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Field(self) -> str | None: ...
  def Value(self) -> Value | None: ...
def SetFieldStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SetFieldAddField(builder: flatbuffers.Builder, field: uoffset) -> None: ...
def SetFieldAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def SetFieldEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

