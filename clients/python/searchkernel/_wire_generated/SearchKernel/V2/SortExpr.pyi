from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.MissingPolicy import MissingPolicy
from SearchKernel.V2.SortDirection import SortDirection
from SearchKernel.V2.SortTarget import SortTarget
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SortExpr(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SortExpr: ...
  @classmethod
  def GetRootAsSortExpr(cls, buf: bytes, offset: int) -> SortExpr: ...
  @classmethod
  def SortExprBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Target(self) -> SortTarget | None: ...
  def Direction(self) -> typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc]: ...
  def Missing(self) -> MissingPolicy | None: ...
  def Annotations(self, i: int) -> ValueEntry | None: ...
  def AnnotationsLength(self) -> int: ...
  def AnnotationsIsNone(self) -> bool: ...
def SortExprStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SortExprAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def SortExprAddDirection(builder: flatbuffers.Builder, direction: typing.Literal[SortDirection.Unspecified, SortDirection.Asc, SortDirection.Desc]) -> None: ...
def SortExprAddMissing(builder: flatbuffers.Builder, missing: uoffset) -> None: ...
def SortExprAddAnnotations(builder: flatbuffers.Builder, annotations: uoffset) -> None: ...
def SortExprStartAnnotationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartAnnotationsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SortExprEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

