from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.SortTargetKind import SortTargetKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SortTarget(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SortTarget: ...
  @classmethod
  def GetRootAsSortTarget(cls, buf: bytes, offset: int) -> SortTarget: ...
  @classmethod
  def SortTargetBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def TargetType(self) -> typing.Literal[SortTargetKind.NONE, SortTargetKind.FieldSortTarget, SortTargetKind.RelevanceSortTarget, SortTargetKind.RankFeatureSortTarget, SortTargetKind.RawSortTarget]: ...
  def Target(self) -> table.Table | None: ...
def SortTargetStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SortTargetAddTargetType(builder: flatbuffers.Builder, targetType: typing.Literal[SortTargetKind.NONE, SortTargetKind.FieldSortTarget, SortTargetKind.RelevanceSortTarget, SortTargetKind.RankFeatureSortTarget, SortTargetKind.RawSortTarget]) -> None: ...
def SortTargetAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def SortTargetEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

