from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.TensorCell import TensorCell

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SparseTensorCells(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SparseTensorCells: ...
  @classmethod
  def GetRootAsSparseTensorCells(cls, buf: bytes, offset: int) -> SparseTensorCells: ...
  @classmethod
  def SparseTensorCellsBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Cells(self, i: int) -> TensorCell | None: ...
  def CellsLength(self) -> int: ...
  def CellsIsNone(self) -> bool: ...
def SparseTensorCellsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SparseTensorCellsAddCells(builder: flatbuffers.Builder, cells: uoffset) -> None: ...
def SparseTensorCellsStartCellsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartCellsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SparseTensorCellsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

