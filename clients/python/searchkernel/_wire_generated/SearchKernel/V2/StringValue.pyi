from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class StringValue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> StringValue: ...
  @classmethod
  def GetRootAsStringValue(cls, buf: bytes, offset: int) -> StringValue: ...
  @classmethod
  def StringValueBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> str | None: ...
def StringValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def StringValueAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def StringValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

