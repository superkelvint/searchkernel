from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.DataType import DataType

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class StructFieldDefinition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> StructFieldDefinition: ...
  @classmethod
  def GetRootAsStructFieldDefinition(cls, buf: bytes, offset: int) -> StructFieldDefinition: ...
  @classmethod
  def StructFieldDefinitionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Name(self) -> str | None: ...
  def DataType(self) -> DataType | None: ...
def StructFieldDefinitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def StructFieldDefinitionAddName(builder: flatbuffers.Builder, name: uoffset) -> None: ...
def StructFieldDefinitionAddDataType(builder: flatbuffers.Builder, dataType: uoffset) -> None: ...
def StructFieldDefinitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

