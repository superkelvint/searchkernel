from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SummaryAggregation(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SummaryAggregation: ...
  @classmethod
  def GetRootAsSummaryAggregation(cls, buf: bytes, offset: int) -> SummaryAggregation: ...
  @classmethod
  def SummaryAggregationBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Summary(self) -> str | None: ...
def SummaryAggregationStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SummaryAggregationAddSummary(builder: flatbuffers.Builder, summary: uoffset) -> None: ...
def SummaryAggregationEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

