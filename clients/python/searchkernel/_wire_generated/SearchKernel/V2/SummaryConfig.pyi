from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.OptionalBool import OptionalBool
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class SummaryConfig(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> SummaryConfig: ...
  @classmethod
  def GetRootAsSummaryConfig(cls, buf: bytes, offset: int) -> SummaryConfig: ...
  @classmethod
  def SummaryConfigBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Enabled(self) -> OptionalBool | None: ...
  def Options(self, i: int) -> ValueEntry | None: ...
  def OptionsLength(self) -> int: ...
  def OptionsIsNone(self) -> bool: ...
def SummaryConfigStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SummaryConfigAddEnabled(builder: flatbuffers.Builder, enabled: uoffset) -> None: ...
def SummaryConfigAddOptions(builder: flatbuffers.Builder, options: uoffset) -> None: ...
def SummaryConfigStartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartOptionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def SummaryConfigEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

