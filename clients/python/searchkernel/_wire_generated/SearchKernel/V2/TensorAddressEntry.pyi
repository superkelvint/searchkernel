from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TensorAddressEntry(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TensorAddressEntry: ...
  @classmethod
  def GetRootAsTensorAddressEntry(cls, buf: bytes, offset: int) -> TensorAddressEntry: ...
  @classmethod
  def TensorAddressEntryBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Dimension(self) -> str | None: ...
  def Label(self) -> str | None: ...
def TensorAddressEntryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TensorAddressEntryAddDimension(builder: flatbuffers.Builder, dimension: uoffset) -> None: ...
def TensorAddressEntryAddLabel(builder: flatbuffers.Builder, label: uoffset) -> None: ...
def TensorAddressEntryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

