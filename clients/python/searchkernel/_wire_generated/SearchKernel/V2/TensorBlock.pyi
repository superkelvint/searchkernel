from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.TensorAddressEntry import TensorAddressEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TensorBlock(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TensorBlock: ...
  @classmethod
  def GetRootAsTensorBlock(cls, buf: bytes, offset: int) -> TensorBlock: ...
  @classmethod
  def TensorBlockBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Address(self, i: int) -> TensorAddressEntry | None: ...
  def AddressLength(self) -> int: ...
  def AddressIsNone(self) -> bool: ...
  def Values(self, i: int) -> typing.List[float]: ...
  def ValuesAsNumpy(self) -> np.ndarray: ...
  def ValuesLength(self) -> int: ...
  def ValuesIsNone(self) -> bool: ...
def TensorBlockStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TensorBlockAddAddress(builder: flatbuffers.Builder, address: uoffset) -> None: ...
def TensorBlockStartAddressVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartAddressVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def TensorBlockAddValues(builder: flatbuffers.Builder, values: uoffset) -> None: ...
def TensorBlockStartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def TensorBlockEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

