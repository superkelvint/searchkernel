from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.TensorAddressEntry import TensorAddressEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TensorCell(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TensorCell: ...
  @classmethod
  def GetRootAsTensorCell(cls, buf: bytes, offset: int) -> TensorCell: ...
  @classmethod
  def TensorCellBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Address(self, i: int) -> TensorAddressEntry | None: ...
  def AddressLength(self) -> int: ...
  def AddressIsNone(self) -> bool: ...
  def Value(self) -> float: ...
def TensorCellStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TensorCellAddAddress(builder: flatbuffers.Builder, address: uoffset) -> None: ...
def TensorCellStartAddressVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartAddressVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def TensorCellAddValue(builder: flatbuffers.Builder, value: float) -> None: ...
def TensorCellEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

