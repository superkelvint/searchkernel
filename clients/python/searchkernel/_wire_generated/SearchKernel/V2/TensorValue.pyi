from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.TensorPayloadKind import TensorPayloadKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TensorValue(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TensorValue: ...
  @classmethod
  def GetRootAsTensorValue(cls, buf: bytes, offset: int) -> TensorValue: ...
  @classmethod
  def TensorValueBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def TypeSpec(self) -> str | None: ...
  def PayloadType(self) -> typing.Literal[TensorPayloadKind.NONE, TensorPayloadKind.DenseTensorValues, TensorPayloadKind.SparseTensorCells, TensorPayloadKind.MixedTensorBlocks]: ...
  def Payload(self) -> table.Table | None: ...
def TensorValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TensorValueAddTypeSpec(builder: flatbuffers.Builder, typeSpec: uoffset) -> None: ...
def TensorValueAddPayloadType(builder: flatbuffers.Builder, payloadType: typing.Literal[TensorPayloadKind.NONE, TensorPayloadKind.DenseTensorValues, TensorPayloadKind.SparseTensorCells, TensorPayloadKind.MixedTensorBlocks]) -> None: ...
def TensorValueAddPayload(builder: flatbuffers.Builder, payload: uoffset) -> None: ...
def TensorValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

