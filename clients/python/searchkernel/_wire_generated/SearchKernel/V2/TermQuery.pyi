from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TermQuery(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TermQuery: ...
  @classmethod
  def GetRootAsTermQuery(cls, buf: bytes, offset: int) -> TermQuery: ...
  @classmethod
  def TermQueryBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Value(self) -> Value | None: ...
def TermQueryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TermQueryAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def TermQueryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

