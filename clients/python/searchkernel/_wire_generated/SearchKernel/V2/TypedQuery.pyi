from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.QueryExpr import QueryExpr

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class TypedQuery(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> TypedQuery: ...
  @classmethod
  def GetRootAsTypedQuery(cls, buf: bytes, offset: int) -> TypedQuery: ...
  @classmethod
  def TypedQueryBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Query(self) -> QueryExpr | None: ...
def TypedQueryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def TypedQueryAddQuery(builder: flatbuffers.Builder, query: uoffset) -> None: ...
def TypedQueryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

