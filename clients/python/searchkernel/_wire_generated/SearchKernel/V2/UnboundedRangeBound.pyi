from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class UnboundedRangeBound(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> UnboundedRangeBound: ...
  @classmethod
  def GetRootAsUnboundedRangeBound(cls, buf: bytes, offset: int) -> UnboundedRangeBound: ...
  @classmethod
  def UnboundedRangeBoundBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
def UnboundedRangeBoundStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def UnboundedRangeBoundEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

