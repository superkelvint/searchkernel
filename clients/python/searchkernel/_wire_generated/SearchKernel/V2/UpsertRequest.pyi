from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.Document import Document

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class UpsertRequest(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> UpsertRequest: ...
  @classmethod
  def GetRootAsUpsertRequest(cls, buf: bytes, offset: int) -> UpsertRequest: ...
  @classmethod
  def UpsertRequestBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Document(self) -> Document | None: ...
  def Condition(self) -> str | None: ...
def UpsertRequestStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def UpsertRequestAddDocument(builder: flatbuffers.Builder, document: uoffset) -> None: ...
def UpsertRequestAddCondition(builder: flatbuffers.Builder, condition: uoffset) -> None: ...
def UpsertRequestEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

