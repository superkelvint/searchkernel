from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.ValueKind import ValueKind
from flatbuffers import table

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Value(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Value: ...
  @classmethod
  def GetRootAsValue(cls, buf: bytes, offset: int) -> Value: ...
  @classmethod
  def ValueBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def KindType(self) -> typing.Literal[ValueKind.NONE, ValueKind.NullValueValue, ValueKind.BoolValue, ValueKind.Int64Value, ValueKind.UInt64Value, ValueKind.Float64Value, ValueKind.NonFiniteFloatValue, ValueKind.StringValue, ValueKind.BytesValue, ValueKind.ValueList, ValueKind.ValueObject, ValueKind.TensorValue]: ...
  def Kind(self) -> table.Table | None: ...
def ValueStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ValueAddKindType(builder: flatbuffers.Builder, kindType: typing.Literal[ValueKind.NONE, ValueKind.NullValueValue, ValueKind.BoolValue, ValueKind.Int64Value, ValueKind.UInt64Value, ValueKind.Float64Value, ValueKind.NonFiniteFloatValue, ValueKind.StringValue, ValueKind.BytesValue, ValueKind.ValueList, ValueKind.ValueObject, ValueKind.TensorValue]) -> None: ...
def ValueAddKind(builder: flatbuffers.Builder, kind: uoffset) -> None: ...
def ValueEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

