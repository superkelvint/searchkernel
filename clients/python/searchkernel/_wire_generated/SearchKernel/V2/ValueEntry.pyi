from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ValueEntry(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ValueEntry: ...
  @classmethod
  def GetRootAsValueEntry(cls, buf: bytes, offset: int) -> ValueEntry: ...
  @classmethod
  def ValueEntryBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Key(self) -> str | None: ...
  def Value(self) -> Value | None: ...
def ValueEntryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ValueEntryAddKey(builder: flatbuffers.Builder, key: uoffset) -> None: ...
def ValueEntryAddValue(builder: flatbuffers.Builder, value: uoffset) -> None: ...
def ValueEntryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

