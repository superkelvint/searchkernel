from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.Value import Value

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ValueList(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ValueList: ...
  @classmethod
  def GetRootAsValueList(cls, buf: bytes, offset: int) -> ValueList: ...
  @classmethod
  def ValueListBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Values(self, i: int) -> Value | None: ...
  def ValuesLength(self) -> int: ...
  def ValuesIsNone(self) -> bool: ...
def ValueListStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ValueListAddValues(builder: flatbuffers.Builder, values: uoffset) -> None: ...
def ValueListStartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartValuesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ValueListEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

