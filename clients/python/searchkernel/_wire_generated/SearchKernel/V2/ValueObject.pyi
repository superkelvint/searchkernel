from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from SearchKernel.V2.ValueEntry import ValueEntry

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ValueObject(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ValueObject: ...
  @classmethod
  def GetRootAsValueObject(cls, buf: bytes, offset: int) -> ValueObject: ...
  @classmethod
  def ValueObjectBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Fields(self, i: int) -> ValueEntry | None: ...
  def FieldsLength(self) -> int: ...
  def FieldsIsNone(self) -> bool: ...
def ValueObjectStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ValueObjectAddFields(builder: flatbuffers.Builder, fields: uoffset) -> None: ...
def ValueObjectStartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFieldsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ValueObjectEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

