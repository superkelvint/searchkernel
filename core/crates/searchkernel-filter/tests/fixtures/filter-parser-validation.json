{
  "format_version": 1,
  "contract": {
    "description": "Frozen standalone syntax-parser verification corpus for Search Kernel filter expressions. No schema binding is exercised here.",
    "span_unit": "utf8_byte_offset",
    "span_interval": "[start,end)",
    "identifier_regex": "[A-Za-z_][A-Za-z0-9_]*",
    "parameter_regex": ":[A-Za-z_][A-Za-z0-9_]*",
    "number_regex": "-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?",
    "keywords_case_insensitive": true,
    "logical_ast": "n_ary",
    "parentheses": "no_group_node; widen contained expression outer span to include parentheses",
    "in_single_parameter": "IN (:name) is InValues::Parameter; lists with commas are InValues::Values",
    "numeric_semantics": "preserve exact source text; no numeric conversion in parser"
  },
  "limits": {
    "expression_bytes": 65536,
    "tokens": 16384,
    "nesting_depth": 64,
    "ast_nodes": 4096,
    "in_values": 1024,
    "parameter_references": 1024
  },
  "canonical_ast": {
    "compare": {
      "kind": "compare",
      "span": [
        "start",
        "end"
      ],
      "field": {
        "name": "fieldName",
        "span": [
          "start",
          "end"
        ]
      },
      "op": "eq|lt|lte|gt|gte",
      "value": "canonical value object"
    },
    "in": {
      "kind": "in",
      "span": [
        "start",
        "end"
      ],
      "field": {
        "name": "fieldName",
        "span": [
          "start",
          "end"
        ]
      },
      "values": "values-list or single-list-parameter object"
    },
    "and_or": {
      "kind": "and|or",
      "span": [
        "start",
        "end"
      ],
      "items": [
        "canonical expression",
        "..."
      ]
    },
    "not": {
      "kind": "not",
      "span": [
        "start",
        "end"
      ],
      "expr": "canonical expression"
    },
    "values": {
      "string": {
        "kind": "string",
        "value": "decoded string",
        "span": [
          "start",
          "end"
        ]
      },
      "number": {
        "kind": "number",
        "source": "exact literal source",
        "span": [
          "start",
          "end"
        ]
      },
      "boolean": {
        "kind": "boolean",
        "value": true,
        "span": [
          "start",
          "end"
        ]
      },
      "parameter": {
        "kind": "parameter",
        "name": "without colon",
        "span": [
          "start",
          "end"
        ]
      }
    }
  },
  "generator_contract": {
    "nested_parentheses": "source = '(' * depth + predicate + ')' * depth",
    "or_chain": "source = ' OR '.join(f'f{i} = 1' for i in range(count))",
    "in_list": "source = 'f IN (' + ', '.join('1' for _ in range(count)) + ')'",
    "parameter_chain": "source = ' OR '.join(f'f{i} = :p{i}' for i in range(count))",
    "repeat": "source = text repeated count times"
  },
