run_ruby_tests() {
    ruby -I"$ROOT/clients/ruby/lib" "$ROOT/clients/ruby/test/run.rb"
    "$CARGO" test -p searchkernel-protocol --test ruby_json_contract -- --ignored

    local package_dir gem_home status
    package_dir=$(mktemp -d "${TMPDIR:-/tmp}/searchkernel-ruby-package.XXXXXX")
    gem_home=$(mktemp -d "${TMPDIR:-/tmp}/searchkernel-ruby-gem-home.XXXXXX")
    status=0
    (
        cd "$ROOT/clients/ruby"
        ruby -S gem build searchkernel.gemspec --output "$package_dir/searchkernel.gem" >/dev/null
        GEM_HOME="$gem_home" GEM_PATH="$gem_home" \
            ruby -S gem install --local --install-dir "$gem_home" \
                "$package_dir/searchkernel.gem" --no-document >/dev/null
        GEM_HOME="$gem_home" GEM_PATH="$gem_home" \
            ruby -e 'require "rubygems"; Gem.use_paths(ENV.fetch("GEM_HOME"), [ENV.fetch("GEM_HOME")]); Gem::Specification.reset; gem "searchkernel"; require "searchkernel"; abort unless SearchKernel::Protocol::VERSION == 2;
              v = SearchKernel::Value; abort unless v.decode(v.encode(v.uint64(2**64 - 1))) == 2**64 - 1;
              root = {"node_type" => "ResultGroup", "node" => {"children" => [
                {"node_type" => "Hit", "node" => {"id" => "from-installed-gem"}}]}};
              results = SearchKernel::Results::SearchResults.new({"root" => root, "total_hits" => {"value" => "1", "relation" => "Exact"}});
              abort unless results.hits.map(&:id) == ["from-installed-gem"]'
        GEM_HOME="$gem_home" GEM_PATH="$gem_home" SEARCHKERNEL_RUBY_USE_INSTALLED_GEM=1 \
            run_client_e2e ruby
    ) || status=$?
    rm -rf -- "$package_dir" "$gem_home"
    [[ "$status" -eq 0 ]] || return "$status"
}

