doctor_repair_python() {
    if doctor_python >/dev/null 2>&1; then
        return 0
    fi

    local bootstrap_python=$PYTHON
    local venv_python="$ROOT/venv/bin/python"

    command -v "$bootstrap_python" >/dev/null 2>&1 || {
        echo "cannot repair Python dependencies: $bootstrap_python is not available" >&2
        return 1
    }

    echo 'REPAIR Python dependencies'
    if [[ ! -x "$venv_python" ]]; then
        "$bootstrap_python" -m venv --system-site-packages "$ROOT/venv" || {
            echo "cannot create repository Python environment at $ROOT/venv" >&2
            return 1
        }
    fi

    "$venv_python" -m pip install         --disable-pip-version-check         -e "$ROOT/clients/python[codegen]"
    PYTHON=$venv_python
    export PYTHON
    doctor_python
}

doctor_repair_native_sdk() {
    # A valid selected SDK is sufficient to build and run Search Kernel. A
    # configured/pinned Vespa source checkout is only needed when provisioning
    # or rebuilding the shared native base; do not force a private GitHub
    # release lookup merely to satisfy source-provenance bookkeeping.
    if doctor_native_sdk >/dev/null 2>&1; then
        return 0
    fi
    echo 'REPAIR native SDK'
    native_sdk_command ensure >/dev/null
    doctor_native_sdk
}

doctor_repair_generated_protocol() {
    if doctor_generated_protocol >/dev/null 2>&1; then
        return 0
    fi
    echo 'REPAIR generated protocol artifacts'
    regen_protocol
    doctor_generated_protocol
}

doctor_repair_searchkerneld() {
    if doctor_searchkerneld >/dev/null 2>&1; then
        return 0
    fi
    echo 'REPAIR searchkerneld native build'
    "$CARGO" build -p searchkerneld --features native
    doctor_searchkerneld
}

doctor_searchkerneld() {
    local target_dir=${CARGO_TARGET_DIR:-$ROOT/target/host}
    local binary=${SEARCHKERNELD_BIN:-$target_dir/debug/searchkerneld}
    "$CARGO" build -p searchkerneld --features native --quiet
    [[ -x "$binary" ]]
}

doctor_toolchain_authorities() {
    "$PYTHON" "$ROOT/tools/test_toolchain_authorities.py"
}

doctor() {
    local status=0
    local diagnostics
    diagnostics=$(mktemp)

    doctor_check() {
        local label=$1
        shift
        if "$@" >"$diagnostics" 2>&1; then
            printf 'PASS  %s\n' "$label"
        else
            printf 'FAIL  %s\n' "$label"
            sed -n '1,6p' "$diagnostics" | sed 's/^/      /'
            status=1
        fi
    }

    repair() {
        local label=$1
        shift
        if ! "$@"; then
            echo "REPAIR FAILED  $label" >&2
            status=1
        fi
    }

    echo "Search Kernel doctor"

    repair 'Rust toolchain' doctor_repair_rust
    if doctor_rust >/dev/null 2>&1; then
        repair 'Node.js toolchain' doctor_repair_node
        repair 'system verification tools' doctor_repair_system_tools
        repair 'FlatBuffers toolchain' doctor_repair_flatbuffers
        repair 'TypeScript dependencies' doctor_repair_typescript
        repair 'Python dependencies' doctor_repair_python
        repair 'native SDK' doctor_repair_native_sdk
        repair 'generated protocol artifacts' doctor_repair_generated_protocol
        repair 'searchkerneld' doctor_repair_searchkerneld
    fi

    echo
    echo 'Verification'
    doctor_check 'toolchain authority contract' doctor_toolchain_authorities
    doctor_check 'Rust toolchain present' doctor_rust
    doctor_check 'Node.js toolchain present' doctor_node
    doctor_check 'system verification tools present' doctor_system_tools
    doctor_check 'flatc correct version' doctor_flatc
    doctor_check 'FlatBuffers C++ correct version' doctor_flatbuffers_cpp
    doctor_check 'generated protocol present/current' doctor_generated_protocol
    doctor_check 'TypeScript generated protocol present/current' doctor_typescript
    doctor_check 'native SDK present' doctor_native_sdk
    doctor_check 'native ABI versions agree' doctor_native_abi
    if [[ -n "${SK_NATIVE_SDK:-}" ]]; then
        printf 'INFO  pinned Vespa checkout registration not required with explicit SK_NATIVE_SDK\n'
    elif doctor_vespa >"$diagnostics" 2>&1; then
        printf 'PASS  pinned Vespa checkout registered\n'
    else
        printf 'INFO  pinned Vespa checkout not registered; only needed to rebuild/provision the native base\n'
    fi
    doctor_check 'Python dependencies present' doctor_python
    doctor_check 'searchkerneld built' doctor_searchkerneld

    if ((status == 0)); then
        echo 'Doctor: environment repaired and all prerequisites passed'
    else
        echo 'Doctor: one or more prerequisites could not be repaired' >&2
    fi
    rm -f "$diagnostics"
    return "$status"
}

planned_command() {
    local command=$1 milestone=$2
    echo "./dev $command is part of the public build vocabulary but is not implemented until $milestone" >&2
    return 2
}

case "${1:-help}" in
    help|-h|--help)
        usage
        ;;
    build)
        planned_command build M1
        ;;
    ci)
        [[ $# -eq 1 ]] || {
            echo 'usage: ./dev ci' >&2
            exit 2
        }
        ci_gate
        ;;
    check)
        check_all
        ;;
    galaxy)
        check_all
        ;;
    universe)
        UNIVERSE_LOG=${SEARCHKERNEL_UNIVERSE_LOG:-/tmp/searchkernel-universe-$(date +%Y%m%d-%H%M%S).log}
        : > "$UNIVERSE_LOG"
        echo "Search Kernel universe log: $UNIVERSE_LOG"
        set +e
        universe 2>&1 | tee -a "$UNIVERSE_LOG"
        status=${PIPESTATUS[0]}
        set -e
        exit "$status"
        ;;
    check-fast)
        check_fast
        ;;
    check-protocol)
        check_protocol
        ;;
    coverage)
        shift
        coverage_target "$@"
        ;;
    lint)
        shift
        lint_target "$@"
        ;;
    test)
        shift
        test_target "${1:-}"
        ;;
    explain)
        [[ "$#" -eq 2 ]] || {
            echo 'usage: ./dev explain <path>' >&2
            exit 2
        }
        "$PYTHON" "$ROOT/tools/dev-targets.py" explain "$2"
        ;;
    bookkeeping)
        shift
        bookkeeping_command "$@"
        ;;
    regen)
        case "${2:-}" in
            protocol) regen_protocol ;;
            result-fixtures) regen_result_fixtures ;;
            *)
                echo 'usage: ./dev regen protocol|result-fixtures' >&2
                exit 2
                ;;
        esac
        ;;
    verify)
        shift
        verify_target "$@"
        ;;
    install)
        shift
        install_target "$@"
        ;;
    native-sdk)
        shift
        native_sdk_command "${1:-ensure}"
        ;;
    image)
        shift
        image_command "$@"
        ;;
    worktree)
        [[ "${2:-}" == create ]] || {
            echo 'usage: ./dev worktree create <task-name>' >&2
            exit 2
        }
        shift 2
        worktree_create "$@"
        ;;
    doctor)
        doctor
        ;;
    release-check)
        planned_command release-check M5
        ;;
    *)
        echo "unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
