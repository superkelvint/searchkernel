}

doctor_repair_system_tools() {
    if doctor_system_tools >/dev/null 2>&1; then
        return 0
    fi

    echo 'REPAIR system verification tools'

    if command -v dnf >/dev/null 2>&1; then
        # ripgrep is provided by EPEL on the AlmaLinux 8 environment used by
        # Search Kernel. Keep this package surface aligned with the CI image;
        # there is no `libclang` RPM in that install path, and including it in
        # the same transaction prevents dnf from installing rg at all.
        dnf install -y epel-release
        dnf install -y ripgrep clang python3-clang
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y ripgrep clang python3-clang libclang-dev
    else
        echo 'cannot repair system verification tools: supported package manager (dnf/apt-get) not found' >&2
        return 1
    fi

    command -v rg >/dev/null 2>&1 || return 1
    command -v clang >/dev/null 2>&1 || return 1
    run_abi_python "$ROOT/tools/check_abi_surface.py" --help >/dev/null 2>&1 || {
        echo 'clang packages are installed, but the ABI checker still cannot load clang.cindex' >&2
        return 1
    }
}

doctor_repair_flatbuffers() {
    if doctor_flatc >/dev/null 2>&1 && doctor_flatbuffers_cpp >/dev/null 2>&1; then
        return 0
    fi
    echo 'REPAIR FlatBuffers toolchain'
    install_flatbuffers
    DOCTOR_FLATC=$(find_flatc)
    doctor_flatc && doctor_flatbuffers_cpp
}

doctor_repair_typescript() {
    if doctor_typescript >/dev/null 2>&1; then
        return 0
