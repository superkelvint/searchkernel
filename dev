#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ ("${1:-}" == "test" || "${1:-}" == "verify") && "${2:-}" == "--remote" ]]; then
    [[ "$#" -eq 3 ]] || {
        echo "usage: ./dev ${1:-test} --remote <target>" >&2
        exit 2
    }
    exec bash "$ROOT/tools/remote-verification.sh" "$1" "$3"
fi

should_use_ci_image() {
    case "${1:-}" in
        ci|check|galaxy|universe|check-fast|check-protocol|coverage|lint|test|verify)
            return 0
            ;;
        native-sdk)
            if [[ "${2:-ensure}" == "ensure" ]]; then
                return 0
            fi
            return 1
            ;;
        *)
            return 1
            ;;
    esac
}

# Build/test/verify commands use the same immutable environment as CI by
# default. Dispatch before resolving any host language toolchain so the host is
# only responsible for Git + Docker. Inside searchkernel-ci the marker and
# explicit flag prevent recursive container launches.
if [[ "${SEARCHKERNEL_DEV_USE_CI_IMAGE:-1}" != "0" &&
      "${SEARCHKERNEL_IN_CI_IMAGE:-0}" != "1" &&
      ! -f /opt/searchkernel/native-validation-pass ]] &&
   should_use_ci_image "$@"; then
    if [[ "${1:-}" == "universe" ]]; then
        UNIVERSE_LOG=${SEARCHKERNEL_UNIVERSE_LOG:-/tmp/searchkernel-universe-$(date +%Y%m%d-%H%M%S).log}
        echo "Search Kernel universe log: $UNIVERSE_LOG"
        set +e
        bash "$ROOT/tools/run-in-ci-image.sh" "$@" 2>&1 | tee "$UNIVERSE_LOG"
        status=${PIPESTATUS[0]}
        set -e
        exit "$status"
    fi
    exec bash "$ROOT/tools/run-in-ci-image.sh" "$@"
fi

