#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
EXPECTED_FLATBUFFERS_VERSION=25.12.19
PYTHON=${PYTHON:-python3}

cd "$ROOT"

ensure_hooks() {
    local configured
    configured=$(git config --local --get core.hooksPath 2>/dev/null || true)
    if [[ "$configured" != ".githooks" ]]; then
        git config --local core.hooksPath .githooks
        echo 'Configured repository-managed Git hooks at .githooks'
    fi
}

# Any normal use of ./dev should leave the clone correctly configured.
ensure_hooks

usage() {
    cat <<'EOF'
Search Kernel development commands

  ./dev check                 Run the full repository quality and test suite
  ./dev check-fast            Run formatting, compile, and boundary checks
  ./dev check-protocol        Verify generated FlatBuffers/gRPC artifacts
  ./dev test ir               Test the portable semantic IR
  ./dev test rust-api         Test the public Rust API
  ./dev test python           Test the Python client
  ./dev test typescript       Test the TypeScript client and generated contract
  ./dev test php              Test the PHP client
  ./dev regen protocol        Regenerate checked-in protocol artifacts
  ./dev regen result-fixtures Generate canonical encoded result fixtures
  ./dev verify m14            Run a frozen Vespa milestone verifier
  ./dev verify integration   Run the cross-entry-point integration verifier
  ./dev verify contracts      Verify capability/client contract tooling
  ./dev verify abi            Verify the public native ABI contract
  ./dev verify persistence    Verify persistence compatibility
  ./dev verify issue-queue    Test issue-queue consistency tooling
  ./dev install flatbuffers   Build and install the pinned FlatBuffers toolchain
  ./dev native-sdk ensure     Resolve/build the immutable shared Vespa SDK
  ./dev native-sdk path       Print the SDK object selected for this worktree
  ./dev hooks install        Install the repository-managed Git hooks
  ./dev worktree create <task-name> Create a /tmp task worktree and agent branch
  ./dev doctor                Diagnose local build and verification prerequisites

Environment overrides used by the underlying tools, including FLATC_PATH,
FLATBUFFERS_CPP_ROOT, FLATBUFFERS_INSTALL_PREFIX, SK_NATIVE_SDK, and
CARGO_TARGET_DIR, are honored. The normal host target directory is target/host;
the supported dev container and CI select their own native-sensitive
directories. Cargo's protocol build uses the vendored FlatBuffers copy.
EOF
}

git_common_dir() {
    local common
    common=$(git rev-parse --git-common-dir)
    if [[ "$common" != /* ]]; then
        common="$ROOT/$common"
    fi
    (cd -- "$common" && pwd)
}

shared_flatbuffers_prefix() {
    printf '%s/searchkernel/toolchains/flatbuffers/%s/%s\n' \
        "$(git_common_dir)" "$EXPECTED_FLATBUFFERS_VERSION" "${SEARCHKERNEL_BUILD_ENV:-host}"
}

native_target_root() {
    local target_root=${CARGO_TARGET_DIR:-$ROOT/target/${SEARCHKERNEL_BUILD_ENV:-host}}
    case "$target_root" in
        /*) printf '%s\n' "$target_root" ;;
        *) printf '%s/%s\n' "$ROOT" "$target_root" ;;
    esac
}

native_sdk_path() {
    if [[ -n "${SK_NATIVE_SDK:-}" ]]; then
        printf '%s\n' "$SK_NATIVE_SDK"
    else
        bash "$ROOT/tools/resolve-native-sdk.sh" path
    fi
}

run_python_tests() {
    "$PYTHON" -m unittest discover -s clients/python/tests -p 'test_*.py'
}

run_typescript_generation_check() {
    bash "$ROOT/tools/check-typescript-generated.sh"
}

run_typescript_tests() {
    bash "$ROOT/tools/test-typescript-generation.sh"
    run_typescript_generation_check
    npm run typecheck --prefix "$ROOT/clients/typescript"
    npm test --prefix "$ROOT/clients/typescript"
    npm run test:package --prefix "$ROOT/clients/typescript"
}

check_fast() {
    cargo fmt --all --check
    cargo check --workspace --all-targets --no-default-features
    bash "$ROOT/tools/check-layout.sh"
    bash "$ROOT/tools/test-flatbuffers-cpp-toolchain.sh"
    bash "$ROOT/tools/check-ir-boundary.sh"
    "$PYTHON" "$ROOT/tools/check-search-semantic-entry-points.py"
    "$PYTHON" "$ROOT/tools/check-native-abi-authorities.py"
    "$PYTHON" "$ROOT/tools/check_abi_surface.py" \
        "$ROOT/core/native/vespa/searchkernel_vespa.h"
    "$PYTHON" "$ROOT/tools/check-python-flatbuffers-boundary.py"
    "$PYTHON" "$ROOT/tools/check-capabilities.py" --check
    "$PYTHON" "$ROOT/tools/check-client-contracts.py" --check
    run_typescript_generation_check
    cargo run -p searchkernel-testkit --no-default-features --bin searchkernel-result-fixtures -- --check
}

check_protocol() {
    bash "$ROOT/tools/check-flatbuffers-bfbs.sh"
    bash "$ROOT/tools/check-searchkernel-protocol-generated.sh"
    bash "$ROOT/tools/check-searchkernel-rpc.sh"
    bash "$ROOT/tools/check-python-flatbuffers-generated.sh"
    bash "$ROOT/tools/check-python-grpc.sh"
    run_typescript_generation_check
}

check_all() {
    check_fast
    bash "$ROOT/tools/check-vespa-bindings.sh"
    check_protocol
    "$PYTHON" "$ROOT/tools/test_check_capabilities.py"
    "$PYTHON" "$ROOT/tools/test_check_client_contracts.py"
    "$PYTHON" "$ROOT/tools/test_check_issue_queue.py"
    cargo clippy --workspace --all-targets --all-features -- -D warnings
    cargo test --workspace --all-targets --all-features
    run_python_tests
    run_typescript_tests
}

regen_protocol() {
    bash "$ROOT/tools/generate-searchkernel-protocol.sh"
    bash "$ROOT/tools/generate-flatbuffers-bfbs.sh"
    bash "$ROOT/tools/generate-searchkernel-rpc.sh"
    bash "$ROOT/tools/generate-python-flatbuffers.sh"
    bash "$ROOT/tools/generate-python-grpc.sh"
    npm run generate --prefix "$ROOT/clients/typescript"
}

regen_result_fixtures() {
    cargo run -p searchkernel-testkit --no-default-features --bin searchkernel-result-fixtures
}

test_target() {
    case "${1:-}" in
        ir)
            cargo test -p searchkernel-ir --all-targets --all-features
            ;;
        rust-api|rust)
            cargo test -p searchkernel --all-targets --no-default-features
            ;;
        python)
            run_python_tests
            ;;
        typescript)
            run_typescript_tests
            ;;
        php)
            php "$ROOT/clients/php/tests/run.php"
            ;;
        *)
            echo "usage: ./dev test ir|rust-api|python|typescript|php" >&2
            return 2
            ;;
    esac
}

verify_target() {
    case "${1:-}" in
        integration|i)
            "$ROOT/reference/vespa/i/verify-i.sh"
            ;;
        api-conformance)
            "$ROOT/reference/api-conformance/verify.sh"
            ;;
        contracts)
            "$PYTHON" "$ROOT/tools/check-capabilities.py" --check
            "$PYTHON" "$ROOT/tools/check-client-contracts.py" --check
            "$PYTHON" "$ROOT/tools/test_check_capabilities.py"
            "$PYTHON" "$ROOT/tools/test_check_client_contracts.py"
            "$PYTHON" "$ROOT/tools/test_python_dependency_contract.py"
            ;;
        abi)
            local_baseline=$(mktemp)
            trap 'rm -f -- "$local_baseline"' RETURN
            git show HEAD:core/native/vespa/searchkernel_vespa.h > "$local_baseline"
            "$PYTHON" "$ROOT/tools/test_check_native_abi_authorities.py"
            "$PYTHON" "$ROOT/tools/check-native-abi-authorities.py"
            "$PYTHON" "$ROOT/tools/test_check_abi_surface.py"
            SK_NATIVE_ABI_HEADER="$ROOT/core/native/vespa/searchkernel_vespa.h" \
                bash "$ROOT/tools/check-native-bindings.sh"
            bash "$ROOT/tools/check-layout.sh"
            bash "$ROOT/tools/test-native-sdk-cache.sh"
            "$PYTHON" "$ROOT/tools/check_abi_surface.py" \
                "$ROOT/core/native/vespa/searchkernel_vespa.h" \
                --linker-map "$ROOT/core/native/vespa/searchkernel_vespa.map" \
                --baseline-header "$local_baseline"
            rm -f -- "$local_baseline"
            trap - RETURN
            ;;
        persistence)
            bash "$ROOT/tools/check-persistence-fixtures.sh"
            PERSISTENCE_CHECK_INDEX=1 \
                bash "$ROOT/tools/check-persistence-fixture-immutability.sh" HEAD
            cargo test -p searchkernel --test persistence_compatibility --features native -- --nocapture
            cargo test -p searchkernel --features native --lib persistence_fault_matrix_ -- --nocapture
            bash "$ROOT/tools/check-persistence-sensitivity.sh"
            ;;
        issue-queue)
            "$PYTHON" "$ROOT/tools/test_check_issue_queue.py"
            ;;
        m0|m1|m2|m3|m4|m5|m6|m7|m8|m9|m10|m11|m12|m13|m14|phase10|searchreply)
            "$ROOT/reference/vespa/verify-through.sh" "$1"
            ;;
        *)
            echo "usage: ./dev verify m0|...|m14|integration|api-conformance|contracts|abi|persistence|issue-queue|phase10|searchreply" >&2
            return 2
            ;;
    esac
}

install_flatbuffers() (
    local prefix=${FLATBUFFERS_INSTALL_PREFIX:-${FLATBUFFERS_CPP_ROOT:-$(shared_flatbuffers_prefix)}}
    local workdir source_dir build_dir archive_url archive_path download_tool lockfile
    local jobs=1
    local flatc header library actual_version

    mkdir -p "$(dirname -- "$prefix")"
    lockfile="$prefix.lock"
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$lockfile"
        flock 9
    fi

    flatc="$prefix/bin/flatc"
    header="$prefix/include/flatbuffers/base.h"
    library="$prefix/lib/libflatbuffers.a"
    if [[ -x "$flatc" && -f "$header" && -f "$library" ]] &&
       bash "$ROOT/tools/check-flatbuffers-cpp.sh" "$prefix" "$EXPECTED_FLATBUFFERS_VERSION" >/dev/null 2>&1; then
        echo "FlatBuffers $EXPECTED_FLATBUFFERS_VERSION already available and link-compatible under $prefix"
        echo "This install is shared by every worktree in this clone for build environment '${SEARCHKERNEL_BUILD_ENV:-host}'."
        return 0
    fi

    workdir=$(mktemp -d "${TMPDIR:-/tmp}/searchkernel-flatbuffers.XXXXXX")
    trap 'rm -rf -- "$workdir"' EXIT

    if command -v curl >/dev/null 2>&1; then
        download_tool=curl
    elif command -v wget >/dev/null 2>&1; then
        download_tool=wget
    else
        echo 'error: ./dev install flatbuffers requires curl or wget' >&2
        return 1
    fi
    command -v cmake >/dev/null 2>&1 || {
        echo 'error: ./dev install flatbuffers requires cmake' >&2
        return 1
    }
    command -v tar >/dev/null 2>&1 || {
        echo 'error: ./dev install flatbuffers requires tar' >&2
        return 1
    }
    command -v c++ >/dev/null 2>&1 || {
        echo 'error: ./dev install flatbuffers requires a C++ compiler (for example, gcc-c++)' >&2
        return 1
    }

    if command -v nproc >/dev/null 2>&1; then
        jobs=$(nproc)
    fi

    archive_url="https://github.com/google/flatbuffers/archive/refs/tags/v${EXPECTED_FLATBUFFERS_VERSION}.tar.gz"
    archive_path="$workdir/flatbuffers-${EXPECTED_FLATBUFFERS_VERSION}.tar.gz"
    source_dir="$workdir/source"
    build_dir="$workdir/build"
    mkdir -p "$source_dir"

    echo "Downloading FlatBuffers ${EXPECTED_FLATBUFFERS_VERSION}..."
    if [[ "$download_tool" == curl ]]; then
        curl --fail --location --silent --show-error "$archive_url" --output "$archive_path"
    else
        wget --quiet --output-document="$archive_path" "$archive_url"
    fi
    tar --extract --gzip --strip-components=1 --file="$archive_path" --directory="$source_dir"

    # Cargo links this static C++ library into a position-independent Rust
    # executable. AlmaLinux defaults to lib64, while the build script expects
    # lib, so keep both properties explicit here.
    cmake -S "$source_dir" -B "$build_dir" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$prefix" \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DFLATBUFFERS_BUILD_TESTS=OFF
    cmake --build "$build_dir" --parallel "$jobs"
    cmake --install "$build_dir"

    flatc="$prefix/bin/flatc"
    header="$prefix/include/flatbuffers/base.h"
    library="$prefix/lib/libflatbuffers.a"
    [[ -x "$flatc" ]] || {
        echo "error: FlatBuffers compiler was not installed at '$flatc'" >&2
        return 1
    }
    [[ -f "$header" ]] || {
        echo "error: FlatBuffers headers were not installed under '$prefix/include'" >&2
        return 1
    }
    [[ -f "$library" ]] || {
        echo "error: FlatBuffers static library was not installed at '$library'" >&2
        return 1
    }
    actual_version=$("$flatc" --version)
    [[ "$actual_version" == "flatc version $EXPECTED_FLATBUFFERS_VERSION" ]] || {
        echo "error: installed flatc reports '$actual_version'" >&2
        return 1
    }
    if ! bash "$ROOT/tools/check-flatbuffers-cpp.sh" "$prefix" "$EXPECTED_FLATBUFFERS_VERSION"; then
        echo "error: installed FlatBuffers C++ library is not compatible with this build environment" >&2
        return 1
    fi

    echo "Installed FlatBuffers ${EXPECTED_FLATBUFFERS_VERSION} under $prefix"
    echo "This install is shared by every worktree in this clone for build environment '${SEARCHKERNEL_BUILD_ENV:-host}'."
    echo "export FLATBUFFERS_CPP_ROOT=$prefix"
    echo "export FLATC_PATH=$flatc"
)

install_target() {
    case "${1:-}" in
        flatbuffers)
            [[ "$#" -eq 1 ]] || {
                echo 'usage: ./dev install flatbuffers' >&2
                return 2
            }
            install_flatbuffers
            ;;
        *)
            echo 'usage: ./dev install flatbuffers' >&2
            return 2
            ;;
    esac
}

native_sdk_command() {
    case "${1:-ensure}" in
        ensure|path)
            bash "$ROOT/tools/resolve-native-sdk.sh" "${1:-ensure}"
            ;;
        *)
            echo 'usage: ./dev native-sdk ensure|path' >&2
            return 2
            ;;
    esac
}

worktree_create() {
    local task_name=${1:-}
    local worktree_root repo_name branch path common_git_dir

    if [[ $# -ne 1 || ! "$task_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo 'usage: ./dev worktree create <task-name>' >&2
        echo 'task-name may contain only letters, numbers, dot, underscore, and hyphen' >&2
        return 2
    fi

    common_git_dir=$(git rev-parse --git-common-dir)
    if [[ "$common_git_dir" != /* ]]; then
        common_git_dir="$ROOT/$common_git_dir"
    fi
    common_git_dir=$(cd -- "$(dirname "$common_git_dir")" && pwd)
    repo_name=$(basename "$common_git_dir")
    worktree_root=${DEV_WORKTREE_ROOT:-/tmp}
    branch="agent/$task_name"
    path="$worktree_root/$repo_name-$task_name"

    if [[ -e "$path" ]]; then
        echo "worktree path already exists: $path" >&2
        return 1
    fi
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        echo "branch already exists: $branch" >&2
        return 1
    fi

    git worktree add -b "$branch" "$path" HEAD
    echo "created worktree: $path"
    echo "branch: $branch"
    echo "next: cd \"$path\""
}

find_flatc() {
    bash "$ROOT/tools/resolve-flatc.sh"
}

doctor_cargo() {
    command -v cargo >/dev/null 2>&1
    cargo --version >/dev/null
}

doctor_flatc() {
    DOCTOR_FLATC=$(find_flatc)
    [[ -x "${DOCTOR_FLATC:-}" ]]
    [[ "$("$DOCTOR_FLATC" --version)" == "flatc version $EXPECTED_FLATBUFFERS_VERSION" ]]
}

doctor_flatbuffers_cpp() {
    local flatc cpp_root
    flatc=${DOCTOR_FLATC:-$(find_flatc)}
    [[ -x "${flatc:-}" ]] || return 1

    cpp_root=${FLATBUFFERS_CPP_ROOT:-$(cd -- "$(dirname -- "$flatc")/.." && pwd)}
    bash "$ROOT/tools/check-flatbuffers-cpp.sh" "$cpp_root" "$EXPECTED_FLATBUFFERS_VERSION" "$flatc"
}

doctor_generated_protocol() {
    [[ -s "$ROOT/core/crates/searchkernel-protocol/src/lib.rs" ]]
    [[ -n "$(find "$ROOT/core/crates/searchkernel-protocol/src/generated" -name '*.rs' -type f -print -quit 2>/dev/null)" ]]
    [[ -s "$ROOT/core/crates/searchkernel-protocol/bfbs/searchkernel_request.bfbs" ]]
    [[ -s "$ROOT/core/crates/searchkernel-protocol/bfbs/searchkernel_response.bfbs" ]]
    [[ -n "$(find "$ROOT/clients/python/searchkernel/_wire_generated" -name '*.py' -type f -print -quit 2>/dev/null)" ]]
    FLATC_PATH="${DOCTOR_FLATC:-$(find_flatc)}" \
        bash "$ROOT/tools/check-flatbuffers-bfbs.sh"
    bash "$ROOT/tools/check-searchkernel-rpc.sh"
}

doctor_typescript() {
    [[ -x "$ROOT/clients/typescript/node_modules/.bin/tsc" ]] || {
        echo 'TypeScript dependencies are missing; run npm ci --prefix clients/typescript' >&2
        return 1
    }
    run_typescript_generation_check
}

doctor_native_sdk() {
    local sdk
    sdk=$(native_sdk_path)
    [[ -f "$sdk/manifest.json" ]]
    if [[ -n "${SK_NATIVE_SDK:-}" ]]; then
        [[ -f "$sdk/include/searchkernel_vespa.h" ]]
        compgen -G "$sdk/lib/libsearchkernel_vespa.so*" >/dev/null
    else
        grep -Eq '"kind"[[:space:]]*:[[:space:]]*"vespa-base"' "$sdk/manifest.json"
        compgen -G "$sdk/lib/libvespa*.so*" >/dev/null
        bash "$ROOT/tools/resolve-native-sdk.sh" vespa-root >/dev/null
    fi
}

doctor_native_abi() {
    "$PYTHON" "$ROOT/tools/check-native-abi-authorities.py"
    if [[ -z "${SK_NATIVE_SDK:-}" ]]; then
        # The shared Vespa base intentionally contains no Search Kernel adapter
        # or ABI header. Repository-local ABI authorities are still checked
        # above; SDK agreement is checked once a full SDK is selected.
        return 0
    fi
    (
        source "$ROOT/reference/vespa/common/verify-common.sh"
        require_sdk_manifest "$(native_sdk_path)/manifest.json"
    )
}

doctor_vespa() {
    bash "$ROOT/tools/resolve-native-sdk.sh" vespa-root >/dev/null
}

doctor_python() {
    "$PYTHON" "$ROOT/tools/check-python-dependencies.py"
}

doctor_searchkerneld() {
    local target_dir=${CARGO_TARGET_DIR:-$ROOT/target/host}
    local binary=${SEARCHKERNELD_BIN:-$target_dir/debug/searchkerneld}
    [[ -x "$binary" ]]
}

doctor_hooks() {
    ensure_hooks
    [[ "$(git config --local --get core.hooksPath 2>/dev/null || true)" == ".githooks" ]]
}

doctor() {
    local status=0
    local diagnostics
    diagnostics=$(mktemp)

    doctor_check() {
        local label=$1
        shift
        if "$@" >"$diagnostics" 2>&1; then
            printf 'PASS  %s\n' "$label"
        else
            printf 'FAIL  %s\n' "$label"
            sed -n '1,3p' "$diagnostics" | sed 's/^/      /'
            status=1
        fi
    }

    doctor_optional() {
        local label=$1
        local remediation=$2
        shift 2
        if "$@" >"$diagnostics" 2>&1; then
            printf 'PASS  %s\n' "$label"
        else
            printf 'INFO  %s\n' "$label"
            printf '      %s\n' "$remediation"
        fi
    }

    echo "Search Kernel doctor"
    doctor_check 'repository Git hooks configured' doctor_hooks
    doctor_check 'cargo present' doctor_cargo
    doctor_check 'flatc correct version' doctor_flatc
    doctor_check 'FlatBuffers C++ correct version' doctor_flatbuffers_cpp
    doctor_check 'generated protocol present/current' doctor_generated_protocol
    doctor_check 'TypeScript generated protocol present/current' doctor_typescript
    doctor_optional 'native SDK present' \
        'Only required for native/all-features verification; populate with: ./dev native-sdk ensure' \
        doctor_native_sdk
    doctor_optional 'native ABI versions agree' \
        'Only checked when a native SDK is present/required.' \
        doctor_native_abi
    doctor_optional 'pinned Vespa checkout registered' \
        'Only required for native/all-features verification; provision once with: ./dev native-sdk ensure' \
        doctor_vespa
    doctor_check 'Python dependencies present' doctor_python
    doctor_optional 'searchkerneld built' \
        'Build it with: cargo build -p searchkerneld' \
        doctor_searchkerneld

    if ((status == 0)); then
        echo 'Doctor: all prerequisites passed'
    else
        echo 'Doctor: one or more prerequisites failed' >&2
    fi
    rm -f "$diagnostics"
    return "$status"
}

hooks_install() {
    ensure_hooks
    echo 'Repository-managed Git hooks are configured at .githooks'
}

case "${1:-help}" in
    help|-h|--help)
        usage
        ;;
    check)
        check_all
        ;;
    check-fast)
        check_fast
        ;;
    check-protocol)
        check_protocol
        ;;
    test)
        shift
        test_target "${1:-}"
        ;;
    regen)
        case "${2:-}" in
            protocol) regen_protocol ;;
            result-fixtures) regen_result_fixtures ;;
            *)
                echo 'usage: ./dev regen protocol|result-fixtures' >&2
                exit 2
                ;;
        esac
        ;;
    verify)
        shift
        verify_target "${1:-}"
        ;;
    install)
        shift
        install_target "$@"
        ;;
    native-sdk)
        shift
        native_sdk_command "${1:-ensure}"
        ;;
    worktree)
        [[ "${2:-}" == create ]] || {
            echo 'usage: ./dev worktree create <task-name>' >&2
            exit 2
        }
        shift 2
        worktree_create "$@"
        ;;
    doctor)
        doctor
        ;;
    hooks)
        [[ "${2:-}" == install ]] || {
            echo 'usage: ./dev hooks install' >&2
            exit 2
        }
        hooks_install
        ;;
    *)
        echo "unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
