find_clang_python() {
    local candidate resolved
    local -a candidates=()

    [[ -n "${ABI_PYTHON:-}" ]] && candidates+=("$ABI_PYTHON")
    candidates+=("$PYTHON")
    [[ -x /usr/bin/python3 ]] && candidates+=("/usr/bin/python3")
    command -v python3 >/dev/null 2>&1 && candidates+=("$(command -v python3)")

    for candidate in "${candidates[@]}"; do
        if [[ "$candidate" == */* ]]; then
            resolved=$candidate
        else
            resolved=$(command -v "$candidate" 2>/dev/null || true)
        fi
        [[ -n "$resolved" && -x "$resolved" ]] || continue
        if "$resolved" -c 'import clang.cindex' >/dev/null 2>&1 &&
           "$resolved" "$ROOT/tools/check_abi_surface.py" --help >/dev/null 2>&1; then
            printf '%s\n' "$resolved"
            return 0
        fi
    done
    return 1
}

find_clang_pythonpath() {
    local cindex package_root

    if command -v rpm >/dev/null 2>&1; then
        cindex=$(rpm -ql python3-clang 2>/dev/null |
            sed -n '/\/clang\/cindex\.py$/p' | head -n 1)
        if [[ -n "$cindex" && -f "$cindex" ]]; then
            package_root=$(dirname -- "$(dirname -- "$cindex")")
            printf '%s\n' "$package_root"
            return 0
        fi
    fi

    cindex=$(find /usr/lib /usr/lib64 /usr/local/lib \
        -type f -path '*/site-packages/clang/cindex.py' -print -quit 2>/dev/null || true)
    if [[ -n "$cindex" ]]; then
        package_root=$(dirname -- "$(dirname -- "$cindex")")
        printf '%s\n' "$package_root"
        return 0
    fi
    return 1
}

run_abi_python() {
    local python clang_pythonpath effective_pythonpath

    if python=$(find_clang_python); then
        "$python" "$@"
        return
    fi

    # AlmaLinux may install python3-clang for the distro Python while Search
    # Kernel intentionally uses a newer repo-local Python. The clang bindings
    # are pure Python, so expose the distro package to the repo interpreter
    # rather than forcing the client/tooling environment onto the distro
    # interpreter.
    clang_pythonpath=$(find_clang_pythonpath || true)
    if [[ -n "$clang_pythonpath" ]]; then
        effective_pythonpath="$clang_pythonpath${PYTHONPATH:+:$PYTHONPATH}"
        if PYTHONPATH="$effective_pythonpath" "$PYTHON" -c 'import clang.cindex' >/dev/null 2>&1 &&
           PYTHONPATH="$effective_pythonpath" "$PYTHON" "$ROOT/tools/check_abi_surface.py" --help >/dev/null 2>&1; then
            PYTHONPATH="$effective_pythonpath" "$PYTHON" "$@"
            return
        fi
    fi

    echo 'error: no usable Python/libclang binding combination was found' >&2
    echo 'run ./dev doctor to install/repair the ABI verification toolchain' >&2
    return 1
}

