doctor_repair_rust() {
    if doctor_rust >/dev/null 2>&1; then
        return 0
    fi

    echo 'REPAIR Rust toolchain'
    command -v rustup >/dev/null 2>&1 || {
        echo 'cannot repair Rust automatically: rustup is not installed' >&2
        return 1
    }

    rustup toolchain install stable --profile minimal
    rustup default stable
    refresh_rust_tools
    doctor_rust
}

doctor_node() {
    refresh_node_tools
    "$NODE" --version >/dev/null
    "$NPM" --version >/dev/null
}

doctor_repair_node() {
    if doctor_node >/dev/null 2>&1; then
        return 0
    fi

    echo 'REPAIR Node.js toolchain'
    if command -v dnf >/dev/null 2>&1; then
        dnf module reset -y nodejs || true
        dnf module enable -y nodejs:20
        dnf install -y nodejs npm
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y nodejs npm
    else
        echo 'cannot repair Node.js automatically: supported package manager (dnf/apt-get) not found' >&2
        return 1
    fi

    refresh_node_tools
    doctor_node
}

