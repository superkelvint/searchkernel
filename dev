universe_format_command() {
    local arg formatted= quoted
    local index=0

    for arg in "$@"; do
        if ((index == 0)) && [[ "$arg" == "$CARGO" ]]; then
            quoted='$(./tools/resolve-rust.sh cargo)'
        elif ((index == 0)) && [[ "$arg" == "$PYTHON" ]]; then
            quoted='$(./tools/resolve-python.sh)'
        else
            if [[ "$arg" == "$ROOT"/* ]]; then
                arg=".${arg#$ROOT}"
            fi
            printf -v quoted '%q' "$arg"
        fi

        if [[ -n "$formatted" ]]; then
            formatted+=" "
        fi
        formatted+="$quoted"
        ((index += 1))
    done

    printf '%s\n' "$formatted"
}

universe_step() {
    local label=$1
    shift
    local repro
    repro=$(universe_format_command "$@")

    echo
    echo "==> universe: $label"
    if "$@"; then
        UNIVERSE_PASSED+=("$label")
    else
        local status=$?
        UNIVERSE_FAILED+=("$label (exit $status)")
        UNIVERSE_FAILED_REPRO+=("$repro")
    fi
}

universe_dev_step() {
    local label=$1
    shift
    universe_step "$label" "$ROOT/dev" "$@"
}

universe_print_summary() {
    local passed_count=$1
    local failed_name=$2
    local repro_name=$3
    local -n failed_ref=$failed_name
    local -n repro_ref=$repro_name
    local index

    echo
    echo '========== Search Kernel universe summary =========='
    printf 'PASS: %d lane(s)\n' "$passed_count"
    if (("${#failed_ref[@]}" == 0)); then
        echo 'FAIL: 0 lane(s)'
        echo 'Search Kernel universe: PASS'
        return 0
    fi

    printf 'FAIL: %d lane(s)\n' "${#failed_ref[@]}"
    for index in "${!failed_ref[@]}"; do
        printf '  - %s\n' "${failed_ref[$index]}"
        printf '    repro: %s\n' "${repro_ref[$index]}"
    done
    echo 'Search Kernel universe: FAIL' >&2
    return 1
}

universe() {
    local target
    local failures_before_m14
    local m14_baseline_proved=0
    local -a targets=()
    local -a UNIVERSE_PASSED=()
    local -a UNIVERSE_FAILED=()
    local -a UNIVERSE_FAILED_REPRO=()

    # Universe is deliberately non-fail-fast. Each child ./dev invocation keeps
    # the normal set -e behavior, while this parent records its exit status and
    # continues through the remaining independent verification lanes.
    universe_dev_step 'provision native SDK' native-sdk ensure
    universe_dev_step 'fast repository checks' check-fast
    universe_step 'Vespa binding checks' bash "$ROOT/tools/check-vespa-bindings.sh"
    universe_dev_step 'protocol/generated-artifact checks' check-protocol
    universe_dev_step 'all-features Clippy' lint --profile rust-clippy-all-features

    universe_step 'Rust tests (all targets/features, including ignored)'         "$CARGO" test --workspace --all-targets --all-features -- --include-ignored
    universe_step 'Rust doctests (all features)'         "$CARGO" test --workspace --all-features --doc

    universe_dev_step 'Python client tests' test python
    universe_dev_step 'TypeScript client/package tests' test typescript
    universe_dev_step 'PHP client/package tests' test php
    universe_dev_step 'Ruby client/package tests' test ruby
    universe_dev_step 'first-party real-engine parity' test client-real-e2e-parity

    universe_step 'Python tooling regression tests'         "$PYTHON" -m unittest discover -s "$ROOT/tools" -p 'test_*.py'
    while IFS= read -r target; do
        universe_step "tool regression $(basename "$target")" bash "$target"
    done < <(find "$ROOT/tools" -maxdepth 1 -type f -name 'test-*.sh' -print | sort)

    universe_dev_step 'API conformance verifier' verify api-conformance
    universe_dev_step 'capability/client contract verifiers' verify contracts
    universe_dev_step 'client semantic parity verifier' verify client-semantic-parity
    universe_dev_step 'native ABI verifier' verify abi
    universe_dev_step 'persistence compatibility verifier' verify persistence
    universe_dev_step 'issue queue verifier' verify issue-queue

    mapfile -t targets < <("$PYTHON" "$ROOT/tools/dev-targets.py" list universe)
    if (("${#targets[@]}" == 0)); then
        UNIVERSE_FAILED+=('semantic verifier discovery (no targets)')
        UNIVERSE_FAILED_REPRO+=('./dev verify --list')
    fi

    # Run the cumulative M14 verifier once. Its chain proves the hardening
    # (M11) and HNSW (M14) baselines before later semantic lanes run. Product
    # integration can then use the existing baseline-reuse option to avoid
    # replaying M13 while still running its Phase 10 checks.
    failures_before_m14=${#UNIVERSE_FAILED[@]}
    universe_dev_step 'cumulative milestone.m14 closure' verify milestone.m14 --skip-workspace-quality
    if (("${#UNIVERSE_FAILED[@]}" == failures_before_m14)); then
        m14_baseline_proved=1
    fi

    for target in "${targets[@]}"; do
        case "$target" in
            vespa.nearest-neighbor.hnsw)
                # This public verifier is an alias for verify-m14.sh. The
                # cumulative lane above ran that exact verifier already.
                echo "==> universe: semantic verifier $target covered by cumulative milestone.m14 closure"
                if ((m14_baseline_proved)); then
                    UNIVERSE_PASSED+=("semantic verifier $target (covered by cumulative milestone.m14 closure)")
                else
                    UNIVERSE_FAILED+=("semantic verifier $target (cumulative milestone.m14 closure failed)")
                    UNIVERSE_FAILED_REPRO+=("./dev verify $target --skip-workspace-quality")
                fi
                ;;
            vespa.hardening|vespa.hardening.core|vespa.hardening.stress|vespa.hardening.sanitizers)
                if ((m14_baseline_proved)); then
                    # M14's cumulative chain ran M11 and all three hardening
                    # components. Do not execute those same scripts again.
                    echo "==> universe: semantic verifier $target covered by cumulative milestone.m14 closure"
                    UNIVERSE_PASSED+=("semantic verifier $target (covered by cumulative milestone.m14 closure)")
                else
                    universe_dev_step "semantic verifier $target" verify "$target" --skip-workspace-quality
                fi
                ;;
            product.integration)
                if ((m14_baseline_proved)); then
                    universe_dev_step "semantic verifier $target" verify "$target" --baseline-already-proved --skip-workspace-quality
                else
                    universe_dev_step "semantic verifier $target" verify "$target" --skip-workspace-quality
                fi
                ;;
            *)
                universe_dev_step "semantic verifier $target" verify "$target" --skip-workspace-quality
                ;;
        esac
    done

    universe_print_summary "${#UNIVERSE_PASSED[@]}" UNIVERSE_FAILED UNIVERSE_FAILED_REPRO
}

