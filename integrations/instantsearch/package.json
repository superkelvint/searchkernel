{
  "name": "@searchkernel/instantsearch",
  "version": "0.1.0",
  "description": "Bounded Search Kernel search client for the pinned InstantSearch contract",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./compatibility": "./dist/compatibility.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit.test.ts tests/guards.test.ts",
    "test:engine": "vitest run tests/real-engine.test.ts tests/framework-real-engine.test.ts",
    "typecheck": "tsc --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --resolveJsonModule --noEmit tests/types.ts && tsc --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --resolveJsonModule --noEmit tests/framework-types.ts",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "devDependencies": {
    "@algolia/client-search": "5.59.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "algoliasearch": "5.59.0",
    "algoliasearch-helper": "3.30.0",
    "instantsearch.js": "4.119.0",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-instantsearch": "7.51.0",
    "react-instantsearch-core": "7.51.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue": "3.5.43",
    "vue-instantsearch": "4.30.0"
  }
}
