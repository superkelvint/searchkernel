      {
        "op": "search_settings_set",
        "value": {
          "limit": 50,
          "prefix": "none",
          "term_match": "all",
          "typo_tolerance": "disabled"
        }
      },
      {
        "op": "search_settings_get"
      },
      {
        "op": "search_resolve",
