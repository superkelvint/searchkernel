{
  "category": "schema",
  "description": "Business tie-break follows relevance.",
  "id": "schema.ranking-tiebreak",
  "input": {
    "fields": [
      {
        "kind": "text",
        "name": "title"
      },
      {
        "kind": "i64",
        "name": "popularity"
      }
    ],
    "name": "ranking",
    "ranking": {
      "relevance": "default/v1",
      "then": [
        {
          "direction": "desc",
          "field": "popularity"
        }
      ]
    }
  },
  "operation": "resolve_index_definition"
}
