{
  "category": "schema",
  "description": "Index-level query defaults resolve explicitly.",
  "id": "schema.search-default-overrides",
  "input": {
    "fields": [
      {
        "kind": "text",
        "name": "title"
      }
    ],
    "name": "custom-defaults",
    "search_defaults": {
      "limit": 50,
      "prefix": "none",
      "term_match": "any",
      "typo_tolerance": "disabled"
    }
  },
  "operation": "resolve_index_definition"
}
