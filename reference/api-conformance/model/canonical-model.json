{
  "notes": [
    "Goldens are exhaustive examples; these shape invariants are also mechanically checked."
  ],
  "types": {
    "AnalyzeResult": {
      "required": [
        "field",
        "input",
        "analyzer",
        "tokens"
      ]
    },
    "AnalyzeToken": {
      "required": [
        "original",
        "normalized",
        "indexed",
        "position"
      ]
    },
    "BulkItemResult": {
      "required": [
        "index",
        "id",
        "ok",
        "error"
      ]
    },
    "CurationEffects": {
      "required": [
        "applied",
        "pins",
        "hidden_ids",
        "added_filters",
        "query_replacement"
      ]
    },
    "DocumentId": {
      "semantics": {
        "max_utf8_bytes": 1024,
        "min_utf8_bytes": 1,
        "opaque_unicode": true,
        "reject_c0_and_del_controls": true,
        "reject_whitespace_only": true,
        "unicode_normalization": "none"
      }
    },
    "Error": {
      "required": [
        "code",
        "details"
      ],
      "semantics": {
        "details_shape_stable_per_code": true
      }
    },
    "FieldCapabilities": {
      "required": [
        "searchable",
        "filterable",
        "sortable",
        "facetable",
        "prefix",
        "infix",
        "typo_tolerance"
      ]
    },
    "Grouping": {
      "semantics": {
        "default_hits_per_group": 3,
        "group_by_and_distinct_mutually_exclusive": true
      }
    },
    "HighlightedText": {
      "required": [
        "text",
        "segments"
      ],
      "segment": {
        "required": [
          "text",
          "matched"
        ]
      }
    },
    "Lifecycle": {
      "semantics": {
        "closed_handle": "index_closed",
        "create_existing": "index_already_exists",
        "open_missing": "index_not_found"
      }
    },
    "Pagination": {
      "semantics": {
        "limit_max": 1000,
        "limit_min": 1,
        "offset_min": 0,
        "page_base": 1
      }
    },
    "ResolvedBulkWrite": {
      "required": [
        "kind",
        "ordered",
        "atomic",
        "operations"
      ],
      "semantics": {
        "atomic": false,
        "kind": "batch",
        "ordered": true
      }
    },
    "ResolvedIndexField": {
      "required": [
        "name",
        "kind",
        "analyzer",
        "stored",
        "optional",
        "multi",
        "capabilities"
      ]
    },
    "ResolvedIndexSearchField": {
      "required": [
        "field",
        "weight"
      ]
    },
    "ResolvedQuery": {
      "required": [
        "original_text",
        "text",
        "syntax",
        "parsed"
      ]
    },
    "ResolvedSearchField": {
      "required": [
        "field",
        "weight",
        "prefix",
        "infix",
        "typo_tolerance"
      ]
    },
    "ResolvedSearchRequest": {
      "required": [
        "kind",
        "query",
        "search_fields",
        "filter",
        "facets",
        "ranking",
        "sort",
        "grouping",
        "prefix",
        "typo_tolerance",
        "term_match",
        "synonyms",
        "synonym_expansions",
        "curation",
        "projection",
        "highlights",
        "snippets",
        "include_ranking_info",
        "pagination"
      ]
    }
  },
  "version": "high-level/v1"
}
