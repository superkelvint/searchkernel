{
  "version": 1,
  "schema": {
    "default_search_fields": ["title", "description"],
    "fields": {
      "title": {"type": "text", "stored": true, "searchable": true},
      "description": {"type": "text", "stored": true, "searchable": true},
      "brand": {"type": "keyword", "stored": true, "filterable": true, "sortable": true, "facetable": true},
      "category": {"type": "keyword", "stored": true, "filterable": true, "facetable": true},
      "price": {"type": "float64", "stored": true, "filterable": true, "sortable": true},
      "sale_price": {"type": "float64", "stored": true, "filterable": true, "sortable": true},
      "rating": {"type": "int64", "stored": true, "filterable": true, "sortable": true, "facetable": true},
      "inventory": {"type": "int64", "stored": true, "filterable": true, "sortable": true},
      "in_stock": {"type": "bool", "stored": true, "filterable": true},
      "embedding": {"type": "tensor<float>(x[8])", "stored": true}
    },
    "rank_profiles": [
      {"name": "boosted", "first_phase": "query(boost)", "match_features": ["query(boost)"]},
      {"name": "semantic", "first_phase": "closeness(embedding)", "query_inputs": {"query_embedding": "tensor<float>(x[8])"}, "match_features": ["query(query_embedding)"]},
      {"name": "hybrid", "first_phase": "bm25(title) + 10 * closeness(embedding)", "query_inputs": {"query_embedding": "tensor<float>(x[8])"}, "match_features": ["bm25(title)", "closeness(embedding)", "query(query_embedding)"]},
      {"name": "two_phase", "first_phase": "attribute(rating)", "second_phase": "attribute(inventory)", "rerank_count": 3},
      {"name": "first_phase_only", "first_phase": "attribute(rating)"},
      {"name": "operator", "first_phase": "nativeRank", "match_features": ["nativeRank"]}
    ]
  },
