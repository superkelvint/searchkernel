{
  "version": 1,
  "id": "multi-feature-inspection",
  "schema": {
    "document_type": "typea",
    "fields": [
      {
        "name": "title",
        "type": "text",
        "index": true,
        "attribute": false,
        "summary": true
      },
      {
        "name": "body",
        "type": "text",
        "index": true,
        "attribute": false,
        "summary": true
      },
      {
        "name": "popularity",
        "type": "integer",
        "index": false,
        "attribute": true,
        "summary": true
      }
    ],
    "rank_profiles": [
      {
        "name": "bm25_title",
        "first_phase": "bm25(title)",
        "match_features": [
          "bm25(title)"
        ]
      },
      {
        "name": "bm25_body",
        "first_phase": "bm25(body)",
        "match_features": [
          "bm25(body)"
        ]
      },
      {
        "name": "popularity",
        "first_phase": "attribute(popularity)",
        "match_features": [
          "attribute(popularity)"
        ]
      },
      {
        "name": "query_boost",
        "first_phase": "query(boost) * attribute(popularity)",
        "match_features": [
          "query(boost)",
          "attribute(popularity)"
        ]
      },
      {
        "name": "expression",
        "first_phase": "2 * attribute(popularity) + 3",
        "match_features": [
          "attribute(popularity)"
        ]
      },
      {
        "name": "native_title",
        "first_phase": "nativeRank(title)",
        "match_features": [
          "nativeRank(title)",
          "nativeFieldMatch(title)",
          "nativeProximity(title)"
        ]
      },
      {
        "name": "inspect_all",
        "first_phase": "bm25(title) + query(boost) * attribute(popularity)",
        "match_features": [
          "bm25(title)",
          "query(boost)",
          "attribute(popularity)"
        ]
      }
    ]
  },
  "documents": [
