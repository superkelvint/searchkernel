{
  "version": 1,
  "id": "float-group-keys",
  "schema": {
    "document_type": "typea",
    "fields": [
      {"name": "category", "type": "string", "attribute": true, "summary": true},
      {"name": "qty", "type": "integer", "attribute": true, "summary": true},
      {"name": "price", "type": "float", "attribute": true, "summary": true},
      {"name": "active", "type": "boolean", "attribute": true, "summary": true}
    ]
  },
  "documents": [
    {
      "id": "id:test:typea::float-group-1",
      "fields": {
        "category": {"string": "low"},
        "qty": {"integer": 1},
        "price": {"float": 1.5},
        "active": {"boolean": true}
      }
    },
    {
      "id": "id:test:typea::float-group-2",
      "fields": {
        "category": {"string": "high"},
        "qty": {"integer": 2},
        "price": {"float": 2.5},
        "active": {"boolean": false}
      }
    }
  ],
  "steps": [
    {
      "id": "groups",
      "op": "group",
      "request": {
        "query": {
          "attribute_range": {
            "field": "price",
            "lower": {"unbounded": true},
            "upper": {"unbounded": true}
          }
        },
        "group_by": "price",
        "aggregations": ["count"]
      }
    }
  ]
}
