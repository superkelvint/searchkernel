{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["milestone", "title", "depends_on", "verifier", "required_reviewers", "required_tests", "ci", "freeze_commit", "implementation"],
  "properties": {
    "milestone": {"type": "string", "pattern": "^F(0|[1-9]|1[0-2])$"},
    "title": {"type": "string", "minLength": 1},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "verifier": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_reviewers": {"type": "array", "items": {"enum": ["architecture", "correctness", "security"]}},
    "required_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_paths": {"type": "array", "items": {"type": "string"}},
    "ci": {"type": "array"},
    "freeze_commit": {"type": "string", "minLength": 1},
    "implementation": {"enum": ["NOT_IMPLEMENTED", "IMPLEMENTED"]}
  }
}
